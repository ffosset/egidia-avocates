{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/site_vitrine/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: question, answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|corner|ratio|legend|key|ref|className|style|children)$/]",
        "message": "<ArcImage> doesn't accept that prop. Declared props: src, alt, corner, ratio, legend."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcImage'] > JSXAttribute[name.name='corner'] > Literal[value!=/^(?:bottom-left|bottom-right|top-left|top-right|shield|none)$/]",
        "message": "<ArcImage> corner must be one of 'bottom-left' | 'bottom-right' | 'top-left' | 'top-right' | 'shield' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|info|attention|urgent)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'info' | 'attention' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|watermark|align|children|key|ref|className|style|children)$/]",
        "message": "<Band> doesn't accept that prop. Declared props: tone, watermark, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|ink|sand|cream)$/]",
        "message": "<Band> tone must be one of 'sage' | 'ink' | 'sand' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<Band> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|fullWidth|disabled|as|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, fullWidth, disabled, as, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<Button> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|icon|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, title, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|attention|urgent)$/]",
        "message": "<Callout> tone must be one of 'info' | 'success' | 'attention' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|accentEdge|padding|interactive|href|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, accentEdge, padding, interactive, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|inset|sage|framed|ink)$/]",
        "message": "<Card> tone must be one of 'paper' | 'inset' | 'sage' | 'framed' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|onClose|footer|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, description, onClose, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:quiet|outline|solid)$/]",
        "message": "<IconButton> variant must be one of 'quiet' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageRules'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|key|ref|className|style|children)$/]",
        "message": "<PageRules> doesn't accept that prop. Declared props: inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|photo|meta|ratio|edge|href|onClick|key|ref|className|style|children)$/]",
        "message": "<PersonCell> doesn't accept that prop. Declared props: name, photo, meta, ratio, edge, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCell'] > JSXAttribute[name.name='edge'] > Literal[value!=/^(?:left|right|both)$/]",
        "message": "<PersonCell> edge must be one of 'left' | 'right' | 'both'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuledGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|children|key|ref|className|style|children)$/]",
        "message": "<RuledGrid> doesn't accept that prop. Declared props: columns, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeaderLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<SiteHeaderLink> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onRemove|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: selected, onRemove, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|placement|children|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: content, placement, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
