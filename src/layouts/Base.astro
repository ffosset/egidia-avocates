---
import { withBase } from '../lib/base.js';
import '../styles/tokens.css';
import '../styles/pile.css';
import '../styles/survol.css';
import PageRules from '../components/PageRules.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Cabinet bruxellois en droit des étrangers, de la famille, de l'aide sociale et de la jeunesse. Une relation fondée sur l'écoute et la transparence.",
} = Astro.props;

const fullTitle = title === 'Egidia' ? 'Egidia — cabinet d’avocates à Bruxelles' : `${title} — Egidia`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/logo.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase('/photos/equipe.jpg'), Astro.site)} />
  </head>
  <body>
    <a href="#contenu" class="skip">Aller au contenu</a>
    <PageRules />
    <SiteHeader />
    <div id="contenu"><slot /></div>
    <SiteFooter />
  </body>
</html>

<style is:global>
  /* Le lien d'évitement fait partie du contrat d'accessibilité du cabinet. */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--brun-profond);
    color: var(--creme);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
  }
  .skip:focus { left: var(--content-inset); }

  img { max-width: 100%; }

  /* ---- LA PAGE NE DÉFILE QUE VERS LE BAS ----
     Rien, sur ce site, ne se lit de gauche à droite au-delà du cadre : un
     défilement horizontal n'y est jamais un service rendu, c'est toujours le
     symptôme d'un bloc qui dépasse. Sur un téléphone il coûte cher — la page
     part de travers au premier geste du pouce, et les filets de marge, qui
     sont `fixed`, restent en place pendant que le contenu glisse dessous.

     `clip` et non `hidden` : `hidden` aurait fait de <html> une boîte de
     défilement, ce qui casse `position: sticky` et donne un axe qu'on peut
     encore atteindre au clavier. `clip` ferme l'axe, sans rien d'autre.
     L'`overflow` de la racine se propage à la FENÊTRE : les filets de marge
     n'y sont donc pas rognés, et le défilement vertical est intact.

     C'est un garde-fou, pas un correctif : ce qui dépassait a été corrigé là
     où ça dépassait (le registre intrinsèque de `RuledGrid`, le portrait des
     pages d'avocate). La règle est là pour que le prochain dépassement se voie
     comme un bloc coupé — et non comme un site qui bouge. */
  html { overflow-x: clip; }

  /* ---- Les ancres de la navigation glissent, elles ne sautent pas ----
     « Services », « Équipe », « Honoraires », « Contact » mènent à des sections
     de l'accueil. Sans ce glissement, le clic remplace l'écran d'un coup et se
     lit comme un changement de page — alors qu'on n'a pas quitté la page.
     Une marge de défilement laisse le filet haut de la section respirer sous
     le bord de la fenêtre. (Le geste est un confort : `prefers-reduced-motion`
     le retire ci-dessous.) */
  html { scroll-behavior: smooth; }
  [id] { scroll-margin-top: var(--gutter); }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
    html { scroll-behavior: auto; }
  }
</style>
