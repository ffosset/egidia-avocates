---
import { withBase } from '../lib/base.js';
/* Les deux fichiers de police que TOUTE page lit dès la première ligne — le
   titre (Fira 700) et le texte courant (Source Sans). `?url` donne l'adresse
   empreintée, la même que celle que `fonts.css` résout : on préchauffe le
   fichier, on n'en ajoute pas un. Les autres graisses et `latin-ext` restent
   à la demande. */
import fira700 from '../fonts/fira-sans-extra-condensed-700-latin.woff2?url';
import sourceSans from '../fonts/source-sans-3-latin.woff2?url';
import '../styles/tokens.css';
import '../styles/pile.css';
import '../styles/pastille.css';
import '../styles/survol.css';
import PageRules from '../components/PageRules.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Le graphe JSON-LD de la page, déjà sérialisé par `graphe()` (src/lib/schema.js). */
  jsonLd?: string;
  /** Une page qui ne doit pas être indexée (la 404) : ni canonique, ni plan du site. */
  noindex?: boolean;
}
const {
  title,
  description = "Cabinet d'avocates à Bruxelles en droit des étrangers, de la famille, à l'aide sociale et de la jeunesse. Consultations sur rendez-vous, aide juridique possible.",
  jsonLd,
  noindex = false,
} = Astro.props;

/* ---- Le titre de l'onglet, qui est aussi celui du résultat de recherche ----
   Le séparateur est le point médian, jamais le tiret cadratin. La marque ferme
   la marche : ce qu'on cherche vient en tête, et c'est la tête que Google
   garde quand il coupe (autour de 60 signes). L'accueil est la seule page où
   la marque ouvre, suivie de ce qu'on est et d'où l'on est. */
const fullTitle = title === 'Egidia'
  ? 'Egidia · Avocates à Bruxelles · Droit des étrangers, famille, jeunesse'
  : `${title} · Egidia`;
/* Le « / » final, toujours : c'est l'adresse que le serveur sert et que le
   plan du site déclare (`build.format: 'directory'`). Au build, l'accueil
   arrive sans lui ; une canonique qui diffère du plan du site d'un signe est
   deux adresses pour Google. */
const chemin = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(chemin, Astro.site);

/* ---- L'image de partage (Open Graph) ----
   Une seule pour tout le site, dessinée par le cabinet : le blason et la
   phrase sur un panneau, l'équipe à droite — 1200 × 630, JPEG, 116 Ko. Elle
   vit dans `assets/` (le dossier public), donc servie telle quelle à une
   adresse SANS empreinte : les réseaux mettent l'aperçu en cache par adresse,
   et une adresse qui changerait à chaque build leur ferait tout recharger.
   Absolue, comme tout ce qui sort du site. */
const partage = {
  url: new URL(withBase('/og.jpg'), Astro.site),
  width: 1200,
  height: 630,
  alt: "Les sept avocates du cabinet Egidia devant le Palais de justice de Bruxelles, à côté du blason et de la mention « Cabinet d'avocates · Droit des étrangers, de la famille, à l'aide sociale et de la jeunesse · Bruxelles »",
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {/* Le favicon n'est pas le blason réduit — à 16px, quatre profils et un
        nom ne sont plus qu'un grain. C'est la seule silhouette du bouclier,
        relevée sur le contour du logo et pleine de sauge obscur. */}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    {/* iOS ne lit pas le SVG pour « Sur l'écran d'accueil » ni pour ses
        signets : sans ce PNG, il pose une capture de la page. La même
        silhouette, sur crème, 180 × 180 — l'appareil arrondit lui-même les
        coins. Généré depuis favicon.svg (sharp) ; à refaire si l'un des deux
        change. */}
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="preload" href={fira700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Egidia" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={partage.url} />
    <meta property="og:image:width" content={String(partage.width)} />
    <meta property="og:image:height" content={String(partage.height)} />
    <meta property="og:image:alt" content={partage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Les données structurées (schema.org). Ce n'est PAS un script au sens
        d'ARCHITECTURE « JavaScript : presque zéro » : le navigateur ne
        l'exécute pas, il l'ignore ; seuls les moteurs le lisent. `is:inline`
        pour qu'Astro ne cherche pas à l'empaqueter. */}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a href="#contenu" class="skip">Aller au contenu</a>
    <PageRules />
    <SiteHeader />
    <div id="contenu"><slot /></div>
    <SiteFooter />
  </body>
</html>

<style is:global>
  /* Le lien d'évitement fait partie du contrat d'accessibilité du cabinet. */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--brun-profond);
    color: var(--creme);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
  }
  .skip:focus { left: var(--content-inset); }

  img { max-width: 100%; }

  /* ---- LA PAGE NE DÉFILE QUE VERS LE BAS ----
     Rien, sur ce site, ne se lit de gauche à droite au-delà du cadre : un
     défilement horizontal n'y est jamais un service rendu, c'est toujours le
     symptôme d'un bloc qui dépasse. Sur un téléphone il coûte cher — la page
     part de travers au premier geste du pouce, et les filets de marge, qui
     sont `fixed`, restent en place pendant que le contenu glisse dessous.

     `clip` et non `hidden` : `hidden` aurait fait de <html> une boîte de
     défilement, ce qui casse `position: sticky` et donne un axe qu'on peut
     encore atteindre au clavier. `clip` ferme l'axe, sans rien d'autre.
     L'`overflow` de la racine se propage à la FENÊTRE : les filets de marge
     n'y sont donc pas rognés, et le défilement vertical est intact.

     C'est un garde-fou, pas un correctif : ce qui dépassait a été corrigé là
     où ça dépassait (le registre intrinsèque de `RuledGrid`, le portrait des
     pages d'avocate). La règle est là pour que le prochain dépassement se voie
     comme un bloc coupé — et non comme un site qui bouge. */
  html { overflow-x: clip; }

  /* ---- Les ancres de la navigation glissent, elles ne sautent pas ----
     « Matières », « Équipe », « Honoraires », « Contact » mènent à des sections
     de l'accueil. Sans ce glissement, le clic remplace l'écran d'un coup et se
     lit comme un changement de page — alors qu'on n'a pas quitté la page.
     Une marge de défilement laisse le filet haut de la section respirer sous
     le bord de la fenêtre. (Le geste est un confort : `prefers-reduced-motion`
     le retire ci-dessous.) */
  html { scroll-behavior: smooth; }
  [id] { scroll-margin-top: var(--gutter); }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
    html { scroll-behavior: auto; }
  }
</style>
