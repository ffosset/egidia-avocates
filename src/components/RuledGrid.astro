---
/** La grille-registre : cellules jointives séparées par des filets d'1px.
 *
 *  Deux modes, et le choix entre les deux est une décision de mise en page :
 *
 *  1. INTRINSÈQUE (`min`) — le mode par défaut à privilégier. On ne déclare
 *     pas un nombre de colonnes, on déclare la largeur minimale d'une cellule ;
 *     la grille se replie toute seule, 4 → 3 → 2 → 1, là où le CONTENU cesse
 *     de tenir. Aucun point de rupture, aucune marche. `maxCols` empêche
 *     seulement d'aller plus large qu'on ne l'a dessiné.
 *
 *     Le registre n'a pas de gouttière — les filets sont des bordures portées
 *     par les cellules — donc `100% / maxCols` est exact : rien à soustraire.
 *
 *  2. COMPOSÉ (`columns`) — pour les mises en page dessinées à la main, où des
 *     cellules sont placées explicitement (matières, carte d'accès). Celles-là
 *     ne peuvent pas se replier toutes seules : elles gardent le point de
 *     rupture unique `--lap` et passent alors sur une colonne.
 */
interface Props {
  /** Mode composé : gabarit de colonnes explicite. */
  columns?: number | string;
  /** Mode intrinsèque : largeur minimale d'une cellule (px si nombre). */
  min?: number | string;
  /** Plafond de colonnes en mode intrinsèque. */
  maxCols?: number;
  class?: string;
  noLeft?: boolean;
  noTop?: boolean;
}
const { columns = 2, min, maxCols = 12, class: klass, noLeft, noTop } = Astro.props;

const minW = typeof min === 'number' ? `${min}px` : min;
/* `min(--registre, …)` : la largeur demandée pour une cellule est un SOUHAIT,
   jamais un plancher. Sans ce plafond, un registre dessiné pour des cellules de
   380px poussait 380px de large dans un téléphone de 375 et faisait glisser
   toute la page de côté. --registre est la largeur utile du registre : sa
   largeur moins son propre filet de gauche (voir la feuille de style). */
const tpl = minW
  ? `repeat(auto-fit, minmax(min(var(--registre), max(${minW}, 100% / ${maxCols})), 1fr))`
  : typeof columns === 'number'
    ? `repeat(${columns}, 1fr)`
    : columns;
---
<div
  class:list={['grid', { composed: !minW, 'no-left': noLeft, 'no-top': noTop }, klass]}
  style={`--cols:${tpl}`}
>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: var(--cols);
    border-top: var(--divider);
    border-left: var(--divider);
    /* ---- LA LARGEUR UTILE DU REGISTRE ----
       Le plafond que les deux gabarits ci-dessus posent sur la largeur d'une
       cellule. Un `100%` seul ne suffit pas : dans une fonction de piste, il se
       résout sur la boîte de BORDURE de la grille, filet de gauche compris —
       la piste valait donc la grille entière, et la dernière cellule dépassait
       d'exactement l'épaisseur de ce filet. On le retire une fois pour toutes,
       ici, plutôt que dans chaque gabarit. */
    --registre: calc(100% - 1px);
    /* La section décide de la couleur ; le registre la reprend, pour que son
       intérieur et la gouttière ne puissent pas diverger. Sans section
       colorée, le registre garde le blanc-papier d'avant. */
    background: var(--section-surface, var(--surface-card));
  }
  .no-left { border-left: none; --registre: 100%; }
  .no-top { border-top: none; }

  /* Seul le mode composé a besoin d'une rupture : ses cellules sont placées à
     la main et ne savent pas se replier. Le mode intrinsèque n'a AUCUN @media.

     Une fois la composition abandonnée, la grille ne retombe pas forcément sur
     une colonne : elle redevient intrinsèque, pilotée par --lap-min (largeur
     minimale d'une cellule) et --lap-max (plafond de colonnes). Sans ces deux
     variables le calcul se réduit à `minmax(100%, 1fr)`, soit une colonne. */
  @media (--lap) {
    .composed {
      grid-template-columns:
        repeat(auto-fit, minmax(min(var(--registre), max(var(--lap-min, 100%), 100% / var(--lap-max, 1))), 1fr));
    }
    /* Un enfant explicitement placé retrouve le flux normal… */
    .composed > :global(*:not(.lap-span)) { grid-column: auto !important; grid-row: auto !important; }
    /* …sauf celui qui doit fermer le registre sur toute sa largeur. */
    .composed > :global(.lap-span) { grid-column: 1 / -1 !important; grid-row: auto !important; }
  }
</style>
