---
import { withBase } from '../lib/base.js';
/** L'arc du bouclier — le seul arrondi du système, réservé à la photographie. */
interface Props {
  src?: string;
  alt?: string;
  corner?: 'bottom-left' | 'bottom-right' | 'top-left' | 'top-right' | 'shield' | 'none';
  ratio?: string;
  legend?: string;
  /** object-position de la photo, ex. « 52% 42% » pour recadrer un groupe. */
  objectPosition?: string;
  /** Rayon elliptique de l'arc, « horizontal vertical » — comme `ArcPanel`.
      Un arc qui balaye toute la hauteur d'un héros a besoin d'un balayage plus
      profond que celui qui adoucit le coin d'une vignette. */
  sweep?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const {
  src,
  alt = '',
  corner = 'bottom-left',
  ratio,
  legend = 'Photographie à fournir',
  objectPosition = 'center',
  sweep = '42% 52%',
  class: klass,
  loading = 'lazy',
} = Astro.props;
const style = [ratio ? `aspect-ratio:${ratio}` : 'height:100%', `--sweep:${sweep}`].join(';');
---
{src ? (
  <div class:list={['arc', `c-${corner}`, klass]} style={style}>
    <img src={withBase(src)} alt={alt} loading={loading} decoding="async" style={`object-position:${objectPosition}`} />
  </div>
) : (
  <div class:list={['arc', `c-${corner}`, 'placeholder', klass]} style={style} role="img" aria-label={legend}>
    <span>{legend}</span>
  </div>
)}

<style>
  .arc { overflow: hidden; }
  .arc img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .c-bottom-left  { border-bottom-left-radius: var(--sweep); }
  .c-bottom-right { border-bottom-right-radius: var(--sweep); }
  .c-top-left     { border-top-left-radius: var(--sweep); }
  .c-top-right    { border-top-right-radius: var(--sweep); }
  .c-shield       { border-radius: 0 0 46% 46% / 0 0 34% 34%; }

  .placeholder {
    background: var(--surface-inset);
    border: 1px dashed var(--line-strong);
    display: grid;
    place-items: center;
    text-align: center;
    padding: var(--space-5);
  }
  .placeholder span { font-size: 16px; color: var(--text-label); }
</style>
