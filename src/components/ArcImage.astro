---
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos.js';
/** L'arc du bouclier — le seul arrondi du système, réservé à la photographie. */
interface Props {
  /** Le chemin propre des données, `/photos/<nom>.jpg` — résolu par `photo()`. */
  src?: string;
  alt?: string;
  corner?: 'bottom-left' | 'bottom-right' | 'top-left' | 'top-right' | 'shield' | 'none';
  ratio?: string;
  legend?: string;
  /** object-position de la photo, ex. « 52% 42% » pour recadrer un groupe. */
  objectPosition?: string;
  /** Rayon elliptique de l'arc, « horizontal vertical » — comme `ArcPanel`.
      Un arc qui balaye toute la hauteur d'un héros a besoin d'un balayage plus
      profond que celui qui adoucit le coin d'une vignette. */
  sweep?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  /** La largeur que la photo OCCUPE à l'écran, en syntaxe `sizes` — c'est
      d'elle que le navigateur déduit quelle largeur télécharger. Sans elle,
      il suppose 100vw et prend la plus grande. À poser à chaque emploi. */
  sizes?: string;
  /** `high` pour LA photo qui ouvre la page (le LCP) : le navigateur la fait
      partir avant les feuilles et les polices. Une seule par page. */
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  src,
  alt = '',
  corner = 'bottom-left',
  ratio,
  legend = 'Photographie à fournir',
  objectPosition = 'center',
  sweep = '42% 52%',
  class: klass,
  loading = 'lazy',
  sizes = '100vw',
  fetchpriority,
} = Astro.props;
const style = [ratio ? `aspect-ratio:${ratio}` : 'height:100%', `--sweep:${sweep}`].join(';');

/* ---- Plusieurs largeurs, deux formats modernes, le JPEG en repli ----
   Le navigateur choisit dans `srcset` la première largeur qui couvre `sizes`
   × la densité de son écran, et dans <picture> le premier format qu'il sait
   lire : AVIF (le plus léger), sinon WebP, sinon le JPEG d'origine. On ne
   propose jamais plus large que le fichier source — sharp n'agrandit pas, et
   une entrée de srcset qui ment fausse le choix. Les largeurs sont l'échelle
   commune du site : un portrait de cellule tombe sur 480 ou 800, le héros
   sur 1200 ou 1600 — et, sur un écran Retina, sur 2400 ou 3000 : à deux
   colonnes il peint jusqu'à 85 % de la fenêtre en pixels d'écran doublés,
   ce qu'un fichier de 1600 ne couvre qu'en s'étirant de moitié, flou. Seule
   une source qui atteint ces largeurs les reçoit (le filtre ci-dessous). */
const image = photo(src);
const LARGEURS = [400, 640, 800, 1200, 1600, 1900, 2400, 3000];
const widths = image ? LARGEURS.filter((w) => w <= image.width) : [];
if (image && widths.at(-1) !== image.width) widths.push(image.width);
---
{image ? (
  <div class:list={['arc', `c-${corner}`, klass]} style={style}>
    <Picture
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      style={`object-position:${objectPosition}`}
    />
  </div>
) : (
  <div class:list={['arc', `c-${corner}`, 'placeholder', klass]} style={style} role="img" aria-label={legend}>
    <span>{legend}</span>
  </div>
)}

<style>
  .arc { overflow: hidden; }
  /* <picture> n'est qu'un aiguillage de formats : il n'a pas de boîte à lui.
     `display: contents` le fait disparaître de la mise en page, et l'<img>
     remplit le cadre comme avant. */
  .arc picture { display: contents; }
  .arc img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .c-bottom-left  { border-bottom-left-radius: var(--sweep); }
  .c-bottom-right { border-bottom-right-radius: var(--sweep); }
  .c-top-left     { border-top-left-radius: var(--sweep); }
  .c-top-right    { border-top-right-radius: var(--sweep); }
  .c-shield       { border-radius: 0 0 46% 46% / 0 0 34% 34%; }

  .placeholder {
    background: var(--surface-inset);
    border: 1px dashed var(--line-strong);
    display: grid;
    place-items: center;
    text-align: center;
    padding: var(--space-5);
  }
  .placeholder span { font-size: 16px; color: var(--text-label); }
</style>
