---
import Page from './Page.astro';
import Eyebrow from './Eyebrow.astro';
import { CONTACT } from '../data/site.js';
import { MATIERES } from '../data/matieres.js';
import { withBase } from '../lib/base.js';
---
<footer>
  <Page>
    <div class="cols">
      <div class="col">
        <!-- Le blason est pour surfaces claires : sur brun profond il va dans une puce crème. -->
        <span class="chip"><img src={withBase("/logo.svg")} alt="Egidia" width="72" height="84" /></span>
        <div class="blurb">
          Cabinet bruxellois en droit des étrangers, de la famille, de l'aide sociale et de la jeunesse.
        </div>
      </div>
      <div class="col">
        <Eyebrow>Services</Eyebrow>
        <div class="liste">
          {MATIERES.map((m) => <a href={withBase(`/services/${m.id}`)}>{m.titre}</a>)}
        </div>
      </div>
      <div class="col">
        <Eyebrow>Le cabinet</Eyebrow>
        <div class="liste">
          <a href={withBase("/#equipe")}>Nos avocates</a>
          <a href={withBase("/aide-juridique")}>Documents pour l'aide juridique</a>
          <a href={withBase("/#honoraires")}>Honoraires</a>
        </div>
      </div>
      <div class="col">
        <Eyebrow>Contact</Eyebrow>
        <!-- Le courriel d'abord : c'est par lui qu'on écrit au cabinet. L'adresse
             et son arrêt viennent ensuite, et ces deux-là se lisent ensemble —
             elles se serrent donc l'une contre l'autre. -->
        <div class="liste">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <div class="lieu">
            <span class="plain">{CONTACT.adresse}</span>
            <span class="plain">{CONTACT.metro} · {CONTACT.tram}</span>
          </div>
        </div>
      </div>
    </div>
  </Page>
  <!-- Le filet des mentions traverse toute la fenêtre, comme ceux de
       l'en-tête : il porte donc sur une bande pleine largeur, et c'est le
       `Page` intérieur qui ramène le texte dans la loi des marges. -->
  <div class="legal-band">
    <Page>
      <div class="legal">
        <span>© 2026 Egidia · <a class="signature" href="https://fosset.co" target="_blank" rel="noopener">Made with care by fosset.co</a></span>
        <span class="legal-links">
          <a href={withBase("/mentions-legales")}>Mentions légales</a>
          <a href={withBase("/vie-privee")}>Vie privée</a>
        </span>
      </div>
    </Page>
  </div>
</footer>

<style>
  /* ---- Le pied de page est SAUGE OBSCUR ----
     Il ferme le site sur la même couleur que la bande des valeurs qui l'ouvre.
     Le vert est plus clair que le brun profond d'avant (luminance 0,111 contre
     0,034), donc tous les tons portés dessus ont été refaits : sur cette base,
     le sable du design system tombe à 4,3:1 et le vert clair des liens à 2,7:1
     — les deux passaient sur brun, aucun des deux ne passe ici.

         crème        #FAF7F4   6,1:1   titre et texte par défaut
         sable clair  #EFEAE1   5,4:1   texte courant, adresse, mentions
         voile caramel#F4EBDD   5,5:1   liens et étiquettes

     Les trois franchissent 4,5:1 (AA, texte courant). La hiérarchie ne repose
     donc plus sur le contraste — les trois valeurs sont proches — mais sur la
     TEINTE : le neutre pour ce qui se lit, le chaud pour ce qui se clique.
     C'est exactement la répartition d'avant, où le sable disait le texte et le
     vert clair les liens ; seule la famille de l'accent change, puisque le vert
     est passé du côté du fond. */
  footer {
    background: var(--sauge-obscur);
    color: var(--text-on-dark);
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
    /* Les étiquettes de colonne sont des `Eyebrow`, et `.eg-label` lit
       `--text-label` : c'est le TOKEN qu'on retourne, pas la classe. Une règle
       écrite ici ne les atteindrait pas — la portée d'Astro ne franchit pas la
       racine d'un composant enfant, et c'est précisément pour cette raison que
       l'ancienne classe `.pale` ne peignait rien : le brun #7A6B5A restait, à
       1,3:1 sur la sauge. Une variable, elle, descend par la cascade. */
    --text-label: var(--caramel-voile);
  }
  /* Quatre colonnes, mais pas quatre parts égales : la première porte un blason
     et une phrase, les trois autres des intitulés courts. Elle prend donc un
     cinquième de plus, et les listes se partagent le reste à égalité — c'est ce
     rapport, et non la largeur du plus long lien, qui tient la composition. Le
     cinquième est calé sur la mesure du chapô (360px) : au-delà, la colonne
     dépasserait son texte et rouvrirait un blanc plus large que la gouttière. */
  .cols {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: var(--space-7);
  }
  /* Sous la rupture, la mise en page redevient intrinsèque — mais PAS libre :
     `auto-fit` seul rendait trois colonnes, et le quatrième bloc partait seul
     à la ligne, laissant un trou des deux tiers de la largeur. Le plancher
     `50% - gouttière/2` interdit une troisième colonne : quatre blocs se
     rangent alors en deux fois deux, et c'est carré. Le `max(220px, …)` replie
     sur une seule colonne quand la moitié devient trop étroite pour un
     intitulé, et le `min(100%, …)` empêche le débordement sous 260px. */
  @media (--lap) {
    .cols {
      grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, max(220px, calc(50% - var(--space-7) / 2))), 1fr)
      );
    }
  }
  /* L'étiquette se détache de sa liste (--space-4), les lignes d'une même liste
     se suivent de près (--space-2) : deux pas, pour qu'on voie d'un coup d'œil
     où un bloc commence et où il continue. */
  .col { display: grid; gap: var(--space-4); align-content: start; }
  .liste { display: grid; gap: var(--space-2); align-content: start; }
  /* L'adresse et son arrêt disent une seule chose — où l'on vient. Quatre pixels
     les séparent, seize les séparent du courriel : le rapport de un à quatre se
     voit, là où deux écarts voisins ne se verraient pas. */
  .lieu { display: grid; gap: var(--space-1); margin-top: var(--space-2); }
  .lieu .plain { line-height: 1.45; }

  /* La puce crème n'a pas de rayon : le système n'en pose nulle part. */
  .chip {
    display: inline-block;
    background: var(--creme);
    padding: var(--space-3) var(--space-4);
    width: fit-content;
  }
  .chip img { height: 72px; width: auto; display: block; }

  .blurb { font-size: var(--fs-body-sm); color: var(--sable-clair); max-width: 360px; line-height: 1.6; }
  .col a { color: var(--caramel-voile); font-size: var(--fs-body-sm); text-decoration: none; }
  /* Le survol ne s'écrit que là où un pointeur survole : au doigt, `:hover`
     reste allumé après l'appui (voir `styles/survol.css`). */
  @media (hover: hover) {
    .col a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  }
  /* Adresse et arrêts sont du texte, pas des liens : la teinte neutre les dit.
     Ils se lisent dans le même corps que le courriel — une seule taille dans la
     colonne, la hiérarchie tient à l'ordre et aux écarts. */
  .plain { font-size: var(--fs-body-sm); color: var(--sable-clair); line-height: 1.6; }

  .legal-band {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(250, 247, 244, 0.26);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 16px;
    color: var(--sable-clair);
  }
  .signature { color: var(--caramel-voile); text-decoration: none; }
  .legal-links { display: flex; gap: 24px; }
  .legal-links a { color: var(--caramel-voile); text-decoration: none; }
  /* La bande des mentions porte les mêmes liens que les colonnes au-dessus, et
     elle s'allume comme elles : le même trait de deux pixels, sous le même
     garde `hover: hover` — au doigt, `:hover` reste allumé après l'appui (voir
     `styles/survol.css`). « Mentions légales » et « Vie privée » étaient les
     deux seuls liens du pied à ne rien faire sous le pointeur. */
  @media (hover: hover) {
    .signature:hover,
    .legal-links a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  }

</style>
