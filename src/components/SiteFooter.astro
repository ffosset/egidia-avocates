---
import Page from './Page.astro';
import Eyebrow from './Eyebrow.astro';
import { CONTACT } from '../data/site.js';
import { MATIERES } from '../data/matieres.js';
import { withBase } from '../lib/base.js';
---
<footer>
  <Page>
    <div class="cols">
      <div class="col">
        <!-- Le blason est pour surfaces claires : sur brun profond il va dans une puce crème. -->
        <span class="chip"><img src={withBase("/logo.svg")} alt="Egidia" width="72" height="84" /></span>
        <div class="blurb">
          Cabinet bruxellois en droit des étrangers, de la famille, de l'aide sociale et de la jeunesse.
        </div>
      </div>
      <div class="col">
        <Eyebrow class="pale">Services</Eyebrow>
        {MATIERES.map((m) => <a href={withBase(`/matieres/${m.id}`)}>{m.titre}</a>)}
      </div>
      <div class="col">
        <Eyebrow class="pale">Le cabinet</Eyebrow>
        <a href={withBase("/#equipe")}>Nos avocates</a>
        <a href={withBase("/aide-juridique")}>Documents pour l'aide juridique</a>
        <a href={withBase("/#honoraires")}>Honoraires</a>
      </div>
      <div class="col">
        <Eyebrow class="pale">Contact</Eyebrow>
        <span class="plain">{CONTACT.adresse}</span>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <span class="small">{CONTACT.metro} · {CONTACT.tram}</span>
      </div>
    </div>
  </Page>
  <!-- Le filet des mentions traverse toute la fenêtre, comme ceux de
       l'en-tête : il porte donc sur une bande pleine largeur, et c'est le
       `Page` intérieur qui ramène le texte dans la loi des marges. -->
  <div class="legal-band">
    <Page>
      <div class="legal">
        <span>© 2026 Egidia · <a class="signature" href="https://fosset.co" rel="noopener">Made with care by fosset.co</a></span>
        <span class="legal-links">
          <a href={withBase("/mentions-legales")}>Mentions légales</a>
          <a href={withBase("/vie-privee")}>Vie privée</a>
        </span>
      </div>
    </Page>
  </div>
</footer>

<style>
  footer {
    background: var(--surface-ink);
    color: var(--text-on-dark);
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
  }
  /* `auto-fit` ne peut pas créer plus de colonnes qu'il n'y a de blocs : le
     plafond de 4 est donné par le contenu, pas par un @media. Le garde
     `min(100%, 220px)` empêche le débordement sous 260px de large. */
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-7);
  }
  .col { display: grid; gap: var(--space-3); align-content: start; }

  .chip {
    display: inline-block;
    background: var(--creme);
    border-radius: 4px;
    padding: var(--space-3) var(--space-4);
    width: fit-content;
  }
  .chip img { height: 72px; width: auto; display: block; }

  .blurb { font-size: var(--fs-body-sm); color: var(--sable); max-width: 300px; line-height: 1.6; }
  .col a { color: var(--sauge-clair); font-size: var(--fs-body-sm); text-decoration: none; }
  .col a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .plain { font-size: var(--fs-body-sm); color: var(--sable); line-height: 1.6; }
  .small { font-size: 16px; color: var(--sable); }
  .pale { color: var(--sauge-clair); }

  .legal-band {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(250, 247, 244, 0.18);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 16px;
    color: var(--sable);
  }
  .signature { color: var(--sauge-clair); text-decoration: none; }
  .signature:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .legal-links { display: flex; gap: 24px; }
  .legal-links a { color: var(--sauge-clair); text-decoration: none; }

</style>
