---
interface Props { tone?: 'neutral' | 'success' | 'info' | 'attention' | 'urgent' }
const { tone = 'neutral' } = Astro.props;
---
<span class:list={['badge', `t-${tone}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
  .t-neutral   { background: var(--surface-inset); color: var(--text-muted); }
  .t-success   { background: var(--status-success-bg); color: var(--status-success-fg); }
  .t-info      { background: var(--status-info-bg); color: var(--status-info-fg); }
  .t-attention { background: var(--status-attention-bg); color: var(--status-attention-fg); }
  .t-urgent    { background: var(--status-urgent-bg); color: var(--status-urgent-fg); }
</style>
