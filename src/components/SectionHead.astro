---
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow?: string; title: string; lead?: string; align?: 'left' | 'center' }
const { eyebrow, title, lead, align = 'left' } = Astro.props;
---
<div class:list={['head', 'pile', `a-${align}`]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2>{title}</h2>
  {lead && <p>{lead}</p>}
</div>

<style>
  .head { max-width: 780px; }
  /* `margin-inline` et non `margin` : le pas vertical appartient à la pile. */
  .a-center { margin-inline: auto; text-align: center; }
  h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--text-heading);
  }
  p {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 640px;
  }
</style>
