---
/**
 * Carte d'accès : l'embarqué Google Maps, teinté aux tons du cabinet — et qui
 * ne contacte Google que si on le lui demande.
 *
 * Pourquoi Google plutôt que les tuiles OpenStreetMap d'avant : la carte n'est
 * pas une décoration, elle sert à SE SITUER. Google porte les repères que le
 * quartier a dans la tête — Louise, Stéphanie, l'avenue, les commerces — et
 * c'est le plan que le visiteur reconnaît déjà. Le plan précédent était juste,
 * mais muet : désaturé à fond, il ne nommait presque rien.
 *
 * ---- LE PLAN NE PART PAS SEUL ----
 * Le serveur ne rend AUCUN <iframe> : l'adresse de l'embarqué dort dans un
 * `data-`, et le script ne fabrique le cadre qu'au clic. Tant que personne n'a
 * cliqué, aucune requête ne quitte le navigateur — Google ne voit ni l'adresse
 * IP, ni la page consultée, ni l'heure de la visite.
 *
 * Ce n'est pas de la prudence de principe : le site ne collecte rien et ne pose
 * aucun formulaire, précisément parce que la situation d'une personne qui
 * cherche un avocat en droit des étrangers ou en aide à la jeunesse ne doit
 * fuir nulle part. Un plan chargé d'office aurait été la seule fuite du site,
 * et la plus bête. Un `<iframe loading="lazy">` n'y suffisait pas : il ne
 * retarde le départ que jusqu'au défilement.
 *
 * Le consentement n'est PAS mémorisé : ni cookie, ni `localStorage`. Le site ne
 * garde rien sur la machine du visiteur — pas même le souvenir d'avoir dit oui.
 *
 * ---- L'ÉCRAN D'APPEL EST DÉJÀ UN PLAN ----
 * Au repos, la cellule ne montre pas une phrase de mise en garde mais une IMAGE
 * du quartier : `/photos/plan.jpg`, un plan gris du quartier Louise exporté de
 * Mapbox par le cabinet et servi depuis le site lui-même — aucune requête ne
 * part vers un tiers pour l'afficher. Mapbox exige son crédit et celui
 * d'OpenStreetMap sur toute image statique : il est dans le coin.
 * `object-fit: cover` la fait remplir la cellule quelle que soit sa taille ;
 * l'adresse et le bouton se posent au milieu, sur un carton de papier. Le
 * plan interactif, lui, reste celui de Google, au clic.
 *
 * ---- LE STYLE EST UNE TEINTE, PAS UN EFFACEMENT ----
 * La teinte est légère et les libellés restent lisibles ; dès que la carte est
 * activée, elle retombe presque à ses vraies couleurs — au moment où l'on s'en
 * sert, la lisibilité passe devant l'accord de tons.
 *
 * Deux adresses possibles pour l'embarqué :
 *  - avec clé, l'API officielle Maps Embed (PUBLIC_GOOGLE_MAPS_KEY) ;
 *  - sans clé, `maps?…&output=embed`, l'embarqué public historique.
 * Le repli sans clé marche aujourd'hui mais n'est pas contractuel : poser la
 * clé dans `.env` fait passer le site sur la voie officielle sans rien changer
 * d'autre.
 */
interface Props {
  lat: number;
  lon: number;
  zoom?: number;
  label?: string;
  /** Ce que Google doit chercher. Par défaut le libellé, parenthèses ôtées. */
  query?: string;
  tint?: boolean;
  class?: string;
}
const { lat, lon, zoom = 15, label, query, tint = true, class: klass } = Astro.props;
import Button from './Button.astro';
import { withBase } from '../lib/base.js';

/* L'aperçu au repos. Chemin propre à la racine, base appliquée au rendu — comme
   les photographies. */
const apercu = withBase('/photos/plan.jpg');

/* Une adresse géocodée pose une épingle plus juste que des coordonnées
   approchées (voir ARCHITECTURE, « ce qui manque encore »). « (1er étage) »
   n'aide pas un géocodeur : les parenthèses tombent. */
const cible = query ?? label?.replace(/\s*\([^)]*\)/g, '').trim() ?? `${lat},${lon}`;
const cle = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY;
const src = cle
  ? `https://www.google.com/maps/embed/v1/place?key=${cle}&q=${encodeURIComponent(cible)}&zoom=${zoom}&language=fr&region=BE`
  : `https://www.google.com/maps?q=${encodeURIComponent(cible)}&z=${zoom}&hl=fr&output=embed`;
---
<div
  class:list={['map-wrap', klass]}
  data-map
  data-src={src}
  data-tint={String(tint)}
  data-title={label ? `Carte : ${label}` : 'Carte du cabinet'}
>
  {/* L'écran d'appel. Il tient tout seul : sans script, il reste ce qu'il
      est — le plan du quartier et l'adresse. Le bouton, lui, ne s'allume que
      si le script tourne (classe `js`) : pas de commande morte. */}
  <div class="consent">
    <img class="apercu" src={apercu} alt="" width="1600" height="630" loading="lazy" decoding="async" />
    <div class="carton">
      <p class="consent-lead">{label ?? 'Le plan du cabinet'}</p>
      {/* Le même bouton que « Trouver l'itinéraire » dans la cellule voisine :
          `secondary`, le cadre nu — l'appel du site reste d'écrire au cabinet. */}
      <Button variant="secondary" class="load" data-load>Afficher le plan</Button>
    </div>
    {/* L'attribution que les conditions de Mapbox exigent. */}
    <small class="credit">
      © <a href="https://www.mapbox.com/about/maps/" target="_blank" rel="noopener">Mapbox</a>
      © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
    </small>
  </div>

  {/* Le voile : posé une fois le plan chargé, il rend la molette à la page.
      Il ne naît qu'avec le script, comme le cadre qu'il couvre. */}
  <button class="veil" type="button" data-veil>
    <span class="tag">Déplacer la carte</span>
  </button>
</div>

<script>
  /* Trois états, et le script est le seul à pouvoir les franchir :
       au repos       — aucun <iframe>, aucune requête ;
       chargé         — le cadre existe, le voile garde la molette ;
       manipulable    — le voile est tombé.
     Vingt lignes, là où le plan précédent chargeait 147 Ko de bibliothèque. */
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const load = wrap.querySelector<HTMLButtonElement>('[data-load]');
    const veil = wrap.querySelector<HTMLButtonElement>('[data-veil]');
    if (!load || !veil) continue;

    wrap.classList.add('js');
    load.addEventListener('click', () => {
      const map = document.createElement('iframe');
      map.className = wrap.dataset.tint === 'false' ? 'eg-map' : 'eg-map tint';
      map.title = wrap.dataset.title ?? 'Carte';
      /* L'origine suffit à une clé restreinte par référent ; le chemin de la
         page consultée, lui, ne regarde pas Google. */
      map.referrerPolicy = 'strict-origin-when-cross-origin';
      map.allowFullscreen = true;
      map.src = wrap.dataset.src ?? '';
      wrap.prepend(map);
      wrap.classList.add('loaded', 'veiled');
      veil.focus();
    });
    veil.addEventListener('click', () => wrap.classList.remove('veiled'));
  }
</script>

<style>
  /* Le plan occupe toute la cellule : rien ne se pose sous lui. Le registre du
     contact tient sur UN plancher (les quatre cellules partent du haut, aucune
     ne porte de lien à son pied) — une barre ici rouvrirait exactement ce que
     `a9990cf` avait refermé. */
  .map-wrap {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    background: var(--surface-inset);
  }

  /* L'<iframe> naît dans le script : il n'a pas l'attribut de portée d'Astro,
     d'où `:global`. */
  .map-wrap :global(.eg-map) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* ---- La teinte ----
     Chaude et légère : assez pour que le plan appartienne au papier, pas assez
     pour effacer un nom de rue. Voile tombé — donc carte en usage — elle
     retombe presque au réel.

     UNE seule règle écrit `filter`, et c'est la variable qui change avec
     l'état. Deux règles concurrentes (`:not(.veiled)` contre la règle de base)
     s'étaient déjà montrées peu fiables ici, et le doute ne valait pas la
     virgule de spécificité gagnée.

     PAS de `transition` sur ce `filter`, et ce n'est pas un oubli : sur un
     <iframe> d'une autre origine, le moteur ne DÉMARRE pas la transition —
     `getAnimations()` reste vide — et laisse la propriété clouée à son
     ancienne valeur. La carte gardait sa teinte de repos une fois activée.
     Posée sans transition, elle bascule net, ce qui est très bien : le clic
     est franc, la carte l'est aussi. (Les deux listes gardent les mêmes
     fonctions dans le même ordre — si une transition redevient possible un
     jour, elles s'interpoleront.) */
  .map-wrap {
    --map-teinte: sepia(0.06) saturate(0.94) hue-rotate(0deg) brightness(1) contrast(1);
  }
  .map-wrap.veiled {
    --map-teinte: sepia(0.24) saturate(0.72) hue-rotate(-6deg) brightness(1.02) contrast(1.02);
  }
  .map-wrap :global(.eg-map.tint) { filter: var(--map-teinte); }

  /* ---- L'écran d'appel ---- */
  .consent {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--cell-pad);
    background: var(--surface-inset);
  }
  .map-wrap.loaded .consent { display: none; }

  /* L'aperçu couvre la cellule, toujours — en largeur comme en hauteur.
     Même teinte de repos que le plan Google voilé : au clic, on ne change pas
     de papier, on n'ôte que le voile. */
  .apercu {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: sepia(0.24) saturate(0.72) hue-rotate(-6deg) brightness(1.02) contrast(1.02);
  }
  /* Le carton : du papier posé au milieu du plan, sans filet — le seul cadre
     de l'écran est celui du bouton. L'adresse et le bouton n'ont pas à se
     battre avec les noms de rue. */
  .carton {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 34rem;
    padding: var(--space-4) var(--space-5);
    background: var(--surface-page);
  }
  .consent-lead {
    margin: 0;
    font-size: 16px;
    color: var(--text-body);
  }
  .credit {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-1);
    padding: 0 var(--space-1);
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface-page) 80%, transparent);
  }
  .credit a { color: inherit; }

  /* Le bouton n'a pas de sens sans script : il ne s'allume qu'une fois la
     classe posée. `.consent .load` bat le `.btn` du composant, sinon le
     `display: none` de repos et l'`inline-flex` du bouton seraient à égalité. */
  .consent .load { display: none; }
  .map-wrap.js .load { display: inline-flex; }
  .load { flex-shrink: 0; margin-top: var(--stack-tight); }

  /* ---- Le voile ---- */
  .veil {
    position: absolute;
    inset: 0;
    display: none;
    place-items: end start;
    padding: var(--space-3);
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .map-wrap.veiled .veil { display: grid; }
  .map-wrap.veiled :global(.eg-map) { pointer-events: none; }

  /* L'étiquette d'activation : du papier à filet, comme le reste du site —
     ni pastille, ni coin arrondi. Là où un pointeur survole, elle attend
     d'être appelée ; au doigt, où rien ne survole, elle reste visible. */
  .tag {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line-strong);
    background: var(--surface-page);
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
    transition: opacity var(--dur-base) var(--ease-standard),
                var(--transition-control);
  }
  .veil:focus-visible .tag { opacity: 1; color: var(--text-heading); background: var(--surface-inset); }
  @media (hover: hover) {
    .tag { opacity: 0; }
    .veil:hover .tag { opacity: 1; color: var(--text-heading); background: var(--surface-inset); }
  }

</style>
