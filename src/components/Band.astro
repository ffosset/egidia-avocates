---
/** Bande pleine largeur, texte centré sur mesure courte. */
interface Props {
  tone?: 'sage' | 'ink' | 'sand' | 'cream';
  align?: 'center' | 'left';
  id?: string;
}
const { tone = 'sage', align = 'center', id } = Astro.props;
---
<section id={id} class:list={['band', `t-${tone}`]} style={`text-align:${align}`}>
  <div class="inner pile"><slot /></div>
</section>

<style>
  .band { padding: var(--section-y) 0; }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--content-inset);
  }
  .t-sage  { background: var(--sauge-obscur); color: var(--text-on-accent); }
  .t-ink   { background: var(--surface-ink); color: var(--text-on-dark); }
  .t-sand  { background: var(--surface-margin); color: var(--text-body); }
  .t-cream { background: var(--surface-page); color: var(--text-body); }
</style>
