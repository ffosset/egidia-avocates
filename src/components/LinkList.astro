---
import Icon from './Icon.astro';
/* Un lien = [libellé, adresse, affichage?]. L'adresse est ce que vise le lien,
   sans le `https://` — sauf pour le rare site qui ne répond qu'en `http://`,
   auquel cas le schéma est écrit et respecté. L'affichage, s'il est donné,
   est ce qu'on écrit en clair à la place — pour une adresse de recherche dont
   la chaîne de requête n'a rien à faire sous les yeux du lecteur. */
interface Props { items: Array<[string, string, string?]> }
const { items } = Astro.props;
const href = (url: string) => (/^https?:\/\//.test(url) ? url : `https://${url}`);
---
<div class="links">
  {/* Tous ces liens sortent du site : ils s'ouvrent dans un nouvel onglet,
      comme partout ailleurs. La flèche oblique et l'adresse écrite en clair
      l'annoncent déjà au lecteur — il n'y a rien à ajouter au libellé. */}
  {items.map(([label, url, affichage]) => (
    <a href={href(url)} class="eg-inverse" target="_blank" rel="noopener">
      <span class="eg-accent glyph"><Icon name="arrow-up-right" size={18} /></span>
      <span>{label}<span class="url">{affichage ?? url}</span></span>
    </a>
  ))}
</div>

<style>
  .links { display: grid; gap: 0; }
  a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--space-4);
    /* ---- LE DÉBORD ----
       Le filet d'une ligne doit traverser TOUT ce qui la contient, sinon il
       commence et s'arrête en l'air. Le débord vaut donc le padding du
       contenant, et c'est le contenant qui le donne : un cran par défaut —
       la valeur qu'il faut dans une carte — `--cell-pad` dans une cellule
       filetée (voir la section « Liens utiles » de l'accueil).

       Le padding horizontal reprend exactement la même valeur : le texte
       revient ainsi PILE là où il serait sans le débord, aligné sur le titre
       qui ouvre le bloc. */
    padding: var(--space-4) var(--links-bleed, var(--space-4));
    margin-inline: calc(-1 * var(--links-bleed, var(--space-4)));
    /* ---- LES ENCRES ----
       La liste vit sur le papier d'une carte comme sur la sauge de l'aplat
       des pages intérieures. Elle ne connaît pas son fond : c'est le
       contenant qui pose, s'il le faut, les quatre encres — le filet, le
       libellé, l'adresse, le glyphe — et chacune retombe sur sa valeur de
       papier quand personne ne la pose. */
    border-top: var(--links-rule, var(--divider));
    text-decoration: none;
    color: var(--links-ink, var(--text-body));
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }
  /* Le glyphe est posé sur la première ligne, pas centré sur le bloc — un
     libellé en prend deux avec son adresse. Les 3px rattrapent la demi-
     différence entre la hauteur de ligne (27px) et le glyphe (18px), moins ce
     que le trait laisse d'air en haut : la même valeur que les lignes de
     coordonnées de l'accueil, pour le même glyphe sur la même ligne. */
  .glyph { color: var(--links-glyph, var(--sauge-obscur)); margin-top: 3px; }
  /* Une adresse écrite en clair est un mot que rien ne coupe : sur un petit
     téléphone, elle imposait sa longueur à la colonne entière et la poussait
     hors du cadre. `anywhere` la laisse se casser — et, à la différence de
     `break-word`, il compte aussi dans la largeur MINIMALE de la colonne, ce
     qui est précisément ce qui décidait du débordement. */
  .url {
    display: block;
    color: var(--links-url, var(--text-label));
    font-size: 16px;
    margin-top: 2px;
    overflow-wrap: anywhere;
  }
  /* Sous le geste, la ligne se couche dans son lit et l'adresse reprend
     l'encre des étiquettes — que `.eg-inverse` a déjà relevée d'un cran pour
     ce lit (voir `styles/survol.css`). Une adresse posée en clair sur la
     sauge serait restée claire sur le lit crème, et aurait disparu. */
  a:focus-visible .url { color: var(--text-label); }
  @media (hover: hover) {
    a:hover .url { color: var(--text-label); }
  }
  /* Au téléphone, la colonne du glyphe coûte trop cher : 24px plus l'espace,
     sur une largeur où chaque libellé se casse déjà en deux ou trois lignes.
     La flèche rentre alors dans le texte, juste devant la première lettre,
     et le libellé comme l'adresse reprennent toute la largeur de la ligne.
     La flèche reste calée sur la ligne de base du texte (l'aligner au milieu
     la décalerait d'un pixel ou deux vers le haut). */
  @media (--lap) {
    a { display: block; }
    .glyph {
      display: inline-block;
      vertical-align: -0.15em;
      margin: 0 0.4em 0 0;
    }
    .glyph :global(svg) { display: block; }
  }
</style>
