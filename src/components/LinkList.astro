---
import Icon from './Icon.astro';
interface Props { items: Array<[string, string]> }
const { items } = Astro.props;
---
<div class="links">
  {/* Tous ces liens sortent du site : ils s'ouvrent dans un nouvel onglet,
      comme partout ailleurs. La flèche oblique et l'adresse écrite en clair
      l'annoncent déjà au lecteur — il n'y a rien à ajouter au libellé. */}
  {items.map(([label, url]) => (
    <a href={`https://${url}`} class="eg-invert" target="_blank" rel="noopener">
      <span class="eg-accent glyph"><Icon name="arrow-up-right" size={20} /></span>
      <span>{label}<span class="url">{url}</span></span>
    </a>
  ))}
</div>

<style>
  .links { display: grid; gap: 0; }
  a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    margin: 0 calc(-1 * var(--space-4));
    border-top: var(--divider);
    text-decoration: none;
    color: var(--text-body);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }
  .glyph { color: var(--sauge-obscur); margin-top: 2px; }
  .url { display: block; color: var(--text-label); font-size: 16px; margin-top: 2px; }
</style>
