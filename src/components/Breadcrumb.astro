---
import Icon from './Icon.astro';
interface Props { items: Array<{ label: string; href?: string }> }
const { items } = Astro.props;
---
<nav aria-label="Fil d'Ariane" class="crumbs">
  {items.map((it, i) => {
    const last = i === items.length - 1;
    return (
      <>
        {last ? (
          <span aria-current="page" class="current">{it.label}</span>
        ) : (
          <a href={it.href ?? '/'}>{it.label}</a>
        )}
        {!last && <span class="sep"><Icon name="chevron-right" size={18} /></span>}
      </>
    );
  })}
</nav>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--fs-body-sm);
  }
  .crumbs a { color: var(--text-muted); }
  .current { color: var(--text-body); font-weight: var(--fw-semibold); }
  .sep { color: var(--text-label); display: inline-flex; }
</style>
