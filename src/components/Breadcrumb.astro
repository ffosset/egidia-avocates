---
import { withBase } from '../lib/base.js';
import { filAriane, graphe } from '../lib/schema.js';
import Icon from './Icon.astro';
interface Props { items: Array<{ label: string; href?: string }> }
const { items } = Astro.props;
---
{/* Le fil d'Ariane se déclare aussi aux moteurs (schema.org/BreadcrumbList),
    depuis la MÊME liste : il ne peut pas dire une chose à l'écran et une autre
    à Google. Le JSON-LD est accepté n'importe où dans le document. */}
<script is:inline type="application/ld+json" set:html={graphe(filAriane(items))} />
<nav aria-label="Fil d'Ariane" class="crumbs">
  {items.map((it, i) => {
    const last = i === items.length - 1;
    return (
      <>
        {last ? (
          <span aria-current="page" class="current">{it.label}</span>
        ) : (
          <a href={withBase(it.href ?? '/')}>{it.label}</a>
        )}
        {!last && <span class="sep"><Icon name="chevron-right" size={18} /></span>}
      </>
    );
  })}
</nav>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--fs-body-sm);
  }
  .crumbs a { color: var(--text-muted); }
  .current { color: var(--text-body); font-weight: var(--fw-semibold); }
  .sep { color: var(--text-label); display: inline-flex; }
</style>
