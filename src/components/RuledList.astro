---
/** Liste éditoriale : filet fin et tiret caramel, jamais de disque coloré.
    `marker="check"` remplace le tiret par la coche caramel des papiers à
    fournir (voir `/aide-juridique`) : même glyphe, même couleur, même taille. */
import Icon from './Icon.astro';
interface Props { items: string[]; columns?: number; marker?: 'dash' | 'check' }
const { items, columns = 1, marker = 'dash' } = Astro.props;
---
<ul style={`grid-template-columns:repeat(${columns},1fr)`}>
  {items.map((it) => (
    <li>
      {marker === 'check' ? (
        <span class="coche" aria-hidden="true"><Icon name="check" size={20} /></span>
      ) : (
        <span class="dash" aria-hidden="true"></span>
      )}
      <span>{it}</span>
    </li>
  ))}
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    column-gap: var(--space-7);
  }
  li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: var(--divider);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .dash {
    width: 14px;
    height: 1px;
    background: var(--caramel);
    flex: 0 0 auto;
    transform: translateY(-6px);
  }
  /* La coche est centrée sur la PREMIÈRE LIGNE, pas sur l'élément : un item
     qui court sur deux lignes la garde en tête. `1.5em` est l'interligne de
     la liste. `align-self: flex-start` parce que le `li` aligne sur la ligne
     de base, ce qui n'a pas de sens pour un glyphe sans texte. */
  .coche {
    display: inline-flex;
    flex: 0 0 auto;
    align-self: flex-start;
    margin-top: calc((1.5em - 20px) / 2);
    color: var(--caramel);
  }
</style>
