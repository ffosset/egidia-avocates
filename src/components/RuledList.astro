---
/** Liste éditoriale : filet fin et tiret caramel, jamais de disque coloré.
    `marker="check"` remplace le tiret par la coche caramel des papiers à
    fournir (voir `/aide-juridique`) : même glyphe, même couleur, même taille.
    `rules={false}` retire les filets : la liste n'est plus un registre, c'est
    une simple énumération, et ses lignes se resserrent d'un cran. */
import Icon from './Icon.astro';
interface Props { items: string[]; columns?: number; marker?: 'dash' | 'check'; rules?: boolean }
const { items, columns = 1, marker = 'dash', rules = true } = Astro.props;
---
<ul class:list={{ plain: !rules }} style={`grid-template-columns:repeat(${columns},1fr)`}>
  {items.map((it) => (
    <li>
      {marker === 'check' ? (
        <span class="coche" aria-hidden="true"><Icon name="check" size={20} /></span>
      ) : (
        <span class="dash" aria-hidden="true"></span>
      )}
      <span>{it}</span>
    </li>
  ))}
</ul>

<style>
  /* ---- LE DÉBORD ----
     Le même que celui de `LinkList` : un filet doit traverser TOUT ce qui le
     contient. Là où la liste vit entre deux filets verticaux — la colonne de
     texte des pages intérieures, au bureau — le contenant pose `--list-bleed`
     et les lignes vont d'un filet à l'autre ; le padding reprend la même
     valeur, et le texte ne bouge pas. Sans rien de posé, la liste fait la
     largeur de son texte, comme avant. */
  ul {
    list-style: none;
    margin: 0 calc(-1 * var(--list-bleed, 0px));
    padding: 0;
    display: grid;
    column-gap: var(--space-7);
  }
  li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--list-bleed, 0px);
    border-top: var(--divider);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  /* Sans filets, le pas d'une ligne à l'autre n'a plus à faire place à un
     trait : il tombe au plus serré de la pile — huit pixels de part et
     d'autre, seize entre deux lignes. */
  .plain li { border-top: 0; padding-block: var(--space-2); }
  .dash {
    width: 14px;
    height: 1px;
    background: var(--caramel);
    flex: 0 0 auto;
    transform: translateY(-6px);
  }
  /* La coche est centrée sur la PREMIÈRE LIGNE, pas sur l'élément : un item
     qui court sur deux lignes la garde en tête. `1.5em` est l'interligne de
     la liste. `align-self: flex-start` parce que le `li` aligne sur la ligne
     de base, ce qui n'a pas de sens pour un glyphe sans texte. */
  .coche {
    display: inline-flex;
    flex: 0 0 auto;
    align-self: flex-start;
    margin-top: calc((1.5em - 20px) / 2);
    color: var(--caramel);
  }
</style>
