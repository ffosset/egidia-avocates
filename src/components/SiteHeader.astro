---
import { withBase } from '../lib/base.js';
/** Mot-symbole à gauche, navigation en cellules filetées à droite.
    Aucun bouton d'action — l'en-tête ne fait que naviguer.

    L'en-tête est une BOÎTE, pas une bande pleine largeur :

    - elle flotte d'une gouttière sous le haut de la page ;
    - ses deux filets horizontaux traversent toute la largeur, comme tous les
      filets de section du site ;
    - ses cellules s'arrêtent exactement sur les deux filets de marge — la
      dernière (« Contact ») ferme la boîte sur le filet de droite ;
    - la première cellule tombe sur --hero-split, la couture : le filet qui
      sépare le mot-symbole de « Matières » est le trait même où commence la
      photographie du héros, juste en dessous.

    « Matières » et « Équipe » portent en plus un déroulant : les cinq
    matières, les sept avocates y pendent sous la cellule. L'intitulé reste un
    LIEN vers la section de l'accueil — le déroulant est un raccourci, jamais
    un passage obligé.

    Sous 1000px la barre disparaît dans un menu. Il repose sur `<details>` :
    il s'ouvre et se ferme sans JavaScript. Ouvert, il prend TOUT L'ÉCRAN :
    l'en-tête devient la page — papier, filets de marge — et les quatre
    entrées remplissent ce qui reste sous la barre. « Matières » et « Équipe »
    y sont des groupes, fermés par défaut, qu'un appui déplie et replie :
    au doigt, l'intitulé bascule, il ne mène pas à la section. */
import { NAV } from '../data/site.js';
import Icon from './Icon.astro';
---
<header>
  <div class="bar">
    <a href={withBase("/")} class="wordmark" aria-label="Egidia — accueil">EGIDIA</a>

    <nav class="cells" aria-label="Navigation principale">
      {NAV.map((l) => (
        <div class:list={['cell', l.enfants && 'has-sub']}>
          <a href={withBase(l.href)} class="eg-survol">
            {l.label}
            {l.enfants && <span class="chevron"><Icon name="chevron-down" size={14} /></span>}
          </a>
          {l.enfants && (
            <div class="sub">
              {l.enfants.map((c) => (
                <a href={withBase(c.href)} class="eg-survol">
                  <span>{c.label}{c.fort && <> <b>{c.fort}</b></>}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <details class="menu" data-menu>
      <summary class="eg-survol">
        <span class="glyph i-open"><Icon name="menu" size={20} /></span>
        <span class="glyph i-close"><Icon name="x" size={20} /></span>
        <span>Menu</span>
      </summary>
      <nav class="drawer" aria-label="Navigation principale">
        {NAV.map((l) => l.enfants ? (
          /* Un groupe : fermé par défaut, la ligne entière l'ouvre et le
             referme. Ici l'intitulé n'est PAS un lien — au doigt, une ligne
             qui mène quelque part ET déplie autre chose est un piège ; on
             choisit de déplier. La section de l'accueil reste à portée du
             pouce : elle est sur la page, sous le menu. */
          <details class="groupe">
            <summary class="eg-survol">
              <span>{l.label}</span>
              <span class="chevron"><Icon name="chevron-down" size={20} /></span>
            </summary>
            {l.enfants.map((c) => (
              <a href={withBase(c.href)} class="eg-survol enfant">
                <span>{c.label}{c.fort && <> <b>{c.fort}</b></>}</span>
              </a>
            ))}
          </details>
        ) : (
          <a href={withBase(l.href)} class="eg-survol">{l.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  header {
    /* La boîte respire d'une gouttière sous le haut de la page : la bande
       claire au-dessus est la page elle-même, traversée par les filets. */
    margin-top: var(--gutter);
    border-top: var(--divider);
    border-bottom: var(--divider);
    background: var(--surface-page);
    position: relative;
    /* PAR-DESSUS le héros (6), pour que le sous-menu et le tiroir ouverts le
       recouvrent — et donc par-dessus les filets de marge (5), que le héros
       recouvre lui-même pour dégager sa photographie. Les filets doivent
       pourtant traverser l'en-tête, pour dessiner les deux bords verticaux de
       la boîte : l'en-tête les redessine (voir `header::before / ::after`) —
       et, menu ouvert, sur toute la hauteur de l'écran. */
    z-index: 7;
    /* La hauteur de la barre glisse avec le cadre, comme les marges. */
    --bar-h: clamp(64px, 5vw, 88px);
  }

  /* Les deux filets de marge, redessinés sur la hauteur de la boîte : même
     calcul que `PageRules` — l'en-tête fait la largeur de la fenêtre, le
     `100%` se résout sur le même bloc. Au-dessus de la barre, comme les vrais
     filets l'étaient. */
  header::before,
  header::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-page-rule);
    z-index: 1;
    pointer-events: none;
  }
  header::before { left:  calc(max(0px, (100% - var(--page-max)) / 2) + var(--page-margin)); }
  header::after  { right: calc(max(0px, (100% - var(--page-max)) / 2) + var(--page-margin)); }

  .bar {
    max-width: var(--page-max);
    margin-inline: auto;
    /* Les cellules s'arrêtent sur les filets de marge, jamais sur le bord de
       la fenêtre : c'est tout le sujet de la boîte. */
    padding-inline: var(--page-margin);
    display: grid;
    /* Colonne 1 : du filet de gauche à la couture. Elle PLAFONNE à cette
       valeur (`minmax(0, …)`) et cède d'elle-même si les intitulés de la
       navigation ne tiennent plus — l'alignement sur la photo est un idéal,
       pas une raison de couper un mot. */
    grid-template-columns: minmax(0, calc(var(--hero-split) - var(--frame-inset))) auto;
    align-items: stretch;
  }

  .wordmark {
    display: flex;
    align-items: center;
    min-height: var(--bar-h);
    /* Une gouttière après le filet : le texte commence à --content-inset. */
    padding-inline: var(--gutter) var(--space-5);
    text-decoration: none;
    /* Playfair, et non la famille d'affichage : le mot-symbole est la signature
       du cabinet, pas un titre. Voir `--font-wordmark` dans `styles/tokens.css`. */
    font-family: var(--font-wordmark);
    font-size: 26px;
    font-weight: var(--fw-regular);
    letter-spacing: 0.22em;
    color: var(--text-heading);
  }

  .cells { display: flex; }
  .cell {
    /* Cellules d'égale largeur, qui remplissent exactement l'espace de la
       couture au filet de droite ; `max-content` interdit qu'un intitulé se
       coupe — c'est alors le mot-symbole qui rend la place. */
    flex: 1 1 0;
    min-width: max-content;
    display: flex;
    border-left: var(--divider);
    /* Ancre du déroulant : il pend de la cellule, pas de la barre. */
    position: relative;
  }
  .cells a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--bar-h);
    /* Le blanc de la cellule glisse avec le cadre : c'est lui qui décide, tout
       en bas de l'échelle, si les quatre intitulés tiennent encore entre la
       couture et le filet de droite. */
    padding: 0 clamp(12px, 1.5vw, 24px);
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-muted);
    transition: var(--transition-control);
  }
  /* Le lit du survol est posé par `.eg-survol` (voir `styles/survol.css`) : la
     cellule ne repeint que son encre. */
  .cells a:focus-visible { color: var(--survol-encre); }

  /* ---- Les déroulants (matières, avocates) ----
     « Matières » et « Équipe » RESTENT des liens : ils mènent à leur section
     de l'accueil, comme avant. Le déroulant ne fait que raccourcir le chemin
     vers une matière ou une avocate précise — il ne capture pas le clic, et
     rien n'y est accessible seulement par lui. Il s'ouvre au survol et au clavier (`:focus-within`), sans
     JavaScript.

     Le panneau reprend la boîte de la cellule : il déborde d'un filet à
     gauche pour retomber pile sur celui de la cellule, et pend sous le filet
     bas de l'en-tête. Ses intitulés gardent leur casse — ce sont des titres de
     matières et des noms, pas des étiquettes de barre. */
  .chevron {
    display: flex;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .has-sub:hover .chevron,
  .has-sub:focus-within .chevron { transform: rotate(180deg); }

  .sub {
    position: absolute;
    top: 100%;
    left: calc(-1 * var(--border-rule));
    min-width: calc(100% + 2 * var(--border-rule));
    display: grid;
    background: var(--surface-page);
    border: var(--divider);
    border-top: 0;
    /* Fermé, il ne prend ni le clic ni le lecteur d'écran ; `visibility` ne
       retombe qu'une fois la fondue finie. */
    visibility: hidden;
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-2)));
    transition:
      opacity var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard),
      visibility 0s linear var(--dur-fast);
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .sub a {
    justify-content: flex-start;
    min-height: var(--tap-min);
    padding: var(--space-3) var(--gutter);
    border-top: var(--divider);
    font-weight: var(--fw-medium);
    letter-spacing: normal;
    text-transform: none;
  }
  .sub a:first-child { border-top: 0; }
  /* La clé de tri mise en avant : le nom de famille des avocates, pour qu'une
     liste triée sur lui se lise comme telle (voir `NAV`). Un cran de graisse
     ne suffisait pas à l'œil — il prend DEUX axes : le prénom recule au
     régulier, le nom monte au demi-gras ET à l'encre des titres, quand le lien
     est en encre atténuée. Au survol, tout le nom prend le caramel, comme
     avant : le `<b>` hérite. Le `<span>` qui enveloppe l'intitulé n'est pas
     décoratif : le lien est une boîte flexible à `gap`, et deux mots posés
     directement dedans seraient deux items — l'espace entre eux deviendrait
     le `gap`. */
  .sub a:has(b),
  .drawer a:has(b) { font-weight: var(--fw-regular); }
  .sub b,
  .drawer b {
    font-weight: var(--fw-semibold);
    color: var(--text-heading);
  }
  .sub a:focus-visible b,
  .drawer a:focus-visible b { color: inherit; }

  /* ---- Le menu, sous le point de rupture ---- */
  .menu { display: none; }
  .menu > summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--bar-h);
    padding-inline: var(--space-5);
    border-left: var(--divider);
    cursor: pointer;
    list-style: none; /* pas de triangle */
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-muted);
    transition: var(--transition-control);
  }
  .menu > summary::-webkit-details-marker { display: none; }
  .menu > summary:focus-visible { color: var(--survol-encre); }
  /* Le glyphe dit l'état : barres fermé, croix ouvert. (Le sélecteur porte sur
     une enveloppe locale, pas sur `Icon` : les styles de ce composant ne
     descendent pas dans le gabarit d'un autre.) */
  .glyph { display: flex; }
  .menu:not([open]) .i-close,
  .menu[open] .i-open { display: none; }

  /* Le tiroir prend TOUT L'ÉCRAN sous la barre — la page ne se voit plus, il
     n'y a rien à pousser. Il est `fixed` et non `absolute` : son bloc
     conteneur est la fenêtre, jamais la barre, et il descend jusqu'au bord
     bas quoi qu'il arrive. Son bord haut est celui de la barre ouverte (voir
     `header:has(.menu[open])`) : la gouttière, le filet, la barre.

     Seize intitulés ne tiennent pas dans la hauteur d'un téléphone : le
     tiroir défile lui-même, et `overscroll-behavior` retient le geste au bord
     de la liste au lieu de le passer à la page. (La page est de toute façon
     verrouillée — voir `html:has(...)`, plus bas.)

     Ses filets ne s'écrivent plus en bordure : ce sont ceux de l'en-tête
     (`header::before / ::after`), qui traversent tout l'écran par-dessus lui.
     Les filets horizontaux, eux, vont d'un bord à l'autre, comme tous les
     filets de section du site ; le texte, lui, commence à --content-inset et
     ne touche jamais un filet de marge. */
  .drawer {
    position: fixed;
    top: calc(var(--gutter) + var(--border-rule) + var(--bar-h));
    inset-inline: 0;
    bottom: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface-page);
  }
  .drawer a,
  .drawer summary {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: var(--space-4) var(--content-inset);
    border-top: var(--divider);
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    transition: var(--transition-control);
  }
  .drawer a:focus-visible,
  .drawer summary:focus-visible { color: var(--survol-encre); }

  /* ---- Les groupes (matières, avocates) ----
     Ce que le déroulant fait au survol sur la barre, le groupe le fait au
     doigt : un `<details>` par groupe, FERMÉ par défaut — le menu s'ouvre sur
     ses quatre entrées, pas sur seize lignes. La ligne entière est le
     `<summary>` : l'intitulé à gauche, le chevron à droite, qui se retourne
     à l'ouverture. Ouvert, l'intitulé prend l'encre des titres : c'est lui
     qui tient les lignes qui pendent dessous. Pas de `name` : les deux
     groupes s'ouvrent et se ferment chacun pour soi. */
  .drawer summary {
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none; /* pas de triangle */
  }
  .drawer summary::-webkit-details-marker { display: none; }
  .groupe[open] > summary { color: var(--text-heading); }
  .groupe[open] .chevron { transform: rotate(180deg); }

  /* ---- LES SURVOLS DE L'EN-TÊTE ----
     Ils ne s'écrivent que là où un pointeur survole. Au doigt, `:hover` est
     posé par l'appui et laissé allumé : un intitulé du tiroir serait resté
     caramel après qu'on l'a touché (voir `styles/survol.css`). Le focus
     clavier, lui, reste : il vaut sur tous les écrans. */
  @media (hover: hover) {
    .cells a:hover,
    .menu > summary:hover,
    .drawer a:hover,
    .drawer summary:hover { color: var(--survol-encre); }
    .sub a:hover b,
    .drawer a:hover b { color: inherit; }
  }
  /* Les lignes d'un groupe : en retrait sous leur intitulé, et dans leur
     casse propre — ce sont des titres de matières et des noms, pas des
     étiquettes de barre. */
  .drawer a.enfant {
    padding-left: calc(var(--content-inset) + var(--space-5));
    font-weight: var(--fw-medium);
    letter-spacing: normal;
    text-transform: none;
    color: var(--text-body);
  }

  /* Les quatre intitulés cessent de tenir sur une ligne à côté du mot-symbole :
     c'est un vrai changement de mode, pas une marche — il garde donc le point
     de rupture unique. */
  @media (--lap) {
    .bar { grid-template-columns: 1fr auto; }
    .cells { display: none; }
    .menu { display: flex; }

    /* ---- Le menu ouvert prend tout l'écran ----
       L'en-tête se cloue à la fenêtre et la remplit : c'est lui, le papier
       sous le menu, et ses deux filets de marge (`::before / ::after`, de
       `top: 0` à `bottom: 0`) courent désormais sur toute la hauteur — le
       menu est une page du site, avec le cadre de toutes les pages.

       RIEN NE BOUGE SOUS LE DOIGT. Fermée, la boîte flotte d'une gouttière
       sous le haut de la page ; ouverte, elle garde exactement cette place :
       la gouttière devient une marge intérieure, peinte en papier, et c'est la
       barre qui porte le filet du haut à la place de l'en-tête. Le bouton
       qu'on vient de toucher est toujours là où on l'a touché, et devient la
       croix qui referme. Le filet du bas de l'en-tête, lui, n'a plus de sens
       au bord de l'écran : c'est le filet haut du premier intitulé qui ferme
       la barre, au même pixel qu'avant.

       Ce n'est posé que sous le point de rupture : au-dessus, le `<details>`
       est caché mais peut être resté `open` — un menu ouvert sur un téléphone
       que l'on tourne, une fenêtre que l'on élargit — et l'en-tête ne doit
       pas se clouer à un écran où la barre existe. */
    header:has(.menu[open]) {
      position: fixed;
      inset: 0;
      margin-top: 0;
      padding-top: var(--gutter);
      border-top: 0;
      border-bottom: 0;
    }
    header:has(.menu[open]) .bar { border-top: var(--divider); }

    /* La page derrière ne défile plus : le tiroir a son propre défilement,
       et un pouce qui glisse hors de la liste ne doit pas emporter la page
       qu'on ne voit pas. `overflow: hidden` sur la racine se propage à la
       fenêtre et la fige — c'est ce que `Base.astro` s'interdit en régime
       normal (il casse `position: sticky`), mais rien de sticky n'est visible
       sous un menu qui couvre tout, et la position de défilement est rendue
       intacte à la fermeture. Le crochet est `[data-menu]`, unique au site,
       et non `.menu` : `:global` ne porte pas la portée du composant. */
    :global(html:has([data-menu][open])) { overflow: hidden; }
  }
</style>

<script>
  /* Le menu fonctionne SANS JavaScript : `<details>` s'en charge. Le script
     n'ajoute que deux conforts — refermer après un lien d'ancre (la page ne
     recharge pas), et refermer sur Échap. */
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-menu]');
  menus.forEach((menu) => {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((menu) => (menu.open = false));
  });
</script>
