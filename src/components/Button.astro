---
import { withBase } from '../lib/base.js';
/**
 * Le survol par inversion est en CSS pur : aucun JS.
 * Libellés à l'infinitif, jamais « Cliquez ici ».
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'quiet' | 'shadow';
  size?: 'lg' | 'md';
  icon?: string;
  iconPosition?: 'left' | 'right';
  fullWidth?: boolean;
  disabled?: boolean;
  href?: string;
  class?: string;
}
import Icon from './Icon.astro';

const {
  variant = 'primary',
  // `md` est LA taille du site : plus rien n'appelle `lg`, qui reste
  // disponible pour un bouton isolé qui aurait à crier plus fort.
  size = 'md',
  icon,
  iconPosition = 'right',
  fullWidth,
  disabled,
  href,
  class: klass,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const hrefOut = withBase(href);
// Un glyphe fait la taille du texte à côté duquel il se pose : --fs-body (20)
// pour `lg`, --fs-body-sm (18) pour `md`. Jamais une valeur à part.
const iconSize = size === 'lg' ? 20 : 18;
---

<Tag
  href={hrefOut}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={[
    'btn',
    `v-${variant}`,
    `s-${size}`,
    { full: fullWidth },
    // Les deux variantes qui s'allument au survol prennent le lit commun ;
    // les autres ne font qu'approfondir leur propre couleur.
    (variant === 'secondary' || variant === 'shadow') && 'eg-survol',
    klass,
  ]}
>
  {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
  <span><slot /></span>
  {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    line-height: 1;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition-control), transform var(--dur-instant) var(--ease-standard);
  }
  .btn.full { display: flex; width: 100%; }
  .btn:active { transform: scale(var(--press-scale)); }

  .s-lg { height: var(--control-h); padding: 0 var(--space-6); font-size: var(--fs-body); }
  .s-md { height: var(--control-h-sm); padding: 0 var(--space-5); font-size: var(--fs-body-sm); }

  .v-primary {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    border: 1px solid var(--btn-primary-bg);
  }

  /* Inversion : le cadre clair devient un aplat brun profond. */
  .v-secondary {
    background: transparent;
    color: var(--btn-secondary-fg);
    border: 1px solid var(--btn-secondary-border);
  }

  .v-accent {
    background: var(--btn-accent-bg);
    color: var(--btn-accent-fg);
    border: 1px solid var(--btn-accent-bg);
  }

  /* Bouton d'ombre : du papier posé sur la page. L'emphase vient de l'ombre
     chaude, pas d'un aplat de couleur. Au survol il s'inverse comme tout cadre
     cliquable du système — l'ombre ne grossit pas. */
  .v-shadow {
    background: var(--surface-card);
    color: var(--text-body);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-raised);
  }
  .v-shadow:focus-visible {
    border-color: var(--hover-invert-bg);
    color: var(--hover-invert-fg);
  }

  .v-quiet {
    background: transparent;
    color: var(--text-link);
    border: 1px solid transparent;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- LES CINQ SURVOLS, ENSEMBLE ----
     Ils ne s'écrivent que là où un pointeur survole. Au doigt, `:hover` est
     posé par l'appui et LAISSÉ allumé jusqu'au prochain — un bouton resterait
     dans son état de survol après avoir été touché (voir `styles/survol.css`).
     L'appui, lui, garde son `scale` : c'est le retour du geste, pas un état.
     Et le lit du secondaire vient de `.eg-survol` : le bouton ne pose ici que
     son cadre et son encre. */
  @media (hover: hover) {
    .v-primary:hover {
      background: var(--btn-primary-bg-hover);
      border-color: var(--btn-primary-bg-hover);
    }
    .v-secondary:hover {
      border-color: var(--hover-invert-bg);
      color: var(--hover-invert-fg);
    }
    .v-accent:hover {
      background: var(--btn-accent-bg-hover);
      border-color: var(--btn-accent-bg-hover);
    }
    .v-shadow:hover {
      border-color: var(--hover-invert-bg);
      color: var(--hover-invert-fg);
    }
    .v-quiet:hover { color: var(--text-link-hover); }
  }

  .btn[aria-disabled='true'],
  .btn:disabled {
    background: var(--gris);
    color: #8e877c;
    border-color: var(--gris);
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
