---
import { withBase } from '../lib/base.js';
/** Cellule-portrait : photo pleine cellule, nom dans un bandeau caramel au pied. */
import ArcImage from './ArcImage.astro';

interface Props {
  name: string;
  photo?: string;
  meta?: string | null;
  ratio?: string;
  edge?: 'left' | 'right' | 'both';
  href?: string;
}
const { name, photo, meta, ratio = '4 / 5', edge, href } = Astro.props;
const [prenom, ...reste] = String(name).split(' ');
const nom = reste.join(' ');
const Tag = href ? 'a' : 'div';
---
<Tag href={withBase(href)} class:list={['person', edge && `e-${edge}`, { clickable: !!href }]}>
  <span class="media">
    <ArcImage src={photo} alt={name} ratio={ratio} corner="none" legend="Portrait à fournir" />
    {meta && <span class="meta">{meta}</span>}
  </span>
  <span class="band">
    <span class="name">{prenom}<br />{nom}</span>
  </span>
</Tag>

<style>
  .person {
    display: flex;
    flex-direction: column;
    position: relative;
    border-right: var(--divider);
    border-bottom: var(--divider);
    background: var(--section-surface, var(--surface-card));
    text-decoration: none;
    color: inherit;
  }
  .media { position: relative; display: block; flex: 1; }
  .meta {
    position: absolute;
    top: 0;
    right: 0;
    padding: 8px var(--space-3);
    background: var(--surface-page);
    border-left: var(--divider);
    border-bottom: var(--divider);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-label);
    white-space: nowrap;
  }
  .e-right .meta, .e-both .meta { right: var(--gutter); }

  .band {
    display: flex;
    align-items: flex-end;
    padding: var(--space-5);
    min-height: 108px;
    /* Voile de caramel : la même famille chaude que le brun du nom, plutôt
       qu'un vert qui n'appartient à rien d'autre dans la cellule. */
    background: var(--surface-warm-soft);
    /* La couleur du sous-titre est posée ICI, sur le bandeau, et non sur
       `.name` : c'est elle que la règle de survol remplace. Écrite sur le nom,
       elle survivrait à l'inversion et laisserait un brun moyen sur brun
       profond. */
    color: var(--type-subtitle-color);
    transition: var(--transition-control);
  }
  .e-left .band,  .e-both .band { padding-left: var(--content-inset); }
  .e-right .band, .e-both .band { padding-right: var(--content-inset); }

  .name {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    line-height: 1.18;
  }
  /* ---- LE LIT, SUR UN PORTRAIT ----
     La cellule-portrait ne peut pas recevoir le voile comme les autres : son
     fond n'est jamais visible, couvert en haut par la photographie et en bas
     par le bandeau. Le geste s'écrit donc là où il se voit, et il s'écrit deux
     fois — c'est la seule surface du site où le lit prend deux formes, parce
     qu'elle est la seule à être faite de deux matières.

     LE BANDEAU monte d'un cran sur la même rampe. Il repose déjà dans le voile
     de caramel ; il passe au caramel plein. Ailleurs le lit va de rien au
     voile, ici du voile à l'aplat : dans les deux cas la surface avance d'UN
     PAS, et c'est ce pas qu'on lit, jamais la valeur d'arrivée.

     LA PHOTOGRAPHIE reçoit le même caramel en `multiply` — elle n'a pas de
     fond à repeindre, elle EST le fond. `multiply` teinte au lieu de couvrir :
     les valeurs du portrait passent sous la couleur au lieu d'être effacées, et
     le visage reste un visage. À .3, la teinte se voit sans que la
     photographie cesse d'être une photographie ; c'est ce qui restait de mieux
     dans le balayage d'avant, et la seule chose qu'il valait la peine d'en
     garder.

     `isolation` enferme le mélange dans la cellule : sans elle, `multiply`
     irait chercher le fond de la section derrière. */
  .clickable { isolation: isolate; }
  .clickable .media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* AU-DESSUS de la photographie, qui est un enfant en flux. */
    z-index: 1;
    background: var(--survol-marque);
    mix-blend-mode: multiply;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--survol-duree-geste) var(--ease-out);
  }

  /* Le nom et la flèche avancent du même pas que le contenu des autres
     cellules. Le bandeau, lui, ne bouge pas : il porte le filet du registre. */
  .clickable .name,
  .clickable .arrow {
    transition: transform var(--survol-duree-geste) var(--ease-standard);
  }

  /* L'encre du bandeau est posée sur le BANDEAU et non sur `.name` : écrite sur
     le nom, elle lui survivrait et laisserait un brun moyen sur le caramel. La
     flèche suit, par `currentColor`. */
  .clickable:focus-visible .band {
    background: var(--survol-marque);
    color: var(--survol-encre);
  }
  .clickable:focus-visible .media::after { opacity: .3; }
  .clickable:focus-visible .name,
  .clickable:focus-visible .arrow { transform: translateX(var(--survol-decalage)); }

  /* Le geste ne s'écrit que là où un pointeur survole : au doigt, `:hover` est
     posé par l'appui et laissé allumé, et le portrait serait resté teinté après
     qu'on l'a touché (voir `styles/survol.css`). */
  @media (hover: hover) {
    .clickable:hover .band {
      background: var(--survol-marque);
      color: var(--survol-encre);
    }
    .clickable:hover .media::after { opacity: .3; }
    .clickable:hover .name,
    .clickable:hover .arrow { transform: translateX(var(--survol-decalage)); }
  }

  /* Comme partout : la teinte et l'encre restent, le déplacement se retire. */
  @media (prefers-reduced-motion: reduce) {
    .clickable .media::after { transition-duration: 0s; }
    .clickable:hover .name,
    .clickable:hover .arrow,
    .clickable:focus-visible .name,
    .clickable:focus-visible .arrow { transform: none; }
  }
</style>
