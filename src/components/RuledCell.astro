---
interface Props {
  title?: string;
  lead?: string;
  eyebrow?: string;
  href?: string;
  minHeight?: number | string;
  align?: 'top' | 'center';
  /** Une cellule contre un filet prend --content-inset de ce côté. */
  edge?: 'left' | 'right' | 'both';
  class?: string;
  style?: string;
}
const {
  title,
  lead,
  eyebrow,
  href,
  minHeight = 260,
  align = 'top',
  edge,
  class: klass,
  style,
} = Astro.props;
const Tag = href ? 'a' : 'div';
const mh = typeof minHeight === 'number' ? `${minHeight}px` : minHeight;
---
<Tag
  href={href}
  class:list={[
    'cell',
    'pile',
    `a-${align}`,
    edge && `e-${edge}`,
    href && 'eg-invert',
    klass,
  ]}
  style={[`min-height:${mh}`, style].filter(Boolean).join(';')}
>
  {eyebrow && <span class="eg-label">{eyebrow}</span>}
  {title && <h3>{title}</h3>}
  {lead && <p>{lead}</p>}
  <slot />
</Tag>

<style>
  /* Pas de `gap` : c'est la pile qui espace, paire par paire (voir pile.css).
     Un gap donnerait la même valeur au label et à son titre qu'à deux blocs. */
  .cell {
    display: flex;
    flex-direction: column;
    padding: var(--cell-pad);
    border-right: var(--divider);
    border-bottom: var(--divider);
    background: transparent;
    text-align: left;
    text-decoration: none;
    color: inherit;
  }
  .a-top { justify-content: flex-start; }
  .a-center { justify-content: center; }

  .e-left,  .e-both { padding-left: var(--content-inset); }
  .e-right, .e-both { padding-right: var(--content-inset); }

  .cell h3 {
    font-family: var(--font-display);
    font-size: clamp(24px, 2vw, 30px);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--text-heading);
    max-width: 18ch;
  }
  .cell p {
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 34ch;
  }
</style>
