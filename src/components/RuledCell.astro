---
import { withBase } from '../lib/base.js';
interface Props {
  title?: string;
  lead?: string;
  eyebrow?: string;
  href?: string;
  minHeight?: number | string;
  align?: 'top' | 'center';
  /** Une cellule contre un filet prend --content-inset de ce côté. */
  edge?: 'left' | 'right' | 'both';
  class?: string;
  style?: string;
}
const {
  title,
  lead,
  eyebrow,
  href,
  minHeight = 260,
  align = 'top',
  edge,
  class: klass,
  style,
} = Astro.props;
const Tag = href ? 'a' : 'div';
const mh = typeof minHeight === 'number' ? `${minHeight}px` : minHeight;
---
<Tag
  href={withBase(href)}
  class:list={[
    'cell',
    'pile',
    `a-${align}`,
    edge && `e-${edge}`,
    href && 'eg-inverse',
    klass,
  ]}
  style={[`min-height:${mh}`, style].filter(Boolean).join(';')}
>
  {eyebrow && <span class="eg-label">{eyebrow}</span>}
  {title && <h3>{title}</h3>}
  {lead && <p>{lead}</p>}
  <slot />
</Tag>

<style>
  /* Pas de `gap` : c'est la pile qui espace, paire par paire (voir pile.css).
     Un gap donnerait la même valeur au label et à son titre qu'à deux blocs. */
  .cell {
    /* ---- LA MESURE DE LA CELLULE ----
       Le nom et son résumé se cassent sur la MÊME verticale : une seule valeur,
       portée par la cellule, lue par les deux.

       Elle est en `rem`, et c'est le fond du problème qu'elle corrige. Un `ch`
       posé ici ne serait pas résolu ici : une custom property est substituée
       telle quelle puis calculée dans le contexte de l'ENFANT qui la lit, et
       `ch` suit la taille de police de cet enfant. Les deux mesures d'avant
       étaient donc écrites dans deux unités différentes sans le dire — 18ch de
       32px pour le nom (~290px), 34ch de 18px pour le résumé (~306px) — d'où
       deux bords de droite qui ne tombaient jamais ensemble.
       `rem` est relatif à la racine : la même longueur pour les deux. */
    --cell-measure: 20rem;
    display: flex;
    flex-direction: column;
    padding: var(--cell-pad);
    border-right: var(--divider);
    border-bottom: var(--divider);
    background: transparent;
    text-align: left;
    text-decoration: none;
    color: inherit;
  }
  .a-top { justify-content: flex-start; }
  .a-center { justify-content: center; }

  .e-left,  .e-both { padding-left: var(--content-inset); }
  .e-right, .e-both { padding-right: var(--content-inset); }

  /* Le nom de la chose : rôle « sous-titre », défini une fois dans
     `styles/tokens.css`. Ne restent ici que la conduite et la mesure. */
  .cell h3 {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    line-height: 1.2;
    color: var(--type-subtitle-color);
    max-width: var(--cell-measure);
  }
  /* Le carré est POSÉ SUR LA LIGNE DE BASE (`vertical-align` par défaut d'un
     inline-block) : il s'aligne sur le pied des lettres, pas sur un milieu
     optique qui flotterait. Il reste sur la première ligne d'un titre qui en
     prend deux — c'est une puce, pas une colonne. */
  .cell h3::before {
    content: '';
    display: inline-block;
    width: var(--type-subtitle-mark);
    height: var(--type-subtitle-mark);
    margin-right: var(--type-subtitle-mark-gap);
    /* Pas `currentColor` : au survol le carré s'allume en caramel pendant que
       le titre fonce (voir `styles/tokens.css`). */
    background: var(--type-subtitle-mark-color);
  }
  .cell p {
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: var(--cell-measure);
  }
</style>
