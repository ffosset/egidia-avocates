---
import Page from './Page.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import { CONTACT } from '../data/site.js';
---
<section class="contact-band">
  <Page>
    <div class="split">
      <div>
        <Eyebrow>Une question sur votre situation ?</Eyebrow>
        <h2>Les consultations ont lieu uniquement sur rendez-vous.</h2>
        <p>Contactez-nous par téléphone ou par e-mail pour convenir d'une date.</p>
      </div>
      <div class="actions">
        <Button href={`mailto:${CONTACT.email}`} icon="mail" iconPosition="left">Écrire au cabinet</Button>
        <Button href="/#contact" variant="secondary">Nous trouver</Button>
      </div>
    </div>
  </Page>
</section>

<style>
  .contact-band {
    container: band / inline-size;
    background: var(--surface-accent-soft);
    padding: var(--space-9) 0;
    margin-top: var(--space-10);
  }
  /* Deux colonnes égales tant qu'elles tiennent, puis empilées — le point de
     bascule est donné par la mesure du texte (en ch), pas par un pixel deviné. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-9);
  }
  .split > * { flex: 1 1 26ch; }
  h2 {
    margin-top: var(--stack-tight);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    max-width: 24ch;
  }
  p {
    margin-top: var(--stack-tight);
    font-size: var(--fs-body-sm);
    color: var(--brun-moyen);
    max-width: 48ch;
  }
  /* Alignées à droite face au texte, recalées à gauche une fois empilées.
     Une requête de CONTENEUR, pas de fenêtre : la bascule dépend de la place
     dont dispose la bande, pas de la taille de l'écran. Aucun point de rupture
     global n'est introduit ici. */
  .actions { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: flex-end; }
  @container band (width < 56rem) {
    .actions { justify-content: flex-start; }
  }

</style>
