---
import Page from './Page.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

/**
 * La bande ne mène JAMAIS à l'adresse générale : un rendez-vous, c'est un
 * dossier, et un dossier se prend avec une avocate. Le bouton principal
 * change donc selon la page :
 *   - sur une fiche, `avocate` est passée et le bouton lui écrit ;
 *   - ailleurs, il mène à un choix d'avocates — `equipeHref` permet à une page
 *     de viser sa propre liste (la matière, ses avocates), à défaut l'équipe
 *     de l'accueil.
 */
interface Props {
  avocate?: { nom: string; email: string };
  equipeHref?: string;
}
const { avocate, equipeHref = '/#equipe' } = Astro.props;
---
<section class="contact-band">
  <Page>
    <div class="split">
      <div>
        <Eyebrow>Une question sur votre situation ?</Eyebrow>
        <h2>Les consultations ont lieu uniquement sur rendez-vous.</h2>
        <p>Le rendez-vous se prend directement avec l'avocate qui suivra votre dossier, par téléphone ou par e-mail.</p>
      </div>
      <div class="actions">
        {avocate ? (
          <Button href={`mailto:${avocate.email}`} icon="mail" iconPosition="left">Écrire à {avocate.nom}</Button>
        ) : (
          <Button href={equipeHref} icon="users" iconPosition="left">Choisir une avocate</Button>
        )}
        <Button href="/#contact" variant="secondary">Nous trouver</Button>
      </div>
    </div>
  </Page>
</section>

<style>
  .contact-band {
    container: band / inline-size;
    /* Voile de CARAMEL, et non de sauge : la sauge est désormais la couleur
       des aplats pleins (la bande des valeurs, le pied de page), et le vert
       clair ne sert plus de fond nulle part sur le site. */
    background: var(--surface-warm-soft);
    padding: var(--space-9) 0;
    margin-top: var(--space-10);
    /* L'étiquette du design system (#7A6B5A) ne tient que 4,4:1 sur ce voile —
       15px semi-gras est du texte courant, il en faut 4,5. Le brun moyen, lui,
       monte à 6,2:1 et reste dans la palette. */
    --text-label: var(--brun-moyen);
    /* Le lit du survol est le voile de caramel — la couleur même de la bande.
       « Nous trouver » s'y couchait donc sans que rien ne change : un bouton
       qui prend le fond de son conteneur n'a pas de survol. Comme sur le
       panneau des honoraires, le conteneur repose le lit : sur le voile, le
       premier cran n'est pas un caramel plus franc (l'encre n'y tiendrait pas,
       voir `tokens.css`), c'est le papier de la page qui remonte sous le
       bouton. */
    --survol-aplat: var(--surface-page);
  }
  /* Deux colonnes égales tant qu'elles tiennent, puis empilées — le point de
     bascule est donné par la mesure du texte (en ch), pas par un pixel deviné. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-9);
  }
  .split > * { flex: 1 1 26ch; }
  h2 {
    margin-top: var(--stack-tight);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
  }
  p {
    margin-top: var(--stack-tight);
    font-size: var(--fs-body-sm);
    color: var(--brun-moyen);
  }
  /* Le titre et sa ligne d'explication tombent sur la même verticale : une
     seule mesure, écrite une seule fois, en rem (voir RuledCell). */
  h2, p { max-width: 26rem; }
  /* Alignées à droite face au texte, recalées à gauche une fois empilées.
     Une requête de CONTENEUR, pas de fenêtre : la bascule dépend de la place
     dont dispose la bande, pas de la taille de l'écran. Aucun point de rupture
     global n'est introduit ici.

     Les deux boutons font la MÊME boîte : deux pistes `1fr` dans une grille
     dimensionnée au contenu (`width: fit-content`). Une piste `1fr` vaut, en
     max-content, la largeur du plus large des deux — les deux la prennent
     donc ensemble. Aucune largeur devinée n'est écrite ici : c'est le libellé
     le plus long qui décide.

     `flex: 0 0 auto` lève la base `26ch` que `.split > *` pose sur ses
     colonnes — sans quoi la paire recevait la moitié de la bande et les deux
     boutons s'y écrasaient, « Écrire au cabinet » sur deux lignes hors cadre.
     Le sélecteur est `.split > .actions` pour passer devant cette base. */
  .split > .actions {
    flex: 0 0 auto;
    margin-inline-start: auto;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    width: fit-content;
    gap: var(--space-4);
  }
  @container band (width < 56rem) {
    /* Les deux colonnes de la bande sont passées l'une sous l'autre : les
       boutons se recalent sur le bord gauche du texte. */
    .split > .actions { margin-inline-start: 0; }
  }
  /* Plus bas, les deux boutons cessent de tenir côte à côte : la paire fait
     deux fois ~13rem plus l'écart, et la bande garde ses marges de page. Ils
     passent alors l'un sous l'autre — la piste reste `1fr`, donc ils gardent
     la même largeur, empilés comme alignés. */
  @container band (width < 34rem) {
    .split > .actions { grid-auto-flow: row; }
  }

</style>
