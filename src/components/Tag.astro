---
import { withBase } from '../lib/base.js';
/**
 * LA pastille du site : matières, langues, consœurs — un seul objet, une seule
 * boîte, un seul filet. `href` en fait un lien, qui s'inverse au survol ; sans
 * lui, la pastille ne fait que nommer.
 */
interface Props { selected?: boolean; href?: string }
const { selected, href } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag href={withBase(href)} class:list={['tag', { selected }, href && 'eg-inverse']}><slot /></Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition: var(--transition-control);
  }
  /* Une pastille qui MÈNE quelque part porte l'encre vive du texte et la boîte
     d'un bouton : la hauteur du doigt, le filet à pleine force. Une pastille
     qui ne fait que nommer (les langues) n'a pas à être touchée : elle rentre
     à la taille d'une note en marge, et son filet est son encre ÉCLAIRCIE de
     moitié — le même trait que la pastille du registre (`styles/pastille.css`).
     À pleine force, dans la même boîte, elle se lisait comme un bouton. */
  a.tag { color: var(--text-body); }
  span.tag {
    min-height: 0;
    padding: var(--space-1) var(--space-3);
    border-color: color-mix(in srgb, currentColor 50%, transparent);
  }
  .tag.selected { background: var(--brun-profond); color: var(--creme); border-color: var(--brun-profond); }
</style>
