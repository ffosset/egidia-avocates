---
import { withBase } from '../../lib/base.js';
import Base from '../../layouts/Base.astro';
import Page from '../../components/Page.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import RuledGrid from '../../components/RuledGrid.astro';
import RuledList from '../../components/RuledList.astro';
import LinkList from '../../components/LinkList.astro';
import PersonCell from '../../components/PersonCell.astro';
import ContactBand from '../../components/ContactBand.astro';
import { MATIERES } from '../../data/matieres.js';
import { codesLangues, parNom } from '../../data/avocates.js';

export function getStaticPaths() {
  return MATIERES.map((m) => ({ params: { id: m.id }, props: { matiere: m } }));
}

const { matiere: m } = Astro.props;
const autres = MATIERES.filter((x) => x.id !== m.id);
---
<Base title={m.titre} description={m.resume}>
  <main>
    {/* PAS de bande de héros : la page de matière est le MIROIR de la page
        d'avocate. Là-bas, la photographie ouvre la colonne de gauche et le
        texte descend à droite ; ici l'aplat ouvre la colonne de droite et le
        texte descend à gauche. Une bande aurait imposé sa hauteur au titre et
        coupé l'aplat en deux ; ici les deux colonnes coulent. */}
    <Page>
      <div class="split">
        <div class="corps">
          <div class="fil">
            <Breadcrumb items={[
              { label: 'Accueil', href: '/' },
              { label: 'Services', href: '/#services' },
              { label: m.titre },
            ]} />
          </div>
          <h1>{m.titre}</h1>
          <p class="lead">{m.intro}</p>

          <div class="block">
            <Eyebrow>Ce que nous traitons</Eyebrow>
            <div class="spaced"><RuledList items={m.traite} /></div>
          </div>

          <div class="block far">
            <Eyebrow>Avocates spécialisées</Eyebrow>
            <div class="spaced">
              <RuledGrid min={200}>
                {m.avocates.map((nom) => {
                  const a = parNom(nom);
                  return (
                    <PersonCell
                      name={nom}
                      photo={a?.photo}
                      langues={codesLangues(a?.langues)}
                      ratio="1 / 1"
                      href={a ? `/avocates/${a.slug}` : undefined}
                    />
                  );
                })}
              </RuledGrid>
            </div>
          </div>
        </div>

        <aside>
          <div class="aplat" aria-hidden="true"></div>
          <Card padding="var(--space-6)">
            <Eyebrow>Liens utiles</Eyebrow>
            <div class="tight">
              {m.liens.length > 0 ? (
                <LinkList items={m.liens} />
              ) : (
                <p class="empty">Liens à compléter par le cabinet.</p>
              )}
            </div>
          </Card>
          <Card padding="var(--space-6)">
            <Eyebrow>Autres services</Eyebrow>
            <div class="others">
              {autres.map((x) => (
                <a href={withBase(`/services/${x.id}`)} class="eg-inverse">
                  {x.titre}<span class="eg-accent chev"><Icon name="arrow-right" size={18} /></span>
                </a>
              ))}
            </div>
          </Card>
        </aside>
      </div>
    </Page>
    <ContactBand />
  </main>
</Base>

<style>
  /* ---- L'APLAT ----
     L'arc du bouclier, exactement celui du portrait de la page d'avocate
     (`sweep: 78% 58%`), retourné : il ouvre la colonne de DROITE, donc son arc
     tombe en bas à GAUCHE. Une seule différence, et elle est de nature : ce
     n'est pas une photographie mais une couleur pleine — et la loi des marges
     ne laisse franchir les filets qu'à la photographie. L'aplat s'arrête donc
     PILE sur le filet : son débord latéral vaut UNE GOUTTIÈRE, exactement ce
     qui sépare le contenu du filet (--content-inset = --page-margin + --gutter).
     À droite il vient donc mourir sur le filet ; à gauche, une fois les colonnes
     empilées, il meurt sur l'autre. Il ne peut pas les franchir.

     Les cartes flottent sur lui au lieu de le remplir.

     Sa hauteur est celle du portrait, mais bornée par la colonne : sur une
     matière sans liens l'aside est court, et un aplat de 78vh pendrait dans le
     vide sous la dernière carte. `min()` le fait épouser le plus petit des
     deux. */
  aside {
    --debord: var(--space-6);
    position: relative;
    /* Le débord du HAUT est un padding, pas un décalage négatif : l'aplat part
       du bord supérieur de la colonne — donc de l'en-tête — et ce sont les
       cartes qui descendent. Un `top` négatif aurait glissé l'aplat SOUS
       l'en-tête, qui l'aurait mangé. */
    padding-top: var(--debord);
  }
  .aplat {
    position: absolute;
    z-index: -1;
    top: 0;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    height: min(clamp(440px, 78vh, 820px), calc(100% + var(--debord)));
    /* Le sauge obscur, pas le brun : c'est la couleur que le site donne à ses
       grandes surfaces pleines — le pied de page en est une. En brun, l'aplat
       reprenait l'encre du texte agrandie à la taille d'une colonne, et les
       cartes posées dessus se lisaient comme un trou dans un paragraphe. */
    background: var(--sauge-obscur);
    border-bottom-left-radius: 78% 58%;
  }
  /* Une fois les colonnes empilées, l'aplat n'est plus une colonne debout : il
     épouse simplement la pile de cartes, et garde son arc. */
  @media (--lap) {
    .aplat { height: calc(100% + var(--debord)); }
  }

  /* Le fil d'Ariane n'est pas l'étiquette du titre (ce serait --stack-bind) :
     c'est un bloc distinct qui le précède. */
  .fil { margin-bottom: var(--stack); }

  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: 1.12;
  }
  .lead {
    margin-top: var(--stack-tight);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--brun-moyen);
  }
  /* Le titre et son chapô cassent sur la même verticale (voir RuledCell). */
  h1, .lead { max-width: 33rem; }

  /* Deux colonnes proportionnelles tant qu'elles tiennent, puis empilées.
     `flex-wrap` fait deux choses qu'une grille à points de rupture ne fait pas :
     l'asymétrie se DÉTEND vers l'égalité à mesure que la place manque, puis le
     bloc passe dessous. La bascule est décidée par la mesure du texte (en ch),
     pas par un pixel deviné — donc pas de @media.

     Pas de `min-width: 0` sur les colonnes : ce serait les autoriser à devenir
     plus étroites que leur propre contenu, et les cartes déborderaient au lieu
     de passer à la ligne. Le `min-width: auto` par défaut est ce qui déclenche
     le retour à la ligne au bon moment. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-9);
    padding: 0 0 var(--section-y);
  }
  /* L'aplat touche l'en-tête ; seul le TEXTE descend.

     La colonne de droite ne porte que des cartes de liens : rien qui demande de
     la largeur, et la colonne de texte en manquait. Les bases en `ch` montent
     avec la découpe — c'est leur SOMME qui décide du moment où le bloc passe
     dessous, et la relever fait empiler une centaine de pixels plus tôt : une
     colonne de 30ch de liens qu'on écrase n'a plus d'intérêt à rester debout. */
  .split > .corps { flex: 8 1 38ch; padding-top: var(--section-y); }
  .split > aside  { flex: 4 1 30ch; }
  @media (--lap) {
    .split > .corps { padding-top: var(--section-y-sm); }
  }

  aside { display: grid; gap: var(--space-5); align-content: start; }
  .block { margin-top: var(--stack-loose); }
  .spaced { margin-top: var(--space-5); }
  /* Le registre des avocates n'ouvre pas une section colorée : il est posé au
     milieu d'une colonne de texte, sur la page. Sans cette valeur il retomberait
     sur son blanc-papier par défaut et poserait un bloc clair derrière les
     portraits, là où seuls les filets doivent se voir. */
  .far { margin-top: var(--space-9); --section-surface: var(--surface-page); }
  .tight { margin-top: var(--stack-tight); }
  .empty { margin: 0; font-size: 16px; color: var(--text-label); }

  .others { margin-top: var(--space-3); }
  .others a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    margin: 0 calc(-1 * var(--space-4));
    border-top: var(--divider);
    font-size: var(--fs-body-sm);
    text-decoration: none;
    color: var(--text-body);
  }
  .chev { color: var(--sauge-obscur); }

</style>
