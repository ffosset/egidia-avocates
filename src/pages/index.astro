---
import { withBase } from '../lib/base.js';
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Band from '../components/Band.astro';
import ArcImage from '../components/ArcImage.astro';
import ArcPanel from '../components/ArcPanel.astro';
import RuledGrid from '../components/RuledGrid.astro';
import RuledCell from '../components/RuledCell.astro';
import PersonCell from '../components/PersonCell.astro';
import MapEmbed from '../components/MapEmbed.astro';
import LinkList from '../components/LinkList.astro';
import { MATIERES } from '../data/matieres.js';
import { AVOCATES, languesCourtes } from '../data/avocates.js';
import { CONTACT, PHOTOS, ALT, LIENS_ACCUEIL } from '../data/site.js';
---
<Base title="Egidia">
  <main>
    {/* 1 — HERO : la photo occupe le cadre, le panneau de papier la recouvre,
        l'arc du bouclier balaie son bord de fuite. */}
    <section class="hero">
      {/* La photo ne prend que la partie droite : les sept avocates doivent
          toutes rester visibles à côté du panneau. */}
      <div class="hero-photo">
        <ArcImage
          src={PHOTOS.equipe}
          alt={ALT.equipe}
          corner="none"
          objectPosition="50% 58%"
          loading="eager"
        />
      </div>
      {/* Balayage pleine hauteur, mais long et doux : le défaut du design
          system (« 40% 100% ») creuse trop et mange la photo. Le rayon
          horizontal est réduit — la courbe file du haut vers le bas sans
          amputer l'image. Écart assumé par rapport au défaut. */}
      <ArcPanel width="var(--hero-split)" sweep="15% 100%">
        <div class="hero-inner pile">
          <h1>Chaque personne a droit à être écoutée, conseillée et défendue</h1>
          <p>
            Egidia est un cabinet bruxellois en droit des étrangers, de la famille, de l'aide
            sociale et de la jeunesse. Une relation fondée sur l'écoute et la transparence.
          </p>
          <div class="cta pile-block"><Button href="#matieres" variant="secondary">Voir nos domaines</Button></div>
        </div>
      </ArcPanel>
    </section>

    {/* 2 — VALEURS */}
    <Band tone="sage" id="valeurs">
      <h2 class="band-title">Une justice claire et humaine</h2>
      <div class="band-copy pile">
        <p>
          Derrière chaque dossier, il y a une personne et une histoire. Nous prenons le temps de
          comprendre la vôtre avant de vous conseiller. Nous expliquons chaque étape pour vous
          aider à y voir plus clair dans votre situation, comprendre les enjeux et les choix qui
          s'offrent à vous.
        </p>
        <p>
          Une procédure est souvent une épreuve. Nous vous accompagnons pour la traverser ensemble.
          Nous travaillons en lien étroit avec le réseau associatif bruxellois, pour que
          l'accompagnement ne s'arrête pas à la porte du tribunal.
        </p>
      </div>
    </Band>

    {/* 3 — MATIÈRES : le filet gauche du registre tombe sur le filet de marge ;
        seule la photographie franchit le filet de droite. */}
    <section id="matieres" class="matieres">
      <RuledGrid columns="minmax(0, 1fr) minmax(0, 1fr) var(--photo-track)" noTop>
        <RuledCell align="center">
          <h2 class="grid-title">Services offerts par le cabinet</h2>
        </RuledCell>
        {MATIERES.map((m, i) => {
          const n = i + 1;
          const col = n % 2 === 0 ? 1 : 2;
          return (
            <RuledCell
              title={m.titre}
              lead={m.resume}
              href={`/matieres/${m.id}`}
              style={`grid-column:${col};grid-row:${Math.floor(n / 2) + 1}`}
            >
              <span class="count eg-accent pile-foot">
                <span>{m.nb} avocates</span><Icon name="arrow-right" size={18} />
              </span>
            </RuledCell>
          );
        })}
        <div class="matiere-photo lap-span">
          <ArcImage src={PHOTOS.ambiance} alt={ALT.ambiance} corner="none" />
        </div>
      </RuledGrid>
    </section>

    {/* 4 — ÉQUIPE */}
    <section id="equipe" class="ruled-section">
      <RuledGrid min={380} noTop>
        <RuledCell align="center" minHeight={280}>
          <Eyebrow>Équipe</Eyebrow>
          <h2 class="big">Nos avocates</h2>
        </RuledCell>
        <RuledCell align="center" minHeight={280}>
          <p class="statement eg-title">Sept avocates. Cinq services. Une seule interlocutrice pour votre dossier.</p>
          <p class="sub">
            Celle que vous rencontrez est celle qui plaide. Cliquez sur un nom pour lire son
            parcours, ses publications, et la contacter directement.
          </p>
        </RuledCell>
      </RuledGrid>
      {/* 240px de cellule minimale, 4 colonnes au plus : la grille descend
          d'elle-même 4 → 3 → 2 → 1, là où les portraits cessent de tenir. */}
      <RuledGrid min={240} maxCols={4} noTop>
        {AVOCATES.map((a) => (
          <PersonCell
            name={a.nom}
            photo={a.photo}
            meta={languesCourtes(a.langues)}
            href={`/avocates/${a.slug}`}
          />
        ))}
        {/* La rangée ne tombe pas juste : on comble avec une vraie phrase, jamais un vide. */}
        <RuledCell align="center" minHeight={200}>
          <p class="filler eg-title">Toutes travaillent dans le cadre de l'aide juridique.</p>
          <a href={withBase("/aide-juridique")} class="filler-link eg-accent">
            Documents à apporter <Icon name="arrow-right" size={20} />
          </a>
        </RuledCell>
      </RuledGrid>
    </section>

    {/* 5 — HONORAIRES : plus de registre ici. Deux blocs posés sur la couleur
        de la section — le propos à gauche, l'aide juridique en panneau plein à
        droite. Ils se replient d'eux-mêmes sur une colonne, sans point de
        rupture (voir `.hono-grid`). */}
    <section id="honoraires" class="hono">
      <Page>
        <div class="hono-grid">
          <div class="pile hono-propos">
            <Eyebrow>Honoraires</Eyebrow>
            <h2 class="hono-titre">Combien ça coûte ?</h2>
            <p class="body">
              Nos honoraires varient selon la nature de l'affaire, sa complexité et votre
              situation. Nous les fixons avec modération et nous vous les expliquons clairement.
            </p>
            <p class="body hono-note">
              Pour comprendre comment se calculent les honoraires d'un avocat en Belgique :
              <a href="https://avocats.be/fr/tout-savoir/combien-ca-coute" rel="noopener">combien coûte un avocat ?</a>
            </p>
          </div>
          {/* Le panneau porte sa propre couleur : c'est le seul aplat sombre de
              la section, et il tient sa hauteur de son contenu — jamais de la
              colonne d'à côté (d'où `align-items: start` sur la grille). */}
          <aside class="pile hono-panneau">
            <h2 class="panneau-titre">Aide juridique</h2>
            <p class="body">
              L'aide juridique permet d'être défendu par un avocat lorsque vos ressources ne vous
              permettent pas d'en payer un. Selon vos revenus, elle est entièrement ou
              partiellement gratuite.
            </p>
            <p class="body">
              Toutes les avocates du cabinet Egidia travaillent dans le cadre de l'aide juridique.
              Nous vérifions avec vous si vous remplissez les conditions et nous vous aidons à
              constituer votre demande.
            </p>
            <div class="pile-block">
              <Button href="/aide-juridique" variant="secondary" size="md">Faire la demande</Button>
            </div>
          </aside>
        </div>
      </Page>
    </section>

    {/* 6 — LIENS UTILES */}
    <section id="liens" class="liens">
      <Page>
        <div class="pile">
          <SectionHead eyebrow="Liens utiles" title="Ressources externes" />
          <div class="link-cols pile-block">
            {LIENS_ACCUEIL.map(([titre, liens]) => (
              <div class="pile">
                <h3>{titre}</h3>
                <LinkList items={liens} />
              </div>
            ))}
          </div>
        </div>
      </Page>
    </section>

    {/* 7 — CONTACT ET ACCÈS : registre à trois colonnes, la carte occupe deux */}
    <section id="contact" class="ruled-section">
      {/* La carte occupe deux colonnes : à 3 colonnes elle ferme la rangée,
          à 2 elle en fait une pleine, à 1 elle se réduit — aucune case vide. */}
      {/* UNE mesure pour les quatre cellules, et c'est celle de la carte
          (`MapEmbed` pose 320px) : le registre entier tient donc sur un seul
          plancher, et la rangée du bas ne peut plus être plus haute que celle
          du haut. Aucune ne porte `align` : les quatre partent du HAUT, comme
          les trois titres qu'elles portent. Le centrage n'avait de sens que
          tant qu'un lien était posé au pied de la cellule. */}
      <RuledGrid min={320} maxCols={3} noTop>
        <RuledCell minHeight={320}>
          <Eyebrow>Contact et accès</Eyebrow>
          <h2 class="cell-lead">Les consultations ont lieu uniquement sur rendez-vous</h2>
        </RuledCell>

        <RuledCell minHeight={320}>
          <h3 class="cell-h3">Nous joindre</h3>
          <div class="lines">
            <span class="line">
              <span class="ico"><Icon name="mail" size={18} /></span>
              <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            </span>
            <span class="line muted-line">
              <span class="ico"><Icon name="phone" size={18} /></span>
              Ligne directe de chaque avocate : voir sa fiche.
            </span>
          </div>
        </RuledCell>

        <RuledCell minHeight={320}>
          <h3 class="cell-h3">Nous trouver</h3>
          <div class="lines">
            <span class="line">
              <span class="ico"><Icon name="map-pin" size={18} /></span>
              {CONTACT.adresse}
            </span>
            <span class="line muted-line">
              <span class="ico"><Icon name="accessibility" size={18} /></span>
              {CONTACT.acces}
            </span>
          </div>
        </RuledCell>

        <RuledCell minHeight={320}>
          <h3 class="cell-h3">En transports en commun</h3>
          <div class="lines">
            <span class="line">
              <span class="ico"><Icon name="train-front-tunnel" size={18} /></span>
              {CONTACT.metro}
            </span>
            <span class="line">
              <span class="ico"><Icon name="tram-front" size={18} /></span>
              {CONTACT.tram}
            </span>
          </div>
        </RuledCell>

        <div class="map-cell">
          <MapEmbed lat={CONTACT.coords[0]} lon={CONTACT.coords[1]} zoom={16} label={CONTACT.adresse} />
        </div>
      </RuledGrid>
    </section>
  </main>
</Base>

<style>
  /* ---- 1. HÉRO ---- */
  /* Pas de filet sous le héros : la bande sauge enchaîne directement.
     (Le design system en pose un — écart assumé.) */
  .hero {
    /* UNE seule source pour la coupe : --hero-split, la couture, définie dans
       `styles/tokens.css`. Le panneau la prend pour largeur, la photo commence
       à 76 % de cette valeur (le rapport 38/50 d'avant), et l'en-tête y pose le
       premier filet de sa navigation. Les trois ne peuvent plus dériver. */
    position: relative;
    /* Le panneau revient dans le FLUX (voir plus bas) : c'est lui qui donne sa
       hauteur au héros, donc le padding du texte respire vraiment au lieu
       d'être avalé par une hauteur fixe. Le clamp n'est plus qu'un plancher. */
    display: grid;
    min-height: clamp(520px, 62vh, 720px);
    overflow: hidden;
  }
  /* Écart assumé au composant : `ArcPanel` se pose en absolu par défaut. Ici il
     est la seule chose en flux — la photo, elle, reste absolue et remplit le
     cadre — pour que la hauteur du héros suive son contenu. */
  .hero :global(.arc-panel) { position: relative; }
  /* Fond brun + fusion « overlay » : la photographie se réchauffe et se pose
     dans les tons du cabinet au lieu de trancher avec le papier.
     `isolation` garde la fusion à l'intérieur du cadre. */
  .hero-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: calc(var(--hero-split) * 0.76);
    background-color: #6b5238;
    isolation: isolate;
  }
  .hero-photo :global(img) {
    mix-blend-mode: overlay;
    /* Un peu d'exposition, puis un zoom ancré au bord GAUCHE À MI-HAUTEUR :
       le groupe se pose au centre du cadre — le panneau lui mangeait sa moitié
       gauche et laissait un mur vide à droite quand l'ancre était en haut à
       droite. Le mur part à la coupe, la grande roue reste. */
    filter: brightness(1.09);
    transform: scale(1.18);
    transform-origin: 5% 90%;
  }
  .hero-inner {
    /* UNE mesure pour les deux blocs de texte : le titre et le chapô partagent
       exactement la même colonne. En `ch`, ils ne l'auraient pas — le `ch` du
       titre d'affichage et celui du texte courant n'ont pas la même valeur. */
    --hero-measure: clamp(320px, 36vw, 520px);
    /* Le texte se décolle du filet de marge : un cran de plus que
       --content-inset, et le pas de section (et non le petit) en vertical. */
    padding-left: calc(var(--content-inset) + var(--cell-pad));
    padding-right: var(--space-8);
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 3.6vw, 56px);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--text-heading);
    max-width: var(--hero-measure);
  }
  .hero p {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--brun-moyen);
    max-width: var(--hero-measure);
  }
  /* .cta porte `pile-block` : l'écart est nommé par la pile, pas écrit ici. */

  /* ---- 2. VALEURS ---- */
  /* Le titre de la bande tient sur UNE ligne, toujours : c'est une phrase, et
     une phrase cassée en deux cesse d'être lue d'un trait. `nowrap` scelle la
     ligne ; la taille garantit qu'elle rentre, donc rien ne déborde.

     La ligne mesure 13,3em en Playfair — mais 15em en Georgia, l'empattement
     de secours le plus large de la pile, qui s'affiche pendant le `swap` de la
     webfont. On divise donc par 15 : tant que la fenêtre offre cette largeur
     entre ses filets, le titre garde ses 40px ; en dessous il rétrécit avec
     elle au lieu de casser. Le plancher de 28px disparaît — une phrase de
     29 signes ne tient pas à 28px sur un téléphone, il fallait choisir. */
  .band-title {
    font-family: var(--font-display);
    font-size: min(40px, (100vw - 2 * var(--content-inset)) / 15);
    white-space: nowrap;
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--text-on-accent);
  }
  /* Le titre de la bande et sa copie cassent sur la même verticale : une seule
     mesure pour les deux (voir RuledCell). `margin-inline` et non `margin` :
     le pas vertical appartient à la pile.

     Cette mesure est celle du TITRE : sa ligne fait 532px à 40px, et 34rem la
     loge sans la serrer. La copie y gagne ~68 signes par ligne, ce qui reste
     dans la fourchette de lecture. */
  .band-title, .band-copy { max-width: 34rem; margin-inline: auto; }
  .band-copy p {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
  }

  /* ---- Sections en registre : le filet du registre tombe sur le filet de marge ---- */
  /* Composition dessinée à la main (placement en zigzag + photo sur trois
     rangées) : elle garde le point de rupture unique. Seule la piste photo
     devient fluide, pour qu'elle ne mange plus la moitié d'un portable. */
  .matieres {
    --photo-track: clamp(300px, 26vw, 420px);
    /* Sous --lap la photo passe en bas, et les matières gardent DEUX colonnes
       tant qu'une cellule tient dans 300px — puis une seule. Le registre ne
       tombe donc jamais de trois pistes à une seule d'un coup. */
    --lap-min: 300px;
    --lap-max: 2;
    padding-left: var(--page-margin);
  }
  .ruled-section { padding: 0 var(--page-margin); border-top: var(--divider); container: registre / inline-size; }

  /* ---- Une section, une couleur ----
     La section est pleine largeur : lui poser un fond peint AUSSI la gouttière,
     de part et d'autre du registre. Le registre, lui, reprend la même valeur par
     `--section-surface` (voir RuledGrid). Une seule valeur par section, donc
     aucune dérive possible entre l'intérieur du registre et la bande de marge. */
  .matieres, .ruled-section, .hono, .liens { background: var(--section-surface); }

  #matieres   { --section-surface: var(--surface-services); }
  #equipe     { --section-surface: var(--surface-equipe); }
  #honoraires { --section-surface: var(--surface-honoraires); }
  #liens      { --section-surface: var(--surface-liens); }
  #contact    { --section-surface: var(--surface-contact); }

  .grid-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.15;
    max-width: 12ch;
  }
  .count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: var(--fw-semibold);
    color: var(--sauge-obscur);
  }
  .matiere-photo { grid-column: 3; grid-row: 1 / span 3; border-bottom: var(--divider); }

  /* ---- 4. HONORAIRES ----
     La section a quitté le registre : ni filets, ni cellules. Deux blocs sur la
     couleur de la section, séparés par de l'air. La grille se replie SEULE —
     `auto-fit` sur une piste de 400px minimum — donc pas de point de rupture de
     plus à tenir : dès que deux colonnes ne tiennent plus, il n'y en a qu'une. */
  .hono { padding: var(--section-y) 0; border-top: var(--divider); }
  /* Le titre, le texte et le renvoi cassent tous sur la même verticale : la
     mesure est portée par la colonne, une seule fois (voir RuledCell). */
  .hono-propos { max-width: 30rem; }
  .hono-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: var(--space-8);
    /* Le panneau tient sa hauteur de son texte, pas de la colonne d'à côté. */
    align-items: start;
  }
  /* Le seul titre de l'accueil qui parle au lecteur à la première personne :
     il est plus grand que les titres de cellule, il n'en est pas un. */
  .hono-titre {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 68px);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    letter-spacing: var(--ls-display);
  }
  /* Le renvoi vers avocats.be : c'est une seconde voix, pas une note de bas de
     page — elle est en gras, et le lien porte son soulignement. */
  .hono-note { font-weight: var(--fw-semibold); }
  .hono-note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hono-note a:hover { color: var(--text-link); }

  /* Le panneau : le seul aplat sombre de la section. Le bouton secondaire s'y
     retourne par les tokens qu'il lit déjà (cadre crème, inversion en crème
     pleine) — aucune règle ne va chercher l'intérieur du composant. */
  .hono-panneau {
    background: var(--sauge-obscur);
    color: var(--text-on-dark);
    padding: var(--cell-pad);
    --btn-secondary-fg: var(--creme);
    --btn-secondary-border: var(--creme);
    --hover-invert-bg: var(--creme);
    --hover-invert-fg: var(--sauge-obscur);
  }
  .panneau-titre {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    color: var(--creme);
  }
  /* Dans le panneau, la mesure est déjà donnée par la colonne. */
  .hono-panneau .body { max-width: none; }

  .body { font-size: var(--fs-body); line-height: 1.6; }

  /* ---- 5. ÉQUIPE ---- */
  .big {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 84px);
    font-weight: var(--fw-bold);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  /* `.statement` et `.filler` sont des <p> qui tiennent le rôle d'un titre :
     `eg-title` leur donne l'œil du display ET le pas qui va avec (voir pile.css).
     Il ne reste ici que ce qui leur est propre — la taille et la mesure. */
  /* Dans une cellule du registre, la mesure appartient à la cellule : la
     déclaration et le texte qui la suit cassent sur la même verticale. */
  .statement, .sub { max-width: var(--cell-measure); }
  .statement { font-size: clamp(24px, 2.2vw, 32px); line-height: 1.25; }
  .filler { font-size: 26px; line-height: 1.3; max-width: 16ch; }
  .filler-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-semibold);
    color: var(--sauge-obscur);
    text-decoration: none;
  }

  /* ---- 6. LIENS UTILES ---- */
  .liens { padding: var(--section-y) 0; border-top: var(--divider); }
  .link-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-9);
  }
  .link-cols h3 {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    color: var(--type-subtitle-color);
  }

  /* ---- 7. CONTACT ---- */
  .cell-lead {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.18;
    max-width: 16ch;
  }
  .cell-h3 {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    color: var(--type-subtitle-color);
  }
  /* Même carré que sur les noms de matières — il remplace l'icône enveloppe
     qui ouvrait « Nous joindre » : les trois cellules du registre s'ouvrent
     maintenant du même geste, et non deux d'un côté et une de l'autre. */
  .cell-h3::before {
    content: '';
    display: inline-block;
    width: var(--type-subtitle-mark);
    height: var(--type-subtitle-mark);
    margin-right: var(--type-subtitle-mark-gap);
    background: currentColor;
  }
  /* Même règle que dans le registre des matières : le nom de la cellule et les
     lignes qui le suivent partagent la mesure de la cellule. */
  .cell-h3, .lines { max-width: var(--cell-measure); }
  .lines { display: grid; gap: var(--stack-bind); font-size: var(--fs-body-sm); line-height: 1.5; }
