---
import { withBase } from '../lib/base.js';
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Band from '../components/Band.astro';
import ArcImage from '../components/ArcImage.astro';
import ArcPanel from '../components/ArcPanel.astro';
import RuledGrid from '../components/RuledGrid.astro';
import RuledCell from '../components/RuledCell.astro';
import PersonCell from '../components/PersonCell.astro';
import MapEmbed from '../components/MapEmbed.astro';
import LinkList from '../components/LinkList.astro';
import { MATIERES } from '../data/matieres.js';
import { AVOCATES, codesLangues } from '../data/avocates.js';
import { CONTACT, PHOTOS, ALT, LIENS_ACCUEIL } from '../data/site.js';
---
<Base title="Egidia">
  <main>
    {/* 1 — HERO : la photo occupe le cadre, le panneau de papier la recouvre,
        l'arc du bouclier balaie son bord de fuite. */}
    <section class="hero">
      {/* La photo ne prend que la partie droite : les sept avocates doivent
          toutes rester visibles à côté du panneau. */}
      <div class="hero-photo">
        <ArcImage
          src={PHOTOS.equipe}
          alt={ALT.equipe}
          corner="none"
          objectPosition="50% 100%"
          loading="eager"
        />
      </div>
      {/* LE FLANC DU BOUCLIER, d'un seul côté. Le bouclier du système garde
          ses flancs DROITS sur le haut et ne tourne qu'en bas (`.c-shield`
          dans `ArcImage` : « 0 0 46% 46% / 0 0 34% 34% »). Le panneau n'en
          reprend qu'un flanc, celui de fuite, et la même loi.

          Deux rayons, deux rôles :

          - 50 % en vertical — le bord tient la verticale de la couture sur
            toute la moitié HAUTE, à hauteur du regard, là où l'alignement sur
            le premier filet de la navigation se lit ; il ne s'en écarte que
            dans la moitié basse. C'est tout ce que le « 100% » d'avant (et le
            « 40% 100% » du design system) manquaient : un arc étiré sur toute
            la hauteur part de biais dès le premier pixel et n'énonce jamais le
            filet sur lequel il s'aligne.
          - 13 % en horizontal — la fuite reste ÉTROITE. Ce rapport de 1 à 4
            fait un long fléchissement, pas un quart de rond : le coin ne doit
            pas s'arrondir, il doit s'incliner. Il retombe à 87 % de la
            couture, bien en deçà du bord gauche de la photographie (76 %) —
            le cadrage du groupe n'a donc pas à bouger d'un pixel.

          Écart assumé par rapport au défaut du composant. */}
      <ArcPanel width="var(--hero-split)" sweep="13% 50%">
        <div class="hero-inner pile">
          <h1>Chaque personne a droit à être écoutée, conseillée et défendue</h1>
          <p>
            Egidia est un cabinet bruxellois en droit des étrangers, de la famille, de l'aide
            sociale et de la jeunesse. Une relation fondée sur l'écoute et la transparence.
          </p>
          <div class="cta"><Button href="#services" variant="secondary">Voir nos domaines</Button></div>
        </div>
      </ArcPanel>
    </section>

    {/* 2 — VALEURS */}
    <Band tone="sage" id="valeurs">
      <h2 class="band-title">Une justice claire et humaine</h2>
      <div class="band-copy pile">
        <p>
          Derrière chaque dossier, il y a une personne et une histoire. Nous prenons le temps de
          comprendre la vôtre avant de vous conseiller. Nous expliquons chaque étape pour vous
          aider à y voir plus clair dans votre situation, comprendre les enjeux et les choix qui
          s'offrent à vous.
        </p>
        <p>
          Une procédure est souvent une épreuve. Nous vous accompagnons pour la traverser ensemble.
          Nous travaillons en lien étroit avec le réseau associatif bruxellois, pour que
          l'accompagnement ne s'arrête pas à la porte du tribunal.
        </p>
      </div>
    </Band>

    {/* 3 — MATIÈRES : le filet gauche du registre tombe sur le filet de marge ;
        seule la photographie franchit le filet de droite. */}
    <section id="services" class="matieres">
      <RuledGrid columns="minmax(0, 1fr) minmax(0, 1fr) var(--photo-track)" noTop>
        <RuledCell align="center">
          <Eyebrow>Services</Eyebrow>
          <h2 class="grid-title">Nos matières préférentielles</h2>
        </RuledCell>
        {MATIERES.map((m, i) => {
          const n = i + 1;
          const col = n % 2 === 0 ? 1 : 2;
          return (
            <RuledCell
              title={m.titre}
              lead={m.resume}
              href={`/services/${m.id}`}
              style={`grid-column:${col};grid-row:${Math.floor(n / 2) + 1}`}
            >
              <span class="count pile-foot"><span class="eg-pastille">{m.nb} avocates</span></span>
            </RuledCell>
          );
        })}
        <div class="matiere-photo lap-span">
          <ArcImage src={PHOTOS.ambiance} alt={ALT.ambiance} corner="none" />
        </div>
      </RuledGrid>
    </section>

    {/* 4 — ÉQUIPE */}
    <section id="equipe" class="ruled-section">
      <RuledGrid min={380} noTop>
        <RuledCell align="center" minHeight={280}>
          <Eyebrow>Équipe</Eyebrow>
          <h2 class="big">Nos avocates</h2>
        </RuledCell>
        <RuledCell align="center" minHeight={280}>
          <p class="sub">
            Une seule interlocutrice pour votre dossier : celle que vous rencontrez est celle
            qui plaide. Cliquez sur un nom pour lire son parcours, ses publications, et la
            contacter directement.
          </p>
        </RuledCell>
      </RuledGrid>
      {/* 240px de cellule minimale, 4 colonnes au plus : la grille descend
          d'elle-même 4 → 3 → 2 → 1, là où les portraits cessent de tenir. */}
      <RuledGrid min={240} maxCols={4} noTop>
        {AVOCATES.map((a) => (
          <PersonCell
            name={a.nom}
            photo={a.photo}
            langues={codesLangues(a.langues)}
            href={`/avocates/${a.slug}`}
          />
        ))}
        {/* La rangée ne tombe pas juste : on comble avec une vraie phrase, jamais un vide. */}
        <RuledCell align="center" minHeight={200}>
          <p class="filler eg-title">Toutes travaillent dans le cadre de l'aide juridique.</p>
          <div class="pile-block">
            <Button href="/aide-juridique" variant="secondary">Faire la demande</Button>
          </div>
        </RuledCell>
      </RuledGrid>
    </section>

    {/* 5 — HONORAIRES : plus de registre ici. Deux blocs posés sur la couleur
        de la section — le propos à gauche, l'aide juridique en panneau plein à
        droite. Ils se replient d'eux-mêmes sur une colonne, sans point de
        rupture (voir `.hono-grid`). */}
    <section id="honoraires" class="hono">
      <Page>
        <div class="hono-grid">
          <div class="pile hono-propos">
            <Eyebrow>Honoraires</Eyebrow>
            <h2 class="hono-titre">Combien ça coûte ?</h2>
            <p class="body">
              Nos honoraires varient selon la nature de l'affaire, sa complexité et votre
              situation. Nous les fixons avec modération et nous vous les expliquons clairement.
            </p>
            <p class="body hono-note">
              Pour comprendre comment se calculent les honoraires d'un avocat en Belgique :
              <a href="https://avocats.be/fr/tout-savoir/combien-ca-coute" target="_blank" rel="noopener">combien coûte un avocat ?</a>
            </p>
          </div>
          {/* Le panneau porte sa propre couleur : c'est le seul aplat sombre de
              la section, et il tient sa hauteur de son contenu — jamais de la
              colonne d'à côté (d'où `align-items: start` sur la grille). */}
          <aside class="pile hono-panneau">
            <h2 class="panneau-titre">Aide juridique</h2>
            <p class="body">
              L'aide juridique permet d'être défendu par un avocat lorsque vos ressources ne vous
              permettent pas d'en payer un. Selon vos revenus, elle est entièrement ou
              partiellement gratuite.
            </p>
            <p class="body">
              Toutes les avocates du cabinet Egidia travaillent dans le cadre de l'aide juridique.
              Nous vérifions avec vous si vous remplissez les conditions et nous vous aidons à
              constituer votre demande.
            </p>
            <div class="pile-block">
              <Button href="/aide-juridique" variant="secondary">Faire la demande</Button>
            </div>
          </aside>
        </div>
      </Page>
    </section>

    {/* 6 — LIENS UTILES : la boîte ne prend que ce qui se lit comme une
        table. Le nom de la section et le nom de chaque groupe restent sur le
        papier, au-dessus du registre ; seules les LIGNES de liens sont mises
        en cellules — c'est là qu'un filet sert à quelque chose, puisqu'il
        sépare deux entrées.

        Le tout tient dans UN SEUL registre à deux colonnes, et c'est le point :
        les noms de groupes forment la première rangée, les listes la seconde,
        et les deux tombent donc forcément sur les mêmes verticales. Deux
        grilles côte à côte auraient dérivé d'un pixel — celui du filet gauche
        du registre.

        La rangée des noms ne porte aucun filet : ni au-dessus (`noTop`), ni
        entre les deux colonnes (voir `.groupe-nom`). Le premier trait de la
        table est celui de la première ligne de liens.

        Un groupe écrit donc ses DEUX enfants à la suite — son nom, puis sa
        liste — et les place à la main dans le registre. C'est ce que le repli
        exige : sous --lap le mode composé rend les cellules au flux, et
        l'ordre du DOM est alors le seul à décider. Écrits rangée par rangée,
        les deux noms se seraient retrouvés collés l'un à l'autre, loin des
        listes qu'ils ouvrent. */}
    <section id="liens" class="liens pile">
      <div class="liens-head pile">
        <Eyebrow>Liens utiles</Eyebrow>
        <h2 class="big">Ressources externes</h2>
      </div>
      <RuledGrid columns="repeat(2, minmax(0, 1fr))" noTop class="pile-block">
        {LIENS_ACCUEIL.map(([titre, liens], i) => (
          <>
            <h3 class="cell-h3 groupe-nom" style={`grid-column:${i + 1};grid-row:1`}>{titre}</h3>
            <div class="groupe-liens" style={`grid-column:${i + 1};grid-row:2`}>
              <LinkList items={liens} />
            </div>
          </>
        ))}
      </RuledGrid>
    </section>

    {/* 7 — CONTACT : registre à trois colonnes, la carte occupe deux */}
    <section id="contact" class="ruled-section">
      {/* La carte occupe deux colonnes : à 3 colonnes elle ferme la rangée,
          à 2 elle en fait une pleine, à 1 elle se réduit — aucune case vide. */}
      {/* UNE mesure pour les quatre cellules, et c'est celle de la carte
          (`MapEmbed` pose 320px) : le registre entier tient donc sur un seul
          plancher, et la rangée du bas ne peut plus être plus haute que celle
          du haut. Aucune ne porte `align` : les quatre partent du HAUT, comme
          les trois titres qu'elles portent. Le centrage n'avait de sens que
          tant qu'un lien était posé au pied de la cellule. */}
      <RuledGrid min={320} maxCols={3} noTop>
        <RuledCell minHeight={320}>
          <Eyebrow>Contact</Eyebrow>
          <h2 class="cell-lead">Les consultations ont lieu uniquement sur rendez-vous</h2>
        </RuledCell>

        <RuledCell minHeight={320}>
          <h3 class="cell-h3">Nous joindre</h3>
          <div class="lines">
            <span class="line">
              <span class="ico"><Icon name="mail" size={18} /></span>
              <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            </span>
            <span class="line muted-line">
              <span class="ico"><Icon name="phone" size={18} /></span>
              Ligne directe de chaque avocate : voir sa fiche.
            </span>
          </div>
        </RuledCell>

        <RuledCell minHeight={320}>
          <h3 class="cell-h3">Nous trouver</h3>
          <div class="lines">
            <span class="line">
              <span class="ico"><Icon name="map-pin" size={18} /></span>
              {CONTACT.adresse}
            </span>
            <span class="line muted-line">
              <span class="ico"><Icon name="accessibility" size={18} /></span>
              {CONTACT.acces}
            </span>
          </div>
        </RuledCell>

        <RuledCell minHeight={320}>
          <h3 class="cell-h3">En transports en commun</h3>
          {/* Les trois arrêts se lisent comme un tableau à deux colonnes : le
              nom, puis la marche, celle-ci alignée à DROITE. Les distances se
              comparent alors d'un coup d'œil vertical, ce qu'une distance
              collée au bout de chaque nom, à une abscisse différente à chaque
              ligne, ne permet jamais. */}
          <div class="lines">
            {CONTACT.transports.map((arret) => (
              <span class="line">
                <span class="ico"><Icon name={arret.icone} size={18} /></span>
                <span class="arret-nom">{arret.nom}</span>
                <span class="arret-marche">{arret.marche}</span>
              </span>
            ))}
          </div>
          {/* Le bouton clôt la cellule : on lit d'abord les arrêts, on ne part
              chercher un itinéraire qu'ensuite. `secondary` — le cadre nu — car
              cette cellule n'est pas l'appel du site : l'appel, c'est écrire au
              cabinet. */}
          <div class="cell-cta">
            <Button href={CONTACT.itineraire} variant="secondary" icon="route" iconPosition="left" target="_blank" rel="noopener">
              Trouver l'itinéraire
            </Button>
          </div>
        </RuledCell>

        <div class="map-cell">
          <MapEmbed lat={CONTACT.coords[0]} lon={CONTACT.coords[1]} label={CONTACT.adresse} />
        </div>
      </RuledGrid>
    </section>
  </main>
</Base>

<style>
  /* ---- 1. HÉRO ---- */
  /* Pas de filet sous le héros : la bande sauge enchaîne directement.
     (Le design system en pose un — écart assumé.) */
  .hero {
    /* UNE seule source pour la coupe : --hero-split, la couture, définie dans
       `styles/tokens.css`. Le panneau la prend pour largeur, l'en-tête y pose le
       premier filet de sa navigation, et la photo commence là où l'arc du
       panneau vient se poser, à 76 % de la couture. Les trois ne peuvent plus
       dériver. */
    position: relative;
    /* Le panneau revient dans le FLUX (voir plus bas) : c'est lui qui donne sa
       hauteur au héros, donc le padding du texte respire vraiment au lieu
       d'être avalé par une hauteur fixe. Le clamp n'est plus qu'un plancher. */
    display: grid;
    min-height: clamp(520px, 62vh, 720px);
    overflow: hidden;
  }
  /* Écart assumé au composant : `ArcPanel` se pose en absolu par défaut. Ici il
     est la seule chose en flux — la photo, elle, reste absolue et remplit le
     cadre — pour que la hauteur du héros suive son contenu. */
  .hero :global(.arc-panel) { position: relative; }
  /* La photographie est livrée étalonnée dans les tons du cabinet : elle se
     pose telle quelle, sans fond brun ni fusion pour la réchauffer. */
  /* La photo commence à 76 % de la couture : c'est ce qui cadre le groupe, et
     ce cadrage est juste — il ne bouge pas. C'est aussi la borne de l'arc du
     panneau : la courbe ne peut pas retomber à gauche de cette verticale sans
     découvrir un coin de page sous elle. Elle retombe à 87 %. */
  .hero-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: calc(var(--hero-split) * 0.76);
  }
  .hero-photo :global(img) {
    /* Le groupe est bas dans la photographie livrée et le ciel occupe le tiers
       haut : le zoom est ancré EN BAS (une ancre haute ferait remonter le sol et
       couperait les pieds) et au bord GAUCHE, la part du cadre que le panneau
       recouvre. Les sept avocates se posent alors au milieu de ce qui reste
       visible. Le grossissement reste léger — à deux colonnes, la photographie
       doit garder le Palais et la grande roue autour du groupe, pas seulement
       le groupe. */
    transform: scale(1.12);
    transform-origin: 0 100%;
  }
  .hero-inner {
    /* UNE mesure pour les deux blocs de texte : le titre et le chapô partagent
       exactement la même colonne. En `ch`, ils ne l'auraient pas — le `ch` du
       titre d'affichage et celui du texte courant n'ont pas la même valeur. */
    --hero-measure: clamp(320px, 36vw, 520px);
    /* Le texte se décolle du filet de marge : un cran de plus que
       --content-inset, et le pas de section (et non le petit) en vertical. */
    padding-left: calc(var(--content-inset) + var(--cell-pad));
    padding-right: var(--space-8);
    /* Un cran de plus que le pas de section, en vertical comme en horizontal
       (même formule que le padding-left ci-dessus) : le héros n'est pas une
       bande comme les autres, il porte trois éléments sur une photographie et
       doit leur laisser plus d'air qu'une section courante. C'est ce padding
       qui donne sa hauteur au héros — le `min-height` plus haut n'est qu'un
       plancher. */
    padding-top: calc(var(--section-y) + var(--cell-pad));
    padding-bottom: calc(var(--section-y) + var(--cell-pad));
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 3.6vw, 56px);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--text-heading);
    max-width: var(--hero-measure);
  }
  .hero p {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--brun-moyen);
    max-width: var(--hero-measure);
  }
  /* .cta ne porte PAS `pile-block` — écart assumé au motif. Le bouton du héros
     n'ouvre pas un bloc à part : il achève la phrase du chapô (« voici qui nous
     sommes, voilà où regarder »). Il prend donc le pas courant de la pile,
     --stack, et non --stack-loose. Le héros n'a que trois éléments ; à 48px le
     bouton se détachait et le titre et le chapô se lisaient comme un couple
     avec un intrus dessous. À 32px, les trois pas (16 / 32) montent
     régulièrement et les trois éléments tiennent ensemble. L'écart reste nommé
     par la pile, jamais écrit ici. */

  /* ---- 2. VALEURS ---- */
  /* Le titre de la bande tient sur UNE ligne, toujours : c'est une phrase, et
     une phrase cassée en deux cesse d'être lue d'un trait. `nowrap` scelle la
     ligne ; la taille garantit qu'elle rentre, donc rien ne déborde.

     La ligne mesure 11,0em en Fira Extra Condensed — mais 13,8em en Arial, le
     repli le plus large que la pile puisse encore servir, et qui s'affiche
     pendant le `swap` de la webfont. (Arial Narrow, le repli nommé avant lui,
     ne fait que 11,3em et suit donc Fira de près ; c'est Arial, la chute des
     machines qui n'ont pas de condensée, qui fixe la borne.) On divise donc
     par 14 : tant que la fenêtre offre cette largeur entre ses filets, le
     titre garde ses 40px ; en dessous il rétrécit avec elle au lieu de casser.
     Le plancher de 28px disparaît — une phrase de 29 signes ne tient pas à
     28px sur un téléphone, il fallait choisir.

     Le diviseur était 15 du temps de Playfair, dont le repli le plus large
     était Georgia à 15,0em. Il se remesure à chaque changement de famille
     d'affichage : c'est une largeur de texte, pas une constante. */
  .band-title {
    font-family: var(--font-display);
    font-size: min(40px, (100vw - 2 * var(--content-inset)) / 14);
    white-space: nowrap;
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--text-on-accent);
  }
  /* Le titre de la bande et sa copie cassent sur la même verticale : une seule
     mesure pour les deux (voir RuledCell). `margin-inline` et non `margin` :
     le pas vertical appartient à la pile.

     Cette mesure est celle du TITRE : sa ligne fait 532px à 40px, et 34rem la
     loge sans la serrer. La copie y gagne ~68 signes par ligne, ce qui reste
     dans la fourchette de lecture. */
  .band-title, .band-copy { max-width: 34rem; margin-inline: auto; }
  .band-copy p {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
  }

  /* ---- Sections en registre : le filet du registre tombe sur le filet de marge ---- */
  /* Composition dessinée à la main (placement en zigzag + photo sur trois
     rangées) : elle garde le point de rupture unique. Seule la piste photo
     devient fluide, pour qu'elle ne mange plus la moitié d'un portable. */
  .matieres {
    --photo-track: clamp(300px, 26vw, 420px);
    /* Sous --lap la photo passe en bas, et les matières gardent DEUX colonnes
       tant qu'une cellule tient dans 300px — puis une seule. Le registre ne
       tombe donc jamais de trois pistes à une seule d'un coup. */
    --lap-min: 300px;
    --lap-max: 2;
    padding-left: var(--page-margin);
  }
  .ruled-section { padding: 0 var(--page-margin); border-top: var(--divider); container: registre / inline-size; }

  /* ---- UNE frontière, UN filet ----
     Un registre se ferme TOUT SEUL : la dernière rangée de cellules porte son
     filet bas. La section qui suit pose, elle, le filet de frontière. Empilés,
     les deux traits faisaient 2px entre les matières et l'équipe, puis entre
     l'équipe et les honoraires — un trait deux fois plus épais que tous les
     autres filets de la page, à l'endroit précis où l'on change de sujet.

     Aucun des deux n'est de trop : ils ne couvrent pas la même largeur. Le
     filet du registre s'arrête aux filets de marge (à droite des matières, il
     va jusqu'au bord, la photographie franchit le filet) ; celui de la section
     traverse la page entière, bandes de marge comprises — c'est LUI qu'on voit
     ailleurs sur le site. On ne supprime donc ni l'un ni l'autre : on les fait
     tomber au même endroit. Le -1px remonte la section d'exactement une
     épaisseur de filet, et les deux traits n'en font plus qu'un.

     Le sélecteur porte sur ce qui PRÉCÈDE, pas sur une section nommée : toute
     section qui suit un registre s'y colle, quel que soit l'ordre de la page.
     Une section qui suit `.hono` ou `.liens` — qui ne ferment rien — n'est pas
     concernée et garde son filet à elle. */
  .matieres + section, .ruled-section + section { margin-top: -1px; }

  /* ---- Une section, une couleur ----
     La section est pleine largeur : lui poser un fond peint AUSSI la gouttière,
     de part et d'autre du registre. Le registre, lui, reprend la même valeur par
     `--section-surface` (voir RuledGrid). Une seule valeur par section, donc
     aucune dérive possible entre l'intérieur du registre et la bande de marge. */
  .matieres, .ruled-section, .hono, .liens { background: var(--section-surface); }

  #services   { --section-surface: var(--surface-services); }
  #equipe     { --section-surface: var(--surface-equipe); }
  #honoraires { --section-surface: var(--surface-honoraires); }
  #liens      { --section-surface: var(--surface-liens); }
  #contact    { --section-surface: var(--surface-contact); }

  .grid-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.15;
    /* La mesure appartient à la cellule (rem) : le label et le titre cassent
       sur la même verticale, et non sur deux `ch` de corps différents. */
    max-width: var(--cell-measure);
  }
  /* Le nombre d'avocates qui prennent la matière : la MÊME pastille de filet
     que les langues d'un portrait (`styles/pastille.css`) — une note posée au
     pied de la cellule, pas une seconde ligne de texte.

     La boîte vient de la classe partagée ; il ne reste ici que l'encre, et
     elle est celle des étiquettes. Elle est écrite par `--text-label`, une
     custom property, et non par une couleur en dur : au survol, la cellule
     repose cette variable un cran plus foncé (voir `styles/survol.css`) et la
     pastille suit le reste de la cellule au lieu de rester en arrière — ce
     qu'une couleur écrite ici aurait empêché, la règle de survol portant sur
     la cellule et non sur ses enfants.

     La pastille est ENVELOPPÉE, et c'est `pile-foot` qui l'impose : ce pied de
     pile pose son écart en `padding-top`, et un padding posé sur la pastille
     elle-même passerait DANS son filet — un rectangle de 48px de haut autour
     de trois mots. L'enveloppe prend l'écart, la pastille garde sa boîte. */
  .count { color: var(--text-label); }
  .matiere-photo { grid-column: 3; grid-row: 1 / span 3; border-bottom: var(--divider); }

  /* ---- 4. HONORAIRES ----
     La section a quitté le registre : ni filets, ni cellules. Deux blocs sur la
     couleur de la section, séparés par de l'air. La grille se replie SEULE —
     `auto-fit` sur une piste de 400px minimum — donc pas de point de rupture de
     plus à tenir : dès que deux colonnes ne tiennent plus, il n'y en a qu'une. */
  .hono { padding: var(--section-y) 0; border-top: var(--divider); }
  /* Le titre, le texte et le renvoi cassent tous sur la même verticale : la
     mesure est portée par la colonne, une seule fois (voir RuledCell). */
  .hono-propos { max-width: 30rem; }
  .hono-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: var(--space-8);
    /* Le panneau tient sa hauteur de son texte, pas de la colonne d'à côté. */
    align-items: start;
  }
  /* Le seul titre de l'accueil qui parle au lecteur à la première personne :
     il est plus grand que les titres de cellule, il n'en est pas un. */
  .hono-titre {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 68px);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    letter-spacing: var(--ls-display);
  }
  /* Le renvoi vers avocats.be : c'est une seconde voix, pas une note de bas de
     page — elle est en gras, et le lien porte son soulignement. */
  .hono-note { font-weight: var(--fw-semibold); }
  .hono-note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hono-note a:hover { color: var(--text-link); }

  /* Le panneau : le seul aplat sombre de la section. Le bouton secondaire s'y
     retourne par les tokens qu'il lit déjà — aucune règle ne va chercher
     l'intérieur du composant.

     Le lit du survol est repris ici, et c'est le seul endroit du site qui ait à
     le faire : le voile de caramel est un PREMIER CRAN posé sur du clair, et il
     n'existe pas sur du sauge obscur — il y ferait une tache, pas un cran. Sur
     un fond sombre, le premier cran est le crème. */
  .hono-panneau {
    background: var(--sauge-obscur);
    color: var(--text-on-dark);
    padding: var(--cell-pad);
    --btn-secondary-fg: var(--creme);
    --btn-secondary-border: var(--creme);
    --survol-aplat: var(--creme);
    --survol-encre: var(--sauge-obscur);
  }
  .panneau-titre {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    color: var(--creme);
  }
  /* Dans le panneau, la mesure est déjà donnée par la colonne. */
  .hono-panneau .body { max-width: none; }

  .body { font-size: var(--fs-body); line-height: 1.6; }

  /* ---- 5. ÉQUIPE ---- */
  .big {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 84px);
    font-weight: var(--fw-bold);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  /* `.filler` est un <p> qui tient le rôle d'un titre : `eg-title` lui donne
     l'œil du display ET le pas qui va avec (voir pile.css). Il ne reste ici
     que ce qui lui est propre — la taille et la mesure. */
  /* Dans une cellule du registre, la mesure appartient à la cellule : le texte
     casse sur la verticale de la cellule elle-même, et court donc sur toute la
     largeur jusqu'au `--cell-pad`. Il faut le dire deux fois — abandonner
     `--cell-measure`, ET lever le `--measure-prose` que `tokens/base.css` pose
     sur tout <p> (66ch, qui reprendrait la main avant le bord dès que la
     cellule dépasse ~650px). Écart assumé. */
  .sub { max-width: none; }
  .filler { font-size: 26px; line-height: 1.3; max-width: 16ch; }

  /* ---- 6. LIENS UTILES ---- */
  /* La section garde son air : le registre ne la remplit pas, il est POSÉ
     dedans. C'est la seule de l'accueil dans ce cas — les trois autres sont un
     registre de bord à bord. */
  .liens { padding: var(--section-y) var(--page-margin); border-top: var(--divider); }

  /* UNE seule verticale gouverne la section, et c'est celle du texte de la
     première colonne : le nom de la section, le nom du groupe et l'intitulé
     d'un lien commencent tous à `--cell-pad` du filet de marge. C'est plus que
     le `--content-inset` que la loi exige — donc la loi tient — et c'est
     surtout la SEULE valeur qui aligne le titre sur ce qu'il annonce. */
  .liens-head { padding-left: var(--cell-pad); }
  /* Le nom de la section prend l'oeil de « Nos avocates » (voir `.big`) : ces
     deux-là ouvrent une section entière, pas une cellule. */

  /* La rangée des noms de groupes : dans le registre pour en prendre les
     colonnes, hors de la boîte pour tout le reste. Aucun filet — c'est la
     ligne de liens qui pose le premier trait — et le pas d'un titre à ce qu'il
     ouvre en guise de fond de cellule. */
  .groupe-nom { padding: 0 var(--cell-pad) var(--stack-tight); max-width: none; }

  /* La cellule d'une liste n'a AUCUN padding vertical : le filet du haut est
     celui de la première ligne, celui du bas est le sien. Une liste plus
     courte que sa voisine ne ferme donc pas plus haut — les deux colonnes
     tombent sur le même trait. */
  .groupe-liens {
    /* Le débord d'une ligne vaut le padding de ce qui la contient : son filet
       traverse alors toute la cellule, d'un filet vertical à l'autre, au lieu
       de commencer et de s'arrêter en l'air (voir `LinkList`). */
    --links-bleed: var(--cell-pad);
    padding: 0 var(--cell-pad);
    border-right: var(--divider);
    border-bottom: var(--divider);
  }

  /* ---- 7. CONTACT ---- */
  .cell-lead {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.18;
    max-width: 16ch;
  }
  .cell-h3 {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    color: var(--type-subtitle-color);
  }
  /* Même carré que sur les noms de matières — il remplace l'icône enveloppe
     qui ouvrait « Nous joindre » : les trois cellules du registre s'ouvrent
     maintenant du même geste, et non deux d'un côté et une de l'autre.
     Les groupes de liens de la section 6 portent le même nom de rôle, donc le
     même carré : sur l'accueil, tout ce qui ouvre une cellule filetée s'ouvre
     de ce geste-là. */
  .cell-h3::before {
    content: '';
    display: inline-block;
    width: var(--type-subtitle-mark);
    height: var(--type-subtitle-mark);
    margin-right: var(--type-subtitle-mark-gap);
    /* Pas `currentColor` : au survol le carré s'allume en caramel pendant que
       le titre fonce (voir `styles/tokens.css`). */
    background: var(--type-subtitle-mark-color);
  }
  /* Même règle que dans le registre des matières : le nom de la cellule et les
     lignes qui le suivent partagent la mesure de la cellule. */
  .cell-h3, .lines { max-width: var(--cell-measure); }
  .lines { display: grid; gap: var(--stack-bind); font-size: var(--fs-body-sm); line-height: 1.5; }
  /* Chaque ligne s'ouvre par son glyphe : ce qu'elle EST se lit avant ce
     qu'elle dit — une adresse, un téléphone, un métro. */
  .line { display: flex; gap: var(--space-3); }
  /* Le nom pousse la marche au bord droit de la mesure ; la marche, elle, ne se
     laisse jamais couper — c'est un nombre, il tient sur une ligne. Le gris la
     met un cran en retrait du nom : c'est une précision, pas l'information. */
  .arret-nom { flex: 1 1 auto; }
  .arret-marche {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Le glyphe est posé sur la PREMIÈRE ligne, pas centré sur le bloc :
     l'adresse en prend deux, et une icône centrée flotterait entre les deux.
     Les 3px rattrapent la demi-différence entre la hauteur de ligne (27px) et
     le glyphe (18px), moins ce que le trait laisse d'air en haut. */
  .ico { flex: 0 0 auto; margin-top: 3px; color: var(--text-label); }
  .muted-line { color: var(--text-muted); }
  /* Le bouton se pose sous les arrêts, à la même mesure qu'eux, et respire du
     pas de la pile — jamais collé à la dernière ligne. */
  .cell-cta { max-width: var(--cell-measure); margin-top: var(--space-6); }
  .map-cell { grid-column: span 2; border-bottom: var(--divider); }
  /* À une seule colonne, `span 2` fabriquerait une colonne implicite et
     casserait la grille : on le retire. Requête de CONTENEUR — la mesure est
     celle du registre, pas celle de l'écran. */
  @container registre (width < 44rem) {
    .map-cell { grid-column: auto; }
  }

  /* Ne restent ici que de vrais changements de MODE : le panneau du héros
     cesse de recouvrir la photo, et le registre des matières cesse d'être une
     composition. Les sections gardent leur padding — le registre s'aligne donc
     sur les filets à toutes les largeurs, au lieu de les franchir (seule la
     photographie a le droit de les franchir). */
  @media (--lap) {
    .hero { min-height: 0; }
    /* Un rapport, pas une hauteur fixe : à 380 px la photo devenait un bandeau
       de plus en plus écrasé à mesure que la largeur montait vers 1000 px, et
       la coupe mangeait les têtes puis les pieds. Le 5/3 rejoue EXACTEMENT le
       cadrage de la version à deux colonnes — même part de ciel coupée, mêmes
       marges autour du groupe — à ceci près que le panneau ne recouvre plus
       rien : une seule photographie, deux mises en page.
       `width` est posée explicitement : avec `aspect-ratio`, une largeur `auto`
       se déduirait de la hauteur et déborderait du téléphone. */
    .hero-photo { position: static; left: auto; width: 100%; height: auto; aspect-ratio: 5 / 3; }
    /* Pleine largeur, plus de panneau par-dessus : le recadrage du héros
       large n'a plus lieu d'être, la photo se suffit. */
    .hero-photo :global(img) { transform: none; }
    .hero-inner { padding: var(--section-y-sm) var(--content-inset); }
    /* La photo d'ambiance ne disparaît plus : elle ferme le registre en pleine
       largeur. C'est la seule chose qui a le droit de franchir un filet. */
    .matiere-photo { margin-left: calc(-1 * var(--page-margin)); }
    .matiere-photo :global(.arc) { height: auto; aspect-ratio: 16 / 9; }
    .map-cell { min-height: 320px; }
    /* Le registre des liens est sur une colonne : un nom de groupe ne coiffe
       plus une colonne, il SUIT la liste précédente. Il lui faut donc l'air
       qu'un titre a toujours au-dessus de lui — celui que la rangée du haut
       lui donnait gratuitement. */
    .groupe-liens + .groupe-nom { padding-top: var(--stack-loose); }
  }
</style>
