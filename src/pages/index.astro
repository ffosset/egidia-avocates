    .hero-photo { position: static; left: auto; width: 100%; height: auto; aspect-ratio: 5 / 3; }
    /* Pleine largeur, plus de panneau par-dessus : le recadrage du héros
       large n'a plus lieu d'être, la photo se suffit. */
    .hero-photo :global(img) { transform: none; }
    .hero-inner { padding: var(--section-y-sm) var(--content-inset); }
