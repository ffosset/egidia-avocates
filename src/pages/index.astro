  .cell-h3::before {
    content: '';
    display: inline-block;
    width: var(--type-subtitle-mark);
    height: var(--type-subtitle-mark);
    margin-right: var(--type-subtitle-mark-gap);
    /* Pas `currentColor` : au survol le carré s'allume en caramel pendant que
       le titre fonce (voir `styles/tokens.css`). */
    background: var(--type-subtitle-mark-color);
  }
  /* Même règle que dans le registre des matières : le nom de la cellule et les
     lignes qui le suivent partagent la mesure de la cellule. */
  .cell-h3, .lines { max-width: var(--cell-measure); }
  .lines { display: grid; gap: var(--stack-bind); font-size: var(--fs-body-sm); line-height: 1.5; }
  /* Chaque ligne s'ouvre par son glyphe : ce qu'elle EST se lit avant ce
     qu'elle dit — une adresse, un téléphone, un métro. */
  .line { display: flex; gap: var(--space-3); }
  /* Le glyphe est posé sur la PREMIÈRE ligne, pas centré sur le bloc :
     l'adresse en prend deux, et une icône centrée flotterait entre les deux.
