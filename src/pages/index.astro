---
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Button from '../components/Button.astro';
import RuleLink from '../components/RuleLink.astro';
import Icon from '../components/Icon.astro';
import Band from '../components/Band.astro';
import ArcImage from '../components/ArcImage.astro';
import ArcPanel from '../components/ArcPanel.astro';
import RuledGrid from '../components/RuledGrid.astro';
import RuledCell from '../components/RuledCell.astro';
import PersonCell from '../components/PersonCell.astro';
import MapEmbed from '../components/MapEmbed.astro';
import LinkList from '../components/LinkList.astro';
import { MATIERES } from '../data/matieres.js';
import { AVOCATES, languesCourtes } from '../data/avocates.js';
import { CONTACT, PHOTOS, ALT, LIENS_ACCUEIL } from '../data/site.js';

const itineraire = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(CONTACT.adresse)}`;
---
<Base title="Egidia">
  <main>
    {/* 1 — HERO : la photo occupe le cadre, le panneau de papier la recouvre,
        l'arc du bouclier balaie son bord de fuite. */}
    <section class="hero">
      {/* La photo ne prend que la partie droite : les sept avocates doivent
          toutes rester visibles à côté du panneau. */}
      <div class="hero-photo">
        <ArcImage
          src={PHOTOS.equipe}
          alt={ALT.equipe}
          corner="none"
          objectPosition="52% 42%"
          loading="eager"
        />
      </div>
      <ArcPanel width="min(50%, 820px)">
        <div class="hero-inner">
          <h1>Chaque personne a droit à être écoutée, conseillée et défendue</h1>
          <p>
            Cabinet bruxellois en droit des étrangers, de la famille, de l'aide sociale et de la
            jeunesse. Une relation fondée sur l'écoute et la transparence.
          </p>
          <div class="cta"><Button href="#matieres">Voir nos domaines</Button></div>
        </div>
      </ArcPanel>
    </section>

    {/* 2 — VALEURS */}
    <Band tone="sage" id="valeurs">
      <h2 class="band-title">Une justice claire et humaine</h2>
      <div class="band-copy">
        <p>
          Derrière chaque dossier, il y a une personne et une histoire. Nous prenons le temps de
          comprendre la vôtre avant de vous conseiller. Nous expliquons chaque étape pour vous
          aider à y voir plus clair dans votre situation, comprendre les enjeux et les choix qui
          s'offrent à vous.
        </p>
        <p>
          Une procédure est souvent une épreuve. Nous vous accompagnons pour la traverser ensemble.
          Nous travaillons en lien étroit avec le réseau associatif bruxellois, pour que
          l'accompagnement ne s'arrête pas à la porte du tribunal.
        </p>
      </div>
    </Band>

    {/* 3 — MATIÈRES : le filet gauche du registre tombe sur le filet de marge ;
        seule la photographie franchit le filet de droite. */}
    <section id="matieres" class="matieres">
      <RuledGrid columns="minmax(0, 1fr) minmax(0, 1fr) 420px" noTop>
        <RuledCell align="center">
          <h2 class="grid-title">Services offerts par le cabinet</h2>
        </RuledCell>
        {MATIERES.map((m, i) => {
          const n = i + 1;
          const col = n % 2 === 0 ? 1 : 2;
          return (
            <RuledCell
              title={m.titre}
              lead={m.resume}
              href={`/matieres/${m.id}`}
              style={`grid-column:${col};grid-row:${Math.floor(n / 2) + 1}`}
            >
              <span class="count eg-accent">
                <span>{m.nb} avocates</span><Icon name="arrow-right" size={18} />
              </span>
            </RuledCell>
          );
        })}
        <div class="matiere-photo">
          <ArcImage src={PHOTOS.ambiance} alt={ALT.ambiance} corner="none" />
        </div>
      </RuledGrid>
    </section>

    {/* 4 — HONORAIRES : deux cellules du registre, l'aide juridique sur voile sauge */}
    <section id="honoraires" class="ruled-section">
      <RuledGrid columns="minmax(0, 1fr) minmax(0, 1fr)" noTop>
        <RuledCell minHeight={360}>
          <Eyebrow>Honoraires</Eyebrow>
          <h2 class="cell-title">Des prix transparents</h2>
          <p class="body">
            Nos honoraires varient selon la nature de l'affaire, sa complexité et votre situation.
            Nous les fixons avec modération, et nous vous les expliquons clairement.
          </p>
          <p class="muted">
            Pour comprendre comment se calculent les honoraires d'un avocat en Belgique :
            <a href="https://avocats.be/fr/tout-savoir/combien-ca-coute" rel="noopener">combien coûte un avocat ?</a>
          </p>
        </RuledCell>
        <RuledCell minHeight={360} style="background: var(--surface-accent-soft)">
          <Eyebrow>Aide juridique</Eyebrow>
          <p class="tight">
            L'aide juridique permet d'être défendu par un avocat lorsque vos ressources ne vous
            permettent pas d'en payer un. Selon vos revenus, elle est entièrement ou partiellement
            gratuite.
          </p>
          <p class="claim">Ce n'est pas une faveur : c'est un droit.</p>
          <p class="muted">
            Toutes les avocates du cabinet travaillent dans le cadre de l'aide juridique. Nous
            vérifions avec vous si vous remplissez les conditions et nous vous aidons à constituer
            votre demande.
          </p>
          <div class="cell-foot">
            <Button href="/aide-juridique" size="md" icon="file-text" iconPosition="left">
              Liste des documents à produire
            </Button>
          </div>
        </RuledCell>
      </RuledGrid>
    </section>

    {/* 5 — ÉQUIPE */}
    <section id="equipe" class="ruled-section">
      <RuledGrid columns="minmax(0, 1fr) minmax(0, 1fr)" noTop>
        <RuledCell align="center" minHeight={280}>
          <Eyebrow>Équipe</Eyebrow>
          <h2 class="big">Nos avocates</h2>
        </RuledCell>
        <RuledCell align="center" minHeight={280}>
          <p class="statement">Sept avocates. Cinq matières. Une seule interlocutrice pour votre dossier.</p>
          <p class="sub">
            Celle que vous rencontrez est celle qui plaide. Cliquez sur un nom pour lire son
            parcours, ses publications, et la contacter directement.
          </p>
        </RuledCell>
      </RuledGrid>
      <RuledGrid columns="repeat(4, minmax(0, 1fr))" noTop>
        {AVOCATES.map((a) => (
          <PersonCell
            name={a.nom}
            photo={a.photo}
            meta={languesCourtes(a.langues)}
            href={`/avocates/${a.slug}`}
          />
        ))}
        {/* La rangée ne tombe pas juste : on comble avec une vraie phrase, jamais un vide. */}
        <RuledCell align="center" minHeight={200}>
          <p class="filler">Toutes travaillent dans le cadre de l'aide juridique.</p>
          <a href="/aide-juridique" class="filler-link eg-accent">
            Documents à apporter <Icon name="arrow-right" size={20} />
          </a>
        </RuledCell>
      </RuledGrid>
    </section>

    {/* 6 — LIENS UTILES */}
    <section id="liens" class="liens">
      <Page>
        <SectionHead eyebrow="Liens utiles" title="Ressources externes" />
        <div class="link-cols">
          {LIENS_ACCUEIL.map(([titre, liens]) => (
            <div>
              <h3>{titre}</h3>
              <LinkList items={liens} />
            </div>
          ))}
        </div>
      </Page>
    </section>

    {/* 7 — CONTACT ET ACCÈS : registre à trois colonnes, la carte occupe deux */}
    <section id="contact" class="ruled-section">
      <RuledGrid columns="repeat(3, minmax(0, 1fr))" noTop>
        <RuledCell align="center" minHeight={300}>
          <Eyebrow>Contact et accès</Eyebrow>
          <h2 class="cell-lead">Les consultations ont lieu uniquement sur rendez-vous</h2>
        </RuledCell>

        <RuledCell minHeight={300}>
          <h3 class="cell-h3 with-icon"><Icon name="mail" size={28} />Nous joindre</h3>
          <div class="lines">
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            <span class="muted-line">Ligne directe de chaque avocate : voir sa fiche.</span>
          </div>
          <div class="cell-foot">
            <RuleLink href={`mailto:${CONTACT.email}`}>Envoyer un message</RuleLink>
          </div>
        </RuledCell>

        <RuledCell minHeight={300}>
          <h3 class="cell-h3">Nous trouver</h3>
          <div class="lines">
            <span>{CONTACT.adresse}</span>
            <span class="muted-line">{CONTACT.acces}</span>
          </div>
        </RuledCell>

        <RuledCell align="center" minHeight={420}>
          <h3 class="cell-h3 narrow">En transports en commun</h3>
          <div class="lines">
            <span>{CONTACT.metro}</span>
            <span>{CONTACT.tram}</span>
          </div>
          <div class="cell-foot">
            <RuleLink href={itineraire}>Itinéraire</RuleLink>
          </div>
        </RuledCell>

        <div class="map-cell">
          <MapEmbed lat={CONTACT.coords[0]} lon={CONTACT.coords[1]} zoom={16} label={CONTACT.adresse} />
        </div>
      </RuledGrid>
    </section>
  </main>
</Base>

<style>
  /* ---- 1. HÉRO ---- */
  .hero {
    position: relative;
    min-height: 640px;
    border-bottom: var(--divider);
    overflow: hidden;
  }
  .hero-photo { position: absolute; top: 0; bottom: 0; right: 0; left: 38%; }
  .hero-inner {
    padding-left: var(--content-inset);
    padding-right: var(--space-10);
    padding-top: var(--section-y-sm);
    padding-bottom: var(--section-y-sm);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 3.6vw, 56px);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--text-heading);
    max-width: 18ch;
  }
  .hero p {
    margin-top: var(--stack);
    margin-bottom: 0;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--brun-moyen);
    max-width: 40ch;
  }
  .cta { margin-top: var(--stack-loose); }

  /* ---- 2. VALEURS ---- */
  .band-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.8vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--text-on-accent);
  }
  .band-copy { max-width: 48ch; margin: 0 auto; }
  .band-copy p {
    margin-top: var(--space-6);
    font-size: var(--fs-body);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
  }
  .band-copy p:last-child { margin-bottom: 0; }

  /* ---- Sections en registre : le filet du registre tombe sur le filet de marge ---- */
  .matieres { padding-left: var(--page-margin); }
  .ruled-section { padding: 0 var(--page-margin); border-top: var(--divider); }

  .grid-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.15;
    max-width: 12ch;
  }
  .count {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: var(--fw-semibold);
    color: var(--sauge-obscur);
  }
  .matiere-photo { grid-column: 3; grid-row: 1 / span 3; border-bottom: var(--divider); }

  /* ---- 4. HONORAIRES ---- */
  .cell-title {
    margin: 0;
    margin-top: var(--stack-tight);
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }
  .body { margin: var(--stack) 0 0; font-size: var(--fs-body); line-height: 1.6; max-width: 44ch; }
  .muted { margin: var(--stack) 0 0; font-size: var(--fs-body-sm); line-height: 1.6; color: var(--text-muted); max-width: 46ch; }
  .tight { margin: var(--stack-tight) 0 0; font-size: var(--fs-body-sm); line-height: 1.6; max-width: 46ch; }
  .claim {
    margin: var(--stack) 0 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 2vw, 30px);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    color: var(--brun-profond);
    max-width: 20ch;
  }
  .cell-foot { margin-top: auto; padding-top: var(--stack-loose); }

  /* ---- 5. ÉQUIPE ---- */
  .big {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 84px);
    font-weight: var(--fw-bold);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .statement { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 2.2vw, 32px); font-weight: var(--fw-bold); line-height: 1.25; max-width: 22ch; }
  .sub { margin: var(--stack) 0 0; font-size: var(--fs-body-sm); line-height: 1.6; color: var(--text-muted); max-width: 46ch; }
  .filler { margin: 0; font-family: var(--font-display); font-size: 26px; font-weight: var(--fw-bold); line-height: 1.3; max-width: 16ch; }
  .filler-link {
    margin-top: var(--stack);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-semibold);
    color: var(--sauge-obscur);
    text-decoration: none;
  }

  /* ---- 6. LIENS UTILES ---- */
  .liens { background: var(--surface-inset); padding: var(--section-y) 0; border-top: var(--divider); }
  .link-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-9); margin-top: var(--space-7); }
  .link-cols h3 { font-family: var(--font-display); font-size: 26px; font-weight: var(--fw-bold); margin-bottom: 8px; }

  /* ---- 7. CONTACT ---- */
  .cell-lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: var(--fw-bold);
    line-height: 1.18;
    max-width: 16ch;
  }
  .cell-h3 { margin: 0; font-family: var(--font-display); font-size: 30px; font-weight: var(--fw-bold); }
  .cell-h3.with-icon { display: flex; align-items: center; gap: var(--space-4); }
  .cell-h3.narrow { max-width: 14ch; }
  .lines { margin-top: var(--stack); display: grid; gap: var(--space-3); font-size: var(--fs-body-sm); line-height: 1.5; }
  .muted-line { color: var(--text-muted); }
  .map-cell { grid-column: span 2; border-bottom: var(--divider); }

  @media (max-width: 1000px) {
    .hero { min-height: 0; }
    .hero-photo { position: static; height: 380px; }
    .hero-inner { padding: var(--space-8) var(--content-inset); }
    .matieres { padding-left: 0; }
    .ruled-section { padding: 0; }
    .link-cols { grid-template-columns: 1fr; gap: var(--space-7); }
    .matiere-photo { display: none; }
    .map-cell { min-height: 320px; }
  }
</style>
