---
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import RuleLink from '../components/RuleLink.astro';
import { MATIERES } from '../data/matieres.js';
import { CONTACT } from '../data/site.js';
---
{/* La page d'égarement. GitHub Pages sert `404.html` pour toute adresse
    inconnue ; Astro la construit à la racine de `dist/` quel que soit le
    `format`. Elle ne s'indexe pas et n'entre pas dans le plan du site. Elle
    dit ce qui s'est passé en une phrase et rend trois issues — l'accueil, les
    matières, l'adresse de courriel — sans bande de héros ni fil d'Ariane : on
    n'est nulle part, il n'y a rien à remonter. */}
<Base title="Page introuvable" noindex>
  <main>
    <Page>
      <div class="egare">
        <Eyebrow>Erreur 404</Eyebrow>
        <h1>Cette page n’existe pas, ou plus</h1>
        <p class="lead">
          L’adresse a peut-être été mal recopiée, ou la page a été déplacée.
          Rien n’est perdu : tout ce que le cabinet publie se retrouve d’ici.
        </p>
        <div class="issues">
          <Button href="/" icon="arrow-right">Revenir à l’accueil</Button>
          <RuleLink href="/#contact">Nous joindre</RuleLink>
        </div>

        <div class="matieres">
          <Eyebrow>Vous cherchiez peut-être</Eyebrow>
          <ul>
            {MATIERES.map((m) => (
              <li><RuleLink href={`/matieres/${m.id}`}>{m.titre}</RuleLink></li>
            ))}
          </ul>
        </div>

        <p class="note">
          Si vous suiviez un lien depuis un autre site, écrivez-nous à
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> : nous le ferons corriger.
        </p>
      </div>
    </Page>
  </main>
</Base>

<style>
  .egare {
    padding: var(--section-y) 0;
    max-width: 48rem;
  }
  h1 {
    margin-top: var(--stack-tight);
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: 1.12;
  }
  .lead {
    margin-top: var(--stack-tight);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--brun-moyen);
  }
  .issues {
    margin-top: var(--stack);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }
  .matieres { margin-top: var(--section-y-sm); }
  .matieres ul {
    list-style: none;
    margin: var(--stack-tight) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
  }
  .note {
    margin-top: var(--section-y-sm);
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }
  .note a { color: inherit; }
</style>
