---
import { withBase } from '../../lib/base.js';
import Base from '../../layouts/Base.astro';
import Page from '../../components/Page.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Card from '../../components/Card.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ArcImage from '../../components/ArcImage.astro';
import LinkList from '../../components/LinkList.astro';
import ContactBand from '../../components/ContactBand.astro';
import { AVOCATES } from '../../data/avocates.js';
import { MATIERES } from '../../data/matieres.js';

export function getStaticPaths() {
  return AVOCATES.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props;
const telHref = a.tel ? `tel:+32${a.tel.replace(/\D/g, '').slice(1)}` : null;
const autres = AVOCATES.filter((x) => x.slug !== a.slug);
---
<Base
  title={a.nom}
  description={`${a.nom}, avocate au barreau de Bruxelles${a.depuis ? ` depuis ${a.depuis}` : ''} — ${a.motsCles.join(', ')}.`}
>
  <main>
    {/* PAS de bande de héros : la photographie ouvre simplement la colonne de
        gauche, et la colonne de droite s'ouvre sur le fil d'Ariane et le titre
        puis enchaîne sans rupture. Une bande aurait imposé sa hauteur au texte
        et creusé un vide sous le titre ; ici les deux colonnes coulent. */}
    <Page>
      <div class="split">
        <div class="side">
          <div class="portrait">
            <ArcImage src={a.photo} alt={a.nom} corner="bottom-right" sweep="78% 58%" loading="eager" />
          </div>
          <Card padding="var(--space-6)">
            <Eyebrow>Contact</Eyebrow>
            <div class="contact">
              <a href={`mailto:${a.email}`} class="line break"><Icon name="mail" size={22} />{a.email}</a>
              {telHref && (
                <a href={telHref} class="line ruled"><Icon name="phone" size={22} />{a.tel}</a>
              )}
              {a.linkedin && (
                <a href={a.linkedin} class="line ruled" target="_blank" rel="noopener"><Icon name="linkedin" size={22} />Profil LinkedIn</a>
              )}
            </div>
          </Card>
          <Card tone="inset" padding="var(--space-6)">
            <Eyebrow>En bref</Eyebrow>
            <div class="rows">
              {a.depuis && <div class="row"><span class="k">Au barreau depuis</span><span class="v">{a.depuis}</span></div>}
              {a.cabinets.passe && <div class="row"><span class="k">Auparavant</span><span class="v">{a.cabinets.passe}</span></div>}
              <div class="row"><span class="k">TVA</span><span class="v mono">{a.tva}</span></div>
            </div>
          </Card>
        </div>

        <div>
          <div class="fil">
            <Breadcrumb items={[
              { label: 'Accueil', href: '/' },
              { label: 'Nos avocates', href: '/#equipe' },
              { label: a.nom },
            ]} />
          </div>
          <h1>{a.nom}</h1>

          <div class="block">
            <Eyebrow>Services préférentiels</Eyebrow>
            <div class="chips">
              {a.motsCles.map((t) => {
                const m = MATIERES.find((x) => x.titre.toLowerCase() === t.toLowerCase());
                return m
                  ? <Button href={`/matieres/${m.id}`} variant="secondary" size="md" icon="arrow-right">{t}</Button>
                  : <Tag>{t}</Tag>;
              })}
            </div>
          </div>

          <div class="block">
            <Eyebrow>Langues</Eyebrow>
            <div class="chips">
              {a.langues.map((l) => <Tag>{l}</Tag>)}
            </div>
          </div>

          <div class="block prose">
            <Eyebrow>Parcours</Eyebrow>
            <div class="spaced">
              {a.parcours.map((p, i) => <p class={i === 0 ? 'first' : ''}>{p}</p>)}
            </div>
          </div>

          {a.publications.length > 0 && (
            <div class="block prose">
              <Eyebrow>Publications</Eyebrow>
              <ol>
                {a.publications.map((p, i) => (
                  <li><span class="num">{String(i + 1).padStart(2, '0')}</span><span>{p}</span></li>
                ))}
              </ol>
            </div>
          )}

          {a.liens.length > 0 && (
            <div class="block prose">
              <Eyebrow>Recherches et publications en ligne</Eyebrow>
              <div class="tight"><LinkList items={a.liens} /></div>
            </div>
          )}

          <div class="block">
            <Eyebrow>Les autres avocates</Eyebrow>
            <div class="chips">
              {autres.map((x) => (
                <a href={withBase(`/avocates/${x.slug}`)} class="peer eg-invert">{x.nom}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </Page>
    <ContactBand />
  </main>
</Base>

<style>
  /* ---- LE PORTRAIT ----
     Debout, en tête de la colonne de gauche, et il part du bord de la FENÊTRE :
     il franchit le filet de marge — seule chose du site qui en ait le droit.
     Le débord vaut exactement la distance qui sépare le bord de la fenêtre du
     début du contenu, centrage au-delà de --page-max compris ; la photographie
     ne peut donc pas dériver du cadre.
     Son arc est plus profond que l'arc de vignette (42%/52%) : il balaye toute
     la hauteur d'un portrait debout, et non le coin d'une image. */
  .portrait {
    --bleed: calc(max(0px, (100vw - var(--page-max)) / 2) + var(--content-inset));
    margin-left: calc(-1 * var(--bleed));
    width: calc(100% + var(--bleed));
    height: clamp(440px, 78vh, 820px);
  }
  /* Une fois les colonnes empilées, le portrait n'est plus une colonne debout
     mais un bandeau : il reprend la hauteur des photos de bas de page. */
  @media (--lap) {
    .portrait { height: 380px; }
  }
  /* Le fil d'Ariane n'est pas l'étiquette du titre (ce serait --stack-bind) :
     c'est un bloc distinct qui le précède. */
  .fil { margin-bottom: var(--stack); }

  /* Deux colonnes proportionnelles tant qu'elles tiennent, puis empilées.
     `flex-wrap` fait deux choses qu'une grille à points de rupture ne fait pas :
     l'asymétrie se DÉTEND vers l'égalité à mesure que la place manque, puis le
     bloc passe dessous. La bascule est décidée par la mesure du texte (en ch),
     pas par un pixel deviné — donc pas de @media.

     Pas de `min-width: 0` sur les colonnes : ce serait les autoriser à devenir
     plus étroites que leur propre contenu, et les cartes déborderaient au lieu
     de passer à la ligne. Le `min-width: auto` par défaut est ce qui déclenche
     le retour à la ligne au bon moment. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-9);
    padding: 0 0 var(--section-y);
  }
  .split > .side          { flex: 4 1 22ch; }
  /* Le portrait touche l'en-tête ; seul le TEXTE descend. */
  .split > div:not(.side) { flex: 8 1 40ch; padding-top: var(--section-y); }
  @media (--lap) {
    .split > div:not(.side) { padding-top: var(--section-y-sm); }
  }
  .side { display: grid; gap: var(--space-5); }

  h1 { font-family: var(--font-display); font-size: var(--fs-h1); font-weight: var(--fw-bold); line-height: 1.12; }

  .contact { margin-top: var(--stack-tight); display: grid; }
  .line { display: flex; gap: var(--space-3); align-items: center; font-size: var(--fs-body-sm); }
  .break { padding-bottom: var(--space-4); word-break: break-all; }
  .ruled { padding: var(--space-4) 0; border-top: var(--divider); }

  .rows { margin-top: var(--space-2); }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: var(--divider);
  }
  .k { font-size: 16px; color: var(--text-label); }
  .v { font-size: var(--fs-body-sm); text-align: right; }
  .mono { font-family: var(--font-mono); font-size: 16px; }

  .block { margin-top: var(--space-8); }
  /* Le titre et le premier bloc : le pas « bloc → bloc » de la pile. */
  h1 + .block { margin-top: var(--stack-loose); }
  .prose { max-width: var(--measure-prose); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--stack-tight); }
  .spaced { margin-top: var(--space-5); }
  .spaced p { font-size: var(--fs-body); line-height: 1.6; color: var(--brun-moyen); }
  .spaced p.first { font-size: var(--fs-lead); line-height: 1.5; color: var(--text-body); }
  .tight { margin-top: var(--stack-tight); }

  ol { list-style: none; margin: 20px 0 0; padding: 0; }
  ol li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: var(--divider);
  }
  .num { font-family: var(--font-display); font-size: 22px; font-weight: var(--fw-bold); color: var(--caramel); }
  ol li span:last-child { font-size: var(--fs-body-sm); line-height: 1.55; }

  .peer {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--fs-body-sm);
    padding: 0 var(--space-5);
    border: 1px solid var(--line-strong);
    text-decoration: none;
    color: var(--text-body);
    background: var(--surface-card);
    /* Le fond qui reste visible pendant le balayage (voir `survol.css`). */
    --survol-lit: var(--surface-card);
  }

</style>
