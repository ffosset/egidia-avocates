---
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import LinkList from '../components/LinkList.astro';
import ContactBand from '../components/ContactBand.astro';
import { GENERAUX, REVENUS, LIENS_PRODEO } from '../data/prodeo.js';
---
<Base
  title="Documents pour l'aide juridique"
  description="La liste des documents à apporter pour constituer une demande d'aide juridique (pro deo) au cabinet Egidia."
>
  <main>
    {/* PAS de bande de héros : la page prend la mise en page des pages de
        matière — deux colonnes qui coulent depuis le haut, l'aplat ouvrant la
        colonne de droite. Une bande aurait imposé sa hauteur au titre et coupé
        l'aplat en deux. */}
    <Page>
      <div class="split">
        <div class="corps">
          <div class="fil">
            <Breadcrumb items={[
              { label: 'Accueil', href: '/' },
              { label: 'Honoraires', href: '/#honoraires' },
              { label: "Documents pour l'aide juridique" },
            ]} />
          </div>
          <h1>Faire une demande d'aide juridique</h1>
          <p class="lead">
            Apportez les documents généraux, puis ceux qui correspondent à votre situation.
            Si un document manque, venez quand même : nous verrons ensemble comment l'obtenir.
          </p>

          <div class="block">
            <h2>Documents généraux</h2>
            <ul class="generaux">
              {GENERAUX.map((g) => (
                <li>
                  <span class="coche" aria-hidden="true"><Icon name="check" size={20} /></span>
                  <div>
                    <span>{g.doc}</span>
                    {g.garde && (
                      <div class="garde">
                        <p class="garde-titre">{g.garde.titre}</p>
                        <p class="garde-texte">{g.garde.texte}</p>
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="block far">
            <h2>Preuves de revenus</h2>

            {/* ---- LE SÉLECTEUR ----
                Neuf situations, une seule ouverte. C'est un `<details name>` :
                l'exclusivité est portée par le navigateur, pas par un script —
                la page reste sans JavaScript, et le dispositif marche au
                clavier comme au doigt sans que rien n'ait à s'exécuter. Sur un
                navigateur qui ignore `name`, plusieurs situations peuvent
                s'ouvrir : on lit plus, on ne perd rien.

                Pas de champ, pas de bouton radio : le cabinet ne collecte
                aucune donnée, et rien ici ne doit ressembler à un formulaire. */}
            <Eyebrow class="etiquette">Choisissez votre situation</Eyebrow>
            <div class="choix">
              {REVENUS.map((s) => (
                <details class="situation" name="situation">
                  <summary class="eg-inverse">
                    <span>{s.titre}</span>
                    <span class="chev" aria-hidden="true"><Icon name="chevron-down" size={24} /></span>
                  </summary>
                  <div class="reponse" id={s.id}>
                    <ul>
                      {s.docs.map((d) => (
                        <li><span class="coche" aria-hidden="true"><Icon name="check" size={20} /></span><span>{d}</span></li>
                      ))}
                    </ul>
                  </div>
                </details>
              ))}
            </div>
          </div>

          <div class="block far">
            <h2>Autres personnes du ménage</h2>
            <p class="apres">
              Chaque adulte mentionné sur votre composition de ménage doit fournir ses preuves de
              revenus et son AER — sauf s'il s'agit de votre conjoint et que vous demandez un divorce
              ou une séparation.
            </p>
          </div>
        </div>

        <aside>
          <div class="aplat" aria-hidden="true"></div>
          <Card padding="var(--space-6)">
            <Eyebrow>Liens utiles</Eyebrow>
            <div class="tight"><LinkList items={LIENS_PRODEO} /></div>
          </Card>
        </aside>
      </div>
    </Page>
    <ContactBand />
  </main>
</Base>

<style>
  /* ---- L'APLAT ----
     Le même dispositif que la page de service (`services/[id].astro`), et pour
     la même raison : il ouvre la colonne de DROITE, donc l'arc du bouclier
     tombe en bas à gauche. Ce n'est pas une photographie mais une couleur
     pleine, et la loi des marges ne laisse franchir les filets qu'à la
     photographie : l'aplat s'arrête donc PILE sur le filet, son débord latéral
     valant exactement une gouttière. Les cartes flottent dessus.

     Sa hauteur est bornée par la colonne : deux cartes courtes ne portent pas
     78vh d'aplat, et `min()` le fait épouser le plus petit des deux. */
  aside {
    --debord: var(--space-6);
    position: relative;
    /* Le débord du HAUT est un padding, pas un décalage négatif : l'aplat part
       du bord supérieur de la colonne, et ce sont les cartes qui descendent.
       Un `top` négatif l'aurait glissé SOUS l'en-tête, qui l'aurait mangé. */
    padding-top: var(--debord);
  }
  .aplat {
    position: absolute;
    z-index: -1;
    top: 0;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    height: min(clamp(440px, 78vh, 820px), calc(100% + var(--debord)));
    /* Le sauge obscur, pas le brun : c'est la couleur que le site donne à ses
       grandes surfaces pleines — le pied de page en est une. En brun, l'aplat
       reprenait l'encre du texte agrandie à la taille d'une colonne, et les
       cartes posées dessus se lisaient comme un trou dans un paragraphe. */
    background: var(--sauge-obscur);
    border-bottom-left-radius: 78% 58%;
  }
  @media (--lap) {
    .aplat { height: calc(100% + var(--debord)); }
  }

  /* Le fil d'Ariane n'est pas l'étiquette du titre (ce serait --stack-bind) :
     c'est un bloc distinct qui le précède. */
  .fil { margin-bottom: var(--stack); }

  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: 1.12;
  }
  .lead {
    margin-top: var(--stack-tight);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--brun-moyen);
  }
  /* Le titre et son chapô cassent sur la même verticale (voir RuledCell). */
  h1, .lead { max-width: 33rem; }

  /* Deux colonnes proportionnelles tant qu'elles tiennent, puis empilées.
     `flex-wrap` fait deux choses qu'une grille à points de rupture ne fait pas :
     l'asymétrie se DÉTEND vers l'égalité à mesure que la place manque, puis le
     bloc passe dessous. La bascule est décidée par la mesure du texte (en ch),
     pas par un pixel deviné — donc pas de @media.

     Pas de `min-width: 0` sur les colonnes : ce serait les autoriser à devenir
     plus étroites que leur propre contenu, et les cartes déborderaient au lieu
     de passer à la ligne. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-9);
    padding: 0 0 var(--section-y);
  }
  /* L'aplat touche l'en-tête ; seul le TEXTE descend.

     La découpe est plus franche que sur une page de service (7/5) : ici la
     colonne de droite ne porte qu'une carte de liens, et rien qui demande de
     la largeur. Les bases en `ch` montent avec elle — c'est la SOMME des deux
     bases qui décide du moment où le bloc passe dessous, et la relever fait
     empiler une centaine de pixels plus tôt : une colonne de 30ch de liens
     qu'on écrase n'a plus d'intérêt à rester debout. */
  .split > .corps { flex: 8 1 38ch; padding-top: var(--section-y); }
  .split > aside  { flex: 4 1 30ch; }
  @media (--lap) {
    .split > .corps { padding-top: var(--section-y-sm); }
  }
  /* Là où la barre de navigation existe, la colonne de droite s'arrête sur la
     couture de sa troisième cellule (voir --nav-seam-col dans `tokens.css`).
     Elle ne se replie plus par proportion : c'est une largeur posée, et le
     corps prend tout le reste. Sous --lap la barre devient un menu, il n'y a
     plus de couture à suivre, et les bases en `ch` reprennent la main — y
     compris pour décider du moment où le bloc passe dessous. */
  @media (--desk) {
    .split > aside { flex: 0 0 var(--nav-seam-col); }
  }

  aside { display: grid; gap: var(--space-5); align-content: start; }
  .block { margin-top: var(--stack-loose); }
  .far { margin-top: var(--space-9); }
  .tight { margin-top: var(--stack-tight); }

  /* Les trois sections du corps portent le MÊME titre — grand, en display —
     parce qu'elles sont trois étapes de la même démarche. L'étiquette en
     capitales est descendue d'un cran : elle ne coiffe plus la section, elle
     nomme l'objet qui la suit (voir `.etiquette`). */
  h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }
  .apres {
    margin-top: var(--stack-tight);
    font-size: var(--fs-body);
    line-height: 1.6;
    max-width: var(--measure-prose);
  }

  /* ---- LES DOCUMENTS GÉNÉRAUX ----
     Le filet en tête de ligne de `RuledList`, mais écrit ici pour deux raisons :
     un document peut porter sa mise en garde SOUS lui (l'avertissement sur
     l'AER appartient à l'AER, et posé à la suite de la liste il se lisait comme
     valant pour les deux), et la puce est une coche, pas le tiret éditorial —
     voir `.coche`. */
  .generaux { list-style: none; margin: var(--stack-tight) 0 0; padding: 0; max-width: var(--measure-prose); }
  .generaux > li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) 0;
    border-top: var(--divider);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  /* ---- LA MISE EN GARDE ----
     Ce n'était pas un `Callout` à sa place : l'encadré rose pleine largeur,
     son filet de 3px et son triangle de 26px pesaient plus que le document
     qu'ils commentent — la page s'ouvrait sur une alerte alors qu'elle ouvre
     sur une liste de papiers. Il ne reste que ce qui porte le sens : un filet
     fin dans l'encre d'alerte, et l'intitulé dans la même encre. Pas d'aplat,
     pas de glyphe (une icône ne porte jamais le sens seule, de toute façon).
     Le texte descend d'un cran vers le brun moyen : c'est une note sur un
     document, pas une deuxième voix dans la page. */
  .garde {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: var(--border-frame) solid var(--status-urgent-fg);
    max-width: var(--measure-prose);
  }
  .garde-titre {
    margin: 0;
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-semibold);
    line-height: 1.5;
    color: var(--status-urgent-fg);
  }
  .garde-texte {
    margin: var(--stack-bind) 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* ---- LE SÉLECTEUR DE SITUATION ----
     Il ne doit pas se lire comme une liste de plus : ce ne sont ni le poids ni
     la taille du texte qui le disent — les intitulés sont du corps ordinaire —
     mais le cadre fort, l'étiquette posée dessus et les chevrons. Les lignes
     sont hautes (72px, la mesure du composant Accordion du design system),
     largement au-delà de la cible tactile. */
  /* L'étiquette du sélecteur : elle ne coiffe pas la section, elle NOMME la
     boîte qui la suit — d'où le pas le plus serré de la pile entre les deux.
     Elle suit directement le titre de section, donc l'air d'un titre à son
     chapô. */
  .etiquette { margin-top: var(--stack-tight); }

  /* ---- LE CADRE ----
     Il ne porte AUCUN padding : les filets qui séparent les situations sont
     posés par les lignes, et une ligne rentrée aurait fait des filets plus
     courts que la boîte — un trait qui s'arrête avant son cadre se lit comme
     une erreur d'alignement. Ce sont donc les lignes qui portent le pas
     intérieur, et le filet comme le lit du survol vont d'un bord à l'autre. */
  .choix {
    margin-top: var(--stack-bind);
    border: var(--border-frame-strong);
  }
  /* Le premier filet est celui du cadre : une bordure de plus ferait un trait
     double en haut de la boîte. */
  .situation + .situation { border-top: var(--divider); }

  .situation > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 72px;
    /* Le pas intérieur du cadre est porté par la ligne, pas par la boîte :
       c'est ce qui laisse les filets aller d'un bord à l'autre. */
    padding: var(--space-4) var(--cell-pad);
    cursor: pointer;
    list-style: none;
    /* Du texte de corps, pas un sous-titre : ces neuf intitulés sont des
       RÉPONSES à une question, pas les noms de neuf objets. En 28px demi-gras
       ils pesaient autant que les titres de section, et le cadre se lisait
       comme une quatrième liste de titres plutôt que comme un choix à faire. */
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: var(--fw-regular);
    line-height: var(--lh-body);
    color: var(--text-body);
  }
  .situation > summary::-webkit-details-marker { display: none; }

  /* ---- LA SITUATION CHOISIE ----
     Le lit du survol, mais POSÉ : il ne dit plus « celle-ci est cliquable », il
     dit « celle-ci est la vôtre ». L'intitulé et sa réponse le partagent, donc
     les deux se lisent comme un seul bloc dans la liste — c'est ce qui rend le
     choix visible sans avoir à relire les neuf lignes. Le survol reste au-dessus
     et ne se voit pas ici : c'est le même voile. */
  .situation[open] > summary,
  .situation[open] > .reponse { background: var(--survol-aplat); }
  .situation[open] > summary { color: var(--text-heading); }

  /* Le chevron ne suit PAS le décalage de trois pixels : il porte déjà une
     transformation à lui, celle qui dit ouvert/fermé, et `transform` est une
     seule propriété — l'un des deux gestes aurait effacé l'autre. */
  .chev {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--sauge-obscur);
    transform: rotate(0deg);
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .situation[open] .chev { transform: rotate(180deg); }

  /* La réponse : la même liste que les documents généraux, un cran plus bas —
     c'est le contenu d'une situation, pas le titre de la page. Pas de `gap` :
     ce sont les filets qui séparent. */
  .reponse { padding: 0 var(--cell-pad) var(--space-6); }
  .reponse ul { list-style: none; margin: 0; padding: 0; }
  .reponse li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) 0;
    border-top: var(--divider);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ---- LA COCHE ----
     Le tiret caramel de `RuledList` est l'énumération éditoriale du site. Ces
     deux listes-ci ne sont pas une énumération : ce sont des papiers à mettre
     dans une pochette, et on les coche. C'est le seul endroit du site où la
     liste a ce sens, et le seul où le tiret cède.

     Elle est centrée sur la PREMIÈRE LIGNE, pas sur l'élément : un document qui
     court sur deux lignes garde sa coche en tête. `1.5em` est l'interligne des
     deux listes, et `em` suit la taille de chacune — un seul calcul pour les
     deux. */
  .coche {
    display: inline-flex;
    flex: 0 0 auto;
    margin-top: calc((1.5em - 20px) / 2);
    color: var(--caramel);
  }
</style>
