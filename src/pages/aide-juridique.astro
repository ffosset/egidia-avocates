---
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import LinkList from '../components/LinkList.astro';
import ContactBand from '../components/ContactBand.astro';
import { GENERAUX, REVENUS, LIENS_PRODEO } from '../data/prodeo.js';
---
<Base
  title="Aide juridique (pro deo) à Bruxelles · Documents à apporter"
  description="Avocates pro deo à Bruxelles : la liste des documents à apporter pour une demande d'aide juridique de deuxième ligne au cabinet Egidia."
>
  <main>
    {/* PAS de bande de héros : la page prend la mise en page des pages de
        matière — deux colonnes qui coulent depuis le haut, l'aplat ouvrant la
        colonne de droite. Une bande aurait imposé sa hauteur au titre et coupé
        l'aplat en deux. */}
    <Page>
      <div class="split">
        <div class="corps">
          <div class="fil">
            <Breadcrumb items={[
              { label: 'Accueil', href: '/' },
              { label: 'Honoraires', href: '/#honoraires' },
              { label: "Documents pour l'aide juridique" },
            ]} />
          </div>
          <h1>Faire une demande d'aide juridique</h1>
          <p class="lead">
            Apportez les documents généraux, puis ceux qui correspondent à votre situation.
            Si un document manque, venez quand même : nous verrons ensemble comment l'obtenir.
          </p>

          <div class="block">
            <h2>Documents généraux</h2>
            <ul class="generaux">
              {GENERAUX.map((g) => (
                <li>
                  <span class="coche" aria-hidden="true"><Icon name="check" size={20} /></span>
                  <div>
                    <span>{g.doc}</span>
                    {g.garde && (
                      <div class="garde">
                        <p class="garde-titre">{g.garde.titre}</p>
                        <p class="garde-texte">{g.garde.texte}</p>
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="block far">
            <h2>Preuves de revenus</h2>

            {/* ---- LE SÉLECTEUR ----
                Neuf situations, une seule ouverte. C'est un `<details name>` :
                l'exclusivité est portée par le navigateur, pas par un script —
                la page reste sans JavaScript, et le dispositif marche au
                clavier comme au doigt sans que rien n'ait à s'exécuter. Sur un
                navigateur qui ignore `name`, plusieurs situations peuvent
                s'ouvrir : on lit plus, on ne perd rien.

                Pas de champ, pas de bouton radio : le cabinet ne collecte
                aucune donnée, et rien ici ne doit ressembler à un formulaire. */}
            <Eyebrow class="etiquette">Choisissez votre situation</Eyebrow>
            <div class="choix">
              {REVENUS.map((s) => (
                <details class="situation" name="situation">
                  <summary class="eg-inverse">
                    <span>{s.titre}</span>
                    <span class="chev" aria-hidden="true"><Icon name="chevron-down" size={24} /></span>
                  </summary>
                  <div class="reponse" id={s.id}>
                    <ul>
                      {s.docs.map((d) => (
                        <li><span class="coche" aria-hidden="true"><Icon name="check" size={20} /></span><span>{d}</span></li>
                      ))}
                    </ul>
                  </div>
                </details>
              ))}
            </div>
          </div>

          <div class="block far">
            <h2>Autres personnes du ménage</h2>
            <p class="apres">
              Chaque adulte mentionné sur votre composition de ménage doit fournir ses preuves de
              revenus et son AER, sauf s'il s'agit de votre conjoint et que vous demandez un divorce
              ou une séparation.
            </p>
          </div>
        </div>

        <aside>
          {/* Les liens utiles sont écrits DANS l'aplat, sur le sable des honoraires,
              et c'est leur nombre qui lui donne sa hauteur (voir la page de
              matière). */}
          <div class="aplat">
            <Eyebrow>Liens utiles</Eyebrow>
            <div class="tight"><LinkList items={LIENS_PRODEO} /></div>
          </div>
        </aside>
      </div>
    </Page>
    <ContactBand />
  </main>
</Base>

<style>
  /* ---- L'APLAT ----
     Le même dispositif que la page de service (`matieres/[id].astro`), où il
     est expliqué : un bloc du sable des honoraires, dans le flux, qui ouvre
     la colonne de DROITE et porte les liens utiles, haut de sa liste et de la
     queue de son arc. Ce n'est pas une photographie mais une couleur
     pleine, et la loi des marges ne laisse franchir les filets qu'à la
     photographie — sauf debout, à droite, où il va jusqu'au bord de la
     fenêtre comme le portrait de la page d'avocate (voir plus bas). À gauche
     il s'arrête PILE sur la couture de la navigation. */
  .aplat {
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--space-8) var(--cell-pad) var(--space-10);
    background: var(--surface-honoraires);
    border-bottom-left-radius: 78% min(58%, 300px);
    /* Les encres sur le sable et le lit du survol — voir la page de matière. */
    --text-label: var(--brun-moyen);
    --links-bleed: var(--cell-pad);
    --links-rule: var(--border-rule) solid var(--line-page-rule-on-sable);
    --survol-aplat: var(--surface-page);
  }
  /* Empilé sous le corps, l'aplat n'est plus une colonne : c'est une bande,
     et il fait comme la photo du registre de l'accueil — il franchit les
     filets et va d'un bord à l'autre de l'écran. La colonne commence à
     --content-inset du bord ; c'est cette distance qu'il rend. Son texte,
     lui, revient à --content-inset du bord — la loi des marges, comme le
     panneau des honoraires sur une colonne : le pas intérieur vaut l'inset,
     et le débord des lignes le suit pour que leurs filets aillent d'un bord
     à l'autre.

     « Empilé » n'est pas un point de rupture : c'est `flex-wrap` qui décide,
     quand les deux bases (38ch + 30ch) et la gouttière ne tiennent plus dans
     la ligne. La requête de conteneur pose EXACTEMENT la même condition, dans
     les mêmes unités — les `ch` s'y résolvent sur la fonte du conteneur, qui
     est celle des colonnes — et bascule donc au même pixel. Un `@media` à un
     nombre deviné aurait fait déborder l'aplat sur le corps tant que les
     colonnes se tiennent encore côte à côte (elles le font jusque vers 870px,
     bien sous --lap). Les trois nombres sont ceux de `.split` ci-dessous. */
  .split { container-type: inline-size; }
  @container (max-width: calc(38ch + 30ch + 96px)) {
    .aplat {
      margin-inline: calc(-1 * var(--content-inset));
      padding-inline: var(--content-inset);
      --links-bleed: var(--content-inset);
      /* Sur une bande, l'arc vit dans la queue : son rayon vertical vaut
         exactement le pas du bas, et la courbe ne peut plus remonter sous le
         texte — voir la page de matière. */
      padding-bottom: var(--space-10);
      border-bottom-left-radius: 78% var(--space-10);
      /* Devenu un aplat pleine largeur, il rejoint la bande sauge et le pied
         de page au-dessus des filets pleins (6, voir `PageRules`). Mais sa
         surface EST le sable des filets, qui s'y effaceraient : comme la
         section des honoraires de l'accueil, il les redessine dans l'encre
         qui se lit sur le sable. Sous --lap le contenu n'est jamais centré,
         donc le filet est à --page-margin du bord de la bande. Le filet
         gauche s'arrête où l'arc commence — la queue —, le droit descend
         jusqu'en bas. */
      position: relative;
      z-index: 6;
    }
    .aplat::before,
    .aplat::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: var(--border-rule);
      background: var(--line-page-rule-on-sable);
      pointer-events: none;
    }
    .aplat::before { left: var(--page-margin); bottom: var(--space-10); }
    .aplat::after  { right: var(--page-margin); }
  }

  /* Le fil d'Ariane n'est pas l'étiquette du titre (ce serait --stack-bind) :
     c'est un bloc distinct qui le précède. */
  .fil { margin-bottom: var(--stack); }

  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: 1.12;
  }
  .lead {
    margin-top: var(--stack-tight);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--brun-moyen);
  }
  /* Le titre et son chapô cassent sur la même verticale (voir RuledCell). */
  h1, .lead { max-width: 48rem; }

  /* Deux colonnes proportionnelles tant qu'elles tiennent, puis empilées.
     `flex-wrap` fait deux choses qu'une grille à points de rupture ne fait pas :
     l'asymétrie se DÉTEND vers l'égalité à mesure que la place manque, puis le
     bloc passe dessous. La bascule est décidée par la mesure du texte (en ch),
     pas par un pixel deviné — donc pas de @media.

     Pas de `min-width: 0` sur les colonnes : ce serait les autoriser à devenir
     plus étroites que leur propre contenu, et les cartes déborderaient au lieu
     de passer à la ligne. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-9);
    padding: 0 0 var(--section-y);
  }
  /* L'aplat touche l'en-tête ; seul le TEXTE descend.

     La découpe est plus franche que sur une page de service (7/5) : ici la
     colonne de droite ne porte que des liens, et rien qui demande de la
     largeur. Les bases en `ch` montent avec elle — c'est la SOMME des deux
     bases qui décide du moment où le bloc passe dessous, et la relever fait
     empiler une centaine de pixels plus tôt : une colonne de 30ch de liens
     qu'on écrase n'a plus d'intérêt à rester debout. */
  .split > .corps { flex: 8 1 38ch; padding-top: var(--section-y); }
  .split > aside  { flex: 4 1 30ch; }
  @media (--lap) {
    .split > .corps { padding-top: var(--section-y-sm); }
  }
  /* ---- LA COUTURE ----
     La même que sur la page de matière, où elle est expliquée : là où la
     barre de navigation existe, l'aplat s'arrête sur la couture de la
     troisième cellule (--nav-seam-col), sans filet. Le corps s'arrête dessus,
     texte rentré d'une gouttière ; la colonne de droite commence une
     gouttière après. */
  @media (--desk) {
    .split { column-gap: var(--gutter); }
    .split > .corps { padding-right: var(--gutter); }
    .split > aside  { flex: 0 0 calc(var(--nav-seam-col) - var(--gutter)); }
    /* Debout, l'aplat va jusqu'au bord de la fenêtre et redessine le filet
       de marge qu'il franchit — voir la page de matière. */
    .aplat {
      --bleed: calc(max(0px, (100vw - var(--page-max)) / 2) + var(--content-inset));
      margin-right: calc(-1 * var(--bleed));
      padding-right: calc(var(--bleed) - var(--gutter) + var(--cell-pad));
      position: relative;
      z-index: 6;
    }
    .aplat::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      right: var(--frame-inset);
      width: var(--border-rule);
      background: var(--line-page-rule-on-sable);
      pointer-events: none;
    }
  }

  aside { display: grid; gap: var(--space-5); align-content: start; }
  .block { margin-top: var(--stack-loose); }
  .far { margin-top: var(--space-9); }
  .tight { margin-top: var(--stack-tight); }

  /* Les trois sections du corps portent le MÊME titre — grand, en display —
     parce qu'elles sont trois étapes de la même démarche. L'étiquette en
     capitales est descendue d'un cran : elle ne coiffe plus la section, elle
     nomme l'objet qui la suit (voir `.etiquette`). */
  h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }
  .apres {
    margin-top: var(--stack-tight);
    font-size: var(--fs-body);
    line-height: 1.6;
    max-width: var(--measure-prose);
  }

  /* ---- LES DOCUMENTS GÉNÉRAUX ----
     La liste cochée de `RuledList` sans filets (`rules={false}`, celle de
     « Ce que nous traitons » sur les pages de matière), mais écrite ici pour
     deux raisons : un document peut porter sa mise en garde SOUS lui
     (l'avertissement sur l'AER appartient à l'AER, et posé à la suite de la
     liste il se lisait comme valant pour les deux), et la puce est une coche —
     voir `.coche`. Pas de filet entre deux documents : ce sont deux papiers,
     pas deux lignes d'un registre, et le pas est le plus serré de la pile. */
  .generaux { list-style: none; margin: var(--stack-tight) 0 0; padding: 0; max-width: var(--measure-prose); }
  .generaux > li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-2) 0;
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  /* ---- LA MISE EN GARDE ----
     Ce n'était pas un `Callout` à sa place : l'encadré rose pleine largeur,
     son filet de 3px et son triangle de 26px pesaient plus que le document
     qu'ils commentent — la page s'ouvrait sur une alerte alors qu'elle ouvre
     sur une liste de papiers. Il ne reste que ce qui porte le sens : un filet
     fin dans l'encre d'alerte, et l'intitulé dans la même encre. Pas d'aplat,
     pas de glyphe (une icône ne porte jamais le sens seule, de toute façon).
     Le texte descend d'un cran vers le brun moyen : c'est une note sur un
     document, pas une deuxième voix dans la page. */
  .garde {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: var(--border-frame) solid var(--status-urgent-fg);
    max-width: var(--measure-prose);
  }
  .garde-titre {
    margin: 0;
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-semibold);
    line-height: 1.5;
    color: var(--status-urgent-fg);
  }
  .garde-texte {
    margin: var(--stack-bind) 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* ---- LE SÉLECTEUR DE SITUATION ----
     Il ne doit pas se lire comme une liste de plus : ce ne sont ni le poids ni
     la taille du texte qui le disent — les intitulés sont du corps ordinaire —
     mais le cadre fort, l'étiquette posée dessus et les chevrons. Les lignes
     sont hautes (72px, la mesure du composant Accordion du design system),
     largement au-delà de la cible tactile. */
  /* L'étiquette du sélecteur : elle ne coiffe pas la section, elle NOMME la
     boîte qui la suit — d'où le pas le plus serré de la pile entre les deux.
     Elle suit directement le titre de section, donc l'air d'un titre à son
     chapô. */
  .etiquette { margin-top: var(--stack-tight); }

  /* ---- LE CADRE ----
     Il ne porte AUCUN padding : les filets qui séparent les situations sont
     posés par les lignes, et une ligne rentrée aurait fait des filets plus
     courts que la boîte — un trait qui s'arrête avant son cadre se lit comme
     une erreur d'alignement. Ce sont donc les lignes qui portent le pas
     intérieur, et le filet comme le lit du survol vont d'un bord à l'autre. */
  .choix {
    margin-top: var(--stack-bind);
    border: var(--border-frame-strong);
  }
  /* Le premier filet est celui du cadre : une bordure de plus ferait un trait
     double en haut de la boîte. */
  .situation + .situation { border-top: var(--divider); }

  .situation > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 72px;
    /* Le pas intérieur du cadre est porté par la ligne, pas par la boîte :
       c'est ce qui laisse les filets aller d'un bord à l'autre. */
    padding: var(--space-4) var(--cell-pad);
    cursor: pointer;
    list-style: none;
    /* Du texte de corps, pas un sous-titre : ces neuf intitulés sont des
       RÉPONSES à une question, pas les noms de neuf objets. En 28px demi-gras
       ils pesaient autant que les titres de section, et le cadre se lisait
       comme une quatrième liste de titres plutôt que comme un choix à faire. */
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: var(--fw-regular);
    line-height: var(--lh-body);
    color: var(--text-body);
  }
  .situation > summary::-webkit-details-marker { display: none; }

  /* ---- LA SITUATION CHOISIE ----
     Le lit du survol, mais POSÉ : il ne dit plus « celle-ci est cliquable », il
     dit « celle-ci est la vôtre ». L'intitulé et sa réponse le partagent, donc
     les deux se lisent comme un seul bloc dans la liste — c'est ce qui rend le
     choix visible sans avoir à relire les neuf lignes. Le survol reste au-dessus
     et ne se voit pas ici : c'est le même voile. */
  .situation[open] > summary,
  .situation[open] > .reponse { background: var(--survol-aplat); }
  /* L'intitulé choisi passe en demi-gras : le lit dit « celle-ci est la
     vôtre », le poids le redit pour qui parcourt la colonne des neuf noms
     sans regarder les fonds. Demi-gras et non gras — c'est du texte de corps,
     et le gras y est réservé aux titres. */
  .situation[open] > summary {
    color: var(--text-heading);
    font-weight: var(--fw-semibold);
  }

  /* Le chevron ne suit PAS le décalage de trois pixels : il porte déjà une
     transformation à lui, celle qui dit ouvert/fermé, et `transform` est une
     seule propriété — l'un des deux gestes aurait effacé l'autre. */
  .chev {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--sauge-obscur);
    transform: rotate(0deg);
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .situation[open] .chev { transform: rotate(180deg); }

  /* La réponse : la même liste que les documents généraux, un cran plus bas —
     c'est le contenu d'une situation, pas le titre de la page. Pas de `gap` :
     ce sont les filets qui séparent. */
  .reponse { padding: 0 var(--cell-pad) var(--space-6); }
  .reponse ul { list-style: none; margin: 0; padding: 0; }
  .reponse li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) 0;
    border-top: var(--divider);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Empilé, le sélecteur de situation perd son cadre et devient un registre :
     ses lignes vont d'un filet de marge à l'autre, comme les cellules de
     l'accueil. Sur une colonne, le cadre fort ne cernait plus rien — la boîte
     faisait la largeur du texte, et son trait redisait les filets à une
     gouttière près. Les lignes gardent leur --cell-pad, qui est ce qu'une
     cellule de registre prend contre un filet. Chaque ligne porte son filet
     du haut, la boîte ferme la dernière ; le lit de la situation choisie va
     lui aussi de filet à filet. Même condition que l'aplat (voir plus haut) :
     c'est l'empilement qui décide, pas un point de rupture. Placé APRÈS les
     règles du cadre, qu'il doit défaire. */
  @container (max-width: calc(38ch + 30ch + 96px)) {
    .choix {
      border: none;
      border-bottom: var(--divider);
      margin-inline: calc(-1 * var(--gutter));
    }
    .situation { border-top: var(--divider); }
  }

  /* ---- LA COCHE ----
     Le tiret caramel de `RuledList` est l'énumération éditoriale du site. Ces
     deux listes-ci ne sont pas une énumération : ce sont des papiers à mettre
     dans une pochette, et on les coche. La même coche sert aussi à « Ce que
     nous traitons » sur les pages de matière (`RuledList marker="check"`) :
     ce qu'on prend en charge se coche comme ce qu'on apporte.

     Elle est centrée sur la PREMIÈRE LIGNE, pas sur l'élément : un document qui
     court sur deux lignes garde sa coche en tête. `1.5em` est l'interligne des
     deux listes, et `em` suit la taille de chacune — un seul calcul pour les
     deux. */
  .coche {
    display: inline-flex;
    flex: 0 0 auto;
    margin-top: calc((1.5em - 20px) / 2);
    color: var(--caramel);
  }
</style>
