---
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Card from '../components/Card.astro';
import Callout from '../components/Callout.astro';
import RuledList from '../components/RuledList.astro';
import LinkList from '../components/LinkList.astro';
import ContactBand from '../components/ContactBand.astro';
import { GENERAUX, REVENUS, LIENS_PRODEO } from '../data/prodeo.js';
---
<Base
  title="Documents pour l'aide juridique"
  description="La liste des documents à apporter pour constituer une demande d'aide juridique (pro deo) au cabinet Egidia."
>
  <main>
    <section class="hero">
      <Page>
        <Breadcrumb items={[
          { label: 'Accueil', href: '/' },
          { label: 'Honoraires', href: '/#honoraires' },
          { label: "Documents pour l'aide juridique" },
        ]} />
        <h1>Faire une demande d'aide juridique</h1>
        <p class="lead">
          Apportez les documents généraux, puis ceux qui correspondent à votre situation.
          Si un document manque, venez quand même : nous verrons ensemble comment l'obtenir.
        </p>
      </Page>
    </section>

    <Page>
      <div class="split">
        <div>
          <h2 class="step">Documents généraux</h2>
          <div class="prose"><RuledList items={GENERAUX} /></div>
          <div class="prose spaced">
            <Callout tone="urgent" title="Ce n'est pas la proposition de déclaration simplifiée">
              L'Avertissement-Extrait de Rôle est le document définitif. La proposition de
              déclaration simplifiée n'est qu'un calcul provisoire et ne sera pas acceptée.
            </Callout>
          </div>

          <h2 class="step far">Preuves de revenus, selon votre situation</h2>
          <div class="situations">
            {REVENUS.map(([titre, docs]) => (
              <Card padding="var(--space-5) var(--space-6)">
                <div class="sit-title">{titre}</div>
                <ul>
                  {docs.map((d) => (
                    <li><span class="dash" aria-hidden="true"></span><span>{d}</span></li>
                  ))}
                </ul>
              </Card>
            ))}
          </div>

          <h2 class="step far">Si vous vivez avec d'autres personnes majeures</h2>
          <p class="after">
            Chaque adulte mentionné sur votre composition de ménage doit fournir ses preuves de
            revenus et son AER — sauf s'il s'agit de votre conjoint et que vous demandez un divorce
            ou une séparation.
          </p>
        </div>

        <aside>
          <Card tone="warm" padding="var(--space-6)">
            <Eyebrow>L'aide juridique</Eyebrow>
            <p class="claim">Ce n'est pas une faveur : c'est un droit.</p>
            <p class="note">
              Toutes les avocates du cabinet travaillent dans le cadre de l'aide juridique.
              Nous vérifions avec vous si vous remplissez les conditions.
            </p>
          </Card>
          <Card tone="inset" padding="var(--space-6)">
            <Eyebrow>Liens utiles</Eyebrow>
            <div class="tight"><LinkList items={LIENS_PRODEO} /></div>
          </Card>
        </aside>
      </div>
    </Page>
    <ContactBand />
  </main>
</Base>

<style>
  .hero {
    background: var(--surface-margin);
    border-bottom: var(--divider);
    padding: var(--space-6) 0 var(--space-9);
  }
  h1 {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: 1.12;
  }
  .lead {
    margin-top: var(--space-5);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--brun-moyen);
  }
  /* Le titre et son chapô cassent sur la même verticale (voir RuledCell). */
  h1, .lead { max-width: 35rem; }
  /* Deux colonnes proportionnelles tant qu'elles tiennent, puis empilées.
     `flex-wrap` fait deux choses qu'une grille à points de rupture ne fait pas :
     l'asymétrie se DÉTEND vers l'égalité à mesure que la place manque, puis le
     bloc passe dessous. La bascule est décidée par la mesure du texte (en ch),
     pas par un pixel deviné — donc pas de @media.

     Pas de `min-width: 0` sur les colonnes : ce serait les autoriser à devenir
     plus étroites que leur propre contenu, et les cartes déborderaient au lieu
     de passer à la ligne. Le `min-width: auto` par défaut est ce qui déclenche
     le retour à la ligne au bon moment. */
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-9);
    padding: var(--space-9) 0 0;
  }
  .split > div   { flex: 8 1 40ch; }
  .split > aside { flex: 4 1 24ch; }
  .step { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: var(--fw-bold); }
  .step.far { margin-top: var(--space-10); }

  .prose { margin-top: var(--space-5); max-width: var(--measure-prose); }
  .prose.spaced { margin-top: var(--space-6); }
  .situations { margin-top: var(--space-5); display: grid; gap: var(--space-4); }
  .sit-title {
    font-family: var(--type-subtitle-family);
    font-size: var(--type-subtitle-size);
    font-weight: var(--type-subtitle-weight);
    color: var(--type-subtitle-color);
  }
  /* La même liste que les documents généraux (voir RuledList) : un filet en
     tête de ligne et un tiret caramel, jamais de coche. Seule la taille change
     — celle de la carte, secondaire par rapport à son titre. Pas de `gap` : ce
     sont les filets qui séparent, et un gap ferait deux séparations. */
  .situations ul { margin: var(--space-4) 0 0; padding-left: 0; list-style: none; }
  .situations li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: var(--divider);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .situations .dash {
    width: 14px;
    height: 1px;
    background: var(--caramel);
    flex: 0 0 auto;
    transform: translateY(-6px);
  }
  .after { margin-top: var(--stack-tight); font-size: var(--fs-body); line-height: 1.6; max-width: var(--measure-prose); }

  aside { display: grid; gap: var(--space-5); align-content: start; position: sticky; top: 24px; }
  .claim {
    margin-top: var(--stack-tight);
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: var(--fw-bold);
    line-height: 1.35;
  }
  .note { margin-top: var(--stack-tight); margin-bottom: 0; font-size: var(--fs-body-sm); color: var(--text-muted); line-height: 1.6; }
  .tight { margin-top: var(--stack-tight); }

</style>
